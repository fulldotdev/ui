{
  "name": "fulldev-ui",
  "type": "module",
  "version": "0.20.0",
  "description": "Open-source Astro UI components and blocks",
  "homepage": "https://ui.full.dev",
  "bugs": "https://github.com/fulldotdev/ui/issues",
  "license": "MIT",
  "author": "Fulldev <contact@full.dev> (https://full.dev)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fulldotdev/ui.git"
  },
  "keywords": [
    "astro-integration",
    "withastro",
    "astro",
    "astro-component",
    "astro-components",
    "astro-ui",
    "components",
    "ui",
    "component-registry",
    "ui-components",
    "pagebuilder",
    "tailwind",
    "astro-blocks",
    "content-primitives",
    "fulldev",
    "fulldev-ui"
  ],
  "files": [
    "CHANGELOG.md",
    "LICENCE",
    "README.md",
    "registry.json",
    "public/r",
    "src/components/blocks",
    "src/components/ui",
    "src/lib/utils.ts",
    "src/styles/global.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.8.1",
  "imports": {
    "#styles": "./scripts/styles.mjs"
  },
  "scripts": {
    "astro": "astro",
    "dev": "pnpm stop && astro dev --host 127.0.0.1 --port 4321",
    "stop": "lsof -tiTCP:4321 -sTCP:LISTEN | xargs kill 2>/dev/null || true",
    "preview": "pnpm stop && pnpm build && astro preview --host 127.0.0.1 --port 4321",
    "typecheck": "tsc --noEmit --noCheck && astro check --minimumFailingSeverity hint",
    "check": "prettier --check . && pnpm typecheck && eslint . && knip && node scripts/images.ts --check && pnpm registry:check && pnpm test",
    "test": "node --test tests/*.test.mjs",
    "fix": "prettier --write . && eslint . --fix",
    "images": "node scripts/images.ts",
    "ui:add": "node scripts/ui-add.ts",
    "build": "astro build && html-validate dist && linkinator dist",
    "a11y": "pnpm build && playwright install chromium --only-shell && node scripts/a11y.mjs",
    "registry:build": "pnpm registry:meta && node scripts/registry-adapt.mjs && shadcn build --output node_modules/.cache/fulldev-registry && node scripts/registry-styles.mjs && prettier --write registry.json public/r registry/styles/adapted --log-level warn",
    "registry:check": "pnpm registry:validate && pnpm registry:build && git diff --exit-code -- registry.json public/r registry/styles/adapted",
    "registry:validate": "node scripts/registry-validate.mjs",
    "release": "changeset version && pnpm install --lockfile-only",
    "release:publish": "pnpm registry:check && changeset publish",
    "registry:meta": "node scripts/registry-meta.mjs"
  },
  "dependencies": {
    "@data-slot/accordion": "^1.0.2",
    "@data-slot/alert-dialog": "^1.0.2",
    "@data-slot/collapsible": "^1.0.2",
    "@data-slot/combobox": "^1.0.2",
    "@data-slot/command": "^1.0.2",
    "@data-slot/core": "^1.0.2",
    "@data-slot/dialog": "^1.0.2",
    "@data-slot/drawer": "^1.0.2",
    "@data-slot/dropdown-menu": "^1.0.2",
    "@data-slot/hover-card": "^1.0.2",
    "@data-slot/navigation-menu": "^1.0.2",
    "@data-slot/popover": "^1.0.2",
    "@data-slot/radio-group": "^1.0.2",
    "@data-slot/resizable": "^1.0.2",
    "@data-slot/select": "^1.0.2",
    "@data-slot/slider": "^1.0.2",
    "@data-slot/switch": "^1.0.2",
    "@data-slot/tabs": "^1.0.2",
    "@data-slot/toast": "^1.0.2",
    "@data-slot/toggle": "^1.0.2",
    "@data-slot/toggle-group": "^1.0.2",
    "@data-slot/tooltip": "^1.0.2",
    "@lexingtonthemes/seo": "^0.4.0",
    "@lucide/astro": "^1.49.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "embla-carousel": "8.6.0",
    "embla-carousel-auto-scroll": "8.6.0",
    "lucide-static": "^1.49.0",
    "shadcn": "^4.21.0",
    "simple-icons": "^16.33.0",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "astro": "^7.0.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/sitemap": "^3.7.4",
    "@axe-core/playwright": "4.13.0",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.0",
    "astro": "^7.3.5",
    "astro-favicons": "^3.1.8",
    "astro-live-code": "^0.0.6",
    "astro-robots-txt": "^1.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.13.0",
    "html-validate": "^11.16.1",
    "knip": "^6.39.0",
    "linkinator": "^8.1.0",
    "playwright": "1.64.0",
    "posthog-js": "1.434.15",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
