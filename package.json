{
  "name": "fulldev-ui",
  "type": "module",
  "version": "0.25.4",
  "description": "Open-source UI components for Astro, React and native Liquid",
  "homepage": "https://ui.full.dev",
  "bugs": "https://github.com/fulldotdev/ui/issues",
  "license": "MIT",
  "author": "Fulldev <contact@full.dev> (https://full.dev)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fulldotdev/ui.git"
  },
  "keywords": [
    "withastro",
    "astro",
    "astro-component",
    "astro-components",
    "astro-ui",
    "components",
    "ui",
    "component-registry",
    "ui-components",
    "tailwind",
    "astro-blocks",
    "fulldev",
    "fulldev-ui",
    "shadcn",
    "shadcn-registry",
    "react",
    "shopify",
    "liquid"
  ],
  "files": [
    "CHANGELOG.md",
    "LICENCE",
    "README.md",
    "public/r",
    "liquid"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@12.14.0",
  "imports": {
    "#styles": "./scripts/styles.mjs",
    "#liquid-fixture": "./tests/helpers/liquid.mjs",
    "#analytics-privacy": "./src/lib/analytics-privacy.js"
  },
  "scripts": {
    "astro": "astro",
    "dev": "astro dev --host 127.0.0.1 --port 4321",
    "preview": "vp dlx --package=netlify-cli@27.12.1 netlify serve --context deploy-preview",
    "typecheck": "tsc --noEmit --noCheck && astro check --minimumFailingSeverity hint && tsc --noEmit -p react",
    "check": "prettier --check . && pnpm typecheck && eslint . && knip && node scripts/images.ts --check && node scripts/liquid-theme-check.mjs && pnpm registry:check",
    "test:unit": "node --test tests/*.test.mjs",
    "test:browser": "node --test tests/browser/*.test.mjs",
    "fix": "prettier --write . && eslint . --fix",
    "images": "node scripts/images.ts",
    "og": "node scripts/og.ts",
    "ui:add": "node scripts/ui-add.ts",
    "build": "astro build && pnpm --dir react build && node scripts/check-build.ts",
    "a11y": "pnpm build && playwright install chromium --only-shell && node scripts/a11y.mjs",
    "registry:build": "pnpm registry:meta && node scripts/registry-adapt.mjs && shadcn build --output node_modules/.cache/fulldev-registry && node scripts/registry-styles.mjs && shadcn build -c react -o ../node_modules/.cache/fulldev-registry-react && node scripts/registry-styles.mjs node_modules/.cache/fulldev-registry-react react/registry.json public/r/react && pnpm registry:liquid && prettier --write registry.json react/registry.json liquid/registry.json public/r registry/styles/adapted --log-level warn",
    "registry:check": "pnpm registry:validate && pnpm registry:build && git diff --exit-code -- registry.json react/registry.json liquid public/r registry/styles/adapted",
    "registry:validate": "node scripts/registry-validate.mjs && cd react && node ../scripts/registry-validate.mjs",
    "release": "changeset version && pnpm install --lockfile-only",
    "release:publish": "pnpm registry:check && changeset publish",
    "registry:meta": "node scripts/registry-meta.mjs",
    "registry:liquid": "node scripts/registry-liquid.mjs && shadcn build -c liquid -o ../public/r/liquid",
    "test": "vp run test:unit"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/sitemap": "^3.7.4",
    "@axe-core/playwright": "4.13.0",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@data-slot/accordion": "^1.1.2",
    "@data-slot/alert-dialog": "^1.1.2",
    "@data-slot/carousel": "^1.1.2",
    "@data-slot/collapsible": "^1.1.2",
    "@data-slot/combobox": "^1.1.2",
    "@data-slot/command": "^1.1.2",
    "@data-slot/core": "^1.1.2",
    "@data-slot/dialog": "^1.1.2",
    "@data-slot/drawer": "^1.1.2",
    "@data-slot/dropdown-menu": "^1.1.2",
    "@data-slot/hover-card": "^1.1.2",
    "@data-slot/navigation-menu": "^1.1.2",
    "@data-slot/popover": "^1.1.2",
    "@data-slot/radio-group": "^1.1.2",
    "@data-slot/resizable": "^1.1.2",
    "@data-slot/select": "^1.1.2",
    "@data-slot/slider": "^1.1.2",
    "@data-slot/switch": "^1.1.2",
    "@data-slot/tabs": "^1.1.2",
    "@data-slot/toast": "^1.1.2",
    "@data-slot/toggle": "^1.1.2",
    "@data-slot/toggle-group": "^1.1.2",
    "@data-slot/tooltip": "^1.1.2",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@lexingtonthemes/seo": "^0.4.0",
    "@lucide/astro": "^1.49.0",
    "@shopify/prettier-plugin-liquid": "1.11.2",
    "@shopify/theme-check-node": "3.30.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.0",
    "astro": "^7.3.5",
    "astro-favicons": "^3.1.8",
    "astro-live-code": "^0.0.6",
    "astro-robots-txt": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "embla-carousel": "8.6.0",
    "embla-carousel-auto-scroll": "8.6.0",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "html-validate": "^11.16.1",
    "knip": "^6.39.0",
    "linkinator": "^8.1.0",
    "liquidjs": "10.27.2",
    "lucide-static": "^1.49.0",
    "playwright": "1.64.0",
    "posthog-js": "1.434.15",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.21.0",
    "sharp": "^0.35.5",
    "simple-icons": "^16.33.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "@netlify/vite-plugin": "3.0.1"
  }
}
