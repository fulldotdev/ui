    <div data-slot='carousel-item'>
      <div data-slot='card'><div data-slot='card-content'>First slide</div></div>
    </div>
    <div data-slot='carousel-item'>
      <div data-slot='card'><div data-slot='card-content'>Second slide</div></div>
