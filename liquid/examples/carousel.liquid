<section data-slot='carousel' aria-label='Example gallery'>
  <div data-slot='carousel-content'>
    <div data-slot='carousel-item'>
      <div data-slot='card'><div data-slot='card-content'>First slide</div></div>
    </div>
    <div data-slot='carousel-item'>
      <div data-slot='card'><div data-slot='card-content'>Second slide</div></div>
    </div>
  </div>
  <button data-slot='carousel-previous' data-button data-variant='outline' type='button' hidden>Previous</button
  ><button data-slot='carousel-next' data-button data-variant='outline' type='button' hidden>Next</button>
</section>

<section data-slot='carousel' aria-label='Product images' style='margin-top:48px'>
  <div data-slot='carousel-content'>
    <div data-slot='carousel-item' id='gallery-image-1'>
      <div data-slot='aspect-ratio' data-variant='framed' style='--ratio:4/3;background:var(--muted)'>
        <span style='position:absolute;inset:0;display:grid;place-items:center'>Image 1</span>
      </div>
    </div>
    <div data-slot='carousel-item' id='gallery-image-2'>
      <div data-slot='aspect-ratio' data-variant='framed' style='--ratio:4/3;background:var(--secondary)'>
        <span style='position:absolute;inset:0;display:grid;place-items:center'>Image 2</span>
      </div>
    </div>
    <div data-slot='carousel-item' id='gallery-image-3'>
      <div data-slot='aspect-ratio' data-variant='framed' style='--ratio:4/3;background:var(--accent)'>
        <span style='position:absolute;inset:0;display:grid;place-items:center'>Image 3</span>
      </div>
    </div>
  </div>
  <div style='display:flex;gap:8px'>
    <a
      data-slot='carousel-indicator'
      data-index='0'
      href='#gallery-image-1'
      aria-label='Show image 1'
      style='display:grid;place-items:center;width:64px;aspect-ratio:1;background:var(--muted)'
      >1</a
    >
    <a
      data-slot='carousel-indicator'
      data-index='1'
      href='#gallery-image-2'
      aria-label='Show image 2'
      style='display:grid;place-items:center;width:64px;aspect-ratio:1;background:var(--secondary)'
      >2</a
    >
    <a
      data-slot='carousel-indicator'
      data-index='2'
      href='#gallery-image-3'
      aria-label='Show image 3'
      style='display:grid;place-items:center;width:64px;aspect-ratio:1;background:var(--accent)'
      >3</a
    >
  </div>
</section>
