<div data-slot='rating' aria-label='Example rating: 4 out of 5' role='img'>
  {% for number in (1..5) %}
    <span class='rating__star' aria-hidden='true'>
      <svg viewBox='0 0 24 24' fill='currentColor'>
        <path d="m12 2 3 6 7 1-5 5 1 7-6-3-6 3 1-7-5-5 7-1Z"/>
      </svg>
      {% if number < 5 -%}
        <span class='rating__fill'>
          <svg viewBox='0 0 24 24' fill='currentColor'>
            <path d="m12 2 3 6 7 1-5 5 1 7-6-3-6 3 1-7-5-5 7-1Z"/>
          </svg>
        </span>
      {%- endif %}
    </span>
  {% endfor %}
  <span>Example rating</span>
</div>
