<form data-slot='form' action='{{ routes.search_url }}' method='get'>
  <div data-slot='field-group'>
    <div data-slot='field'>
      <label data-slot='field-label' for='query'>Search products</label>
      <input data-slot='input' id='query' name='q' type='search' required>
    </div>
    <button data-slot='button' type='submit'>Search</button>
  </div>
</form>
