<fieldset data-slot='field-set'>
  <legend id='ui-reference-delivery-label' data-slot='field-legend' data-variant='label'>Delivery</legend>
  <div data-fallback>
    <label data-slot='label'>
      <input
        type='radio'
        name='delivery'
        value='standard'

        checked
      >
      Standard
    </label>

    <label data-slot='label'>
      <input
        type='radio'
        name='delivery'
        value='express'
      >
      Express
    </label>

    <label data-slot='label'>
      <input
        type='radio'
        name='delivery'
        value='pickup'
      >
      Pickup
    </label>
  </div>
  <div
    data-slot='radio-group'
    role='radiogroup'
    data-name='delivery'
    data-default-value='standard'
    aria-labelledby='ui-reference-delivery-label'
    hidden
  >
    <label data-slot='label'>
      <span data-slot='radio-group-item' data-value='standard'>
        <span data-slot='radio-group-indicator'></span>
      </span>
      Standard
    </label>

    <label data-slot='label'>
      <span data-slot='radio-group-item' data-value='express'>
        <span data-slot='radio-group-indicator'></span>
      </span>
      Express
    </label>

    <label data-slot='label'>
      <span data-slot='radio-group-item' data-value='pickup'>
        <span data-slot='radio-group-indicator'></span>
      </span>
      Pickup
    </label>
  </div>
</fieldset>
