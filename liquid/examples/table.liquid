<table data-slot='table'>
  <caption data-slot='table-caption'>
    Example data
  </caption>
  <thead data-slot='table-header'>
    <tr data-slot='table-row'>
      <th data-slot='table-head' scope='col'>Item</th>
      <th data-slot='table-head' scope='col'>Quantity</th>
      <th data-slot='table-head' scope='col'>Price</th>
    </tr>
  </thead>
  <tbody data-slot='table-body'>
    <tr data-slot='table-row'>
      <td data-slot='table-cell'>Example 1</td>
      <td data-slot='table-cell'>1</td>
      <td data-slot='table-cell'>1000</td>
    </tr>

    <tr data-slot='table-row'>
      <td data-slot='table-cell'>Example 2</td>
      <td data-slot='table-cell'>2</td>
      <td data-slot='table-cell'>2000</td>
    </tr>

    <tr data-slot='table-row'>
      <td data-slot='table-cell'>Example 3</td>
      <td data-slot='table-cell'>3</td>
      <td data-slot='table-cell'>3000</td>
    </tr>
  </tbody>
  <tfoot data-slot='table-footer'>
    <tr data-slot='table-row'>
      <td data-slot='table-cell' colspan='2'>Total</td>
      <td data-slot='table-cell'>14000</td>
    </tr>
  </tfoot>
</table>
