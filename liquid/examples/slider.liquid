<div data-slot='field'>
  <span id='ui-reference-range-label' data-slot='label'>Range</span>
  <div role='group' aria-labelledby='ui-reference-range-label' data-fallback>
    <input
      type='range'
      name='range_min'
      min='0'
      max='100'
      step='5'
      value='20'
      aria-label='Minimum'
    >
    <input
      type='range'
      name='range_max'
      min='0'
      max='100'
      step='5'
      value='80'
      aria-label='Maximum'
    >
  </div>
  <div data-slot='slider' data-min='0' data-max='100' data-step='5' data-default-value='20,80' hidden>
    <div data-slot='slider-control'>
      <div data-slot='slider-track'>
        <div data-slot='slider-range'></div>
      </div>
      <div
        data-slot='slider-thumb'
        role='slider'
        aria-valuemin='0'
        aria-valuemax='100'
        aria-valuenow='20'
        aria-label='Minimum'
      ></div>
      <div
        data-slot='slider-thumb'
        role='slider'
        aria-valuemin='0'
        aria-valuemax='100'
        aria-valuenow='80'
        aria-label='Maximum'
      ></div>
    </div>
  </div>
</div>
