<div data-slot='drawer'>
  <button type='button' data-slot='drawer-trigger' data-button data-variant='outline'>Drawer</button>
  <div data-slot='drawer-portal'>
    <div data-slot='drawer-backdrop' hidden></div>
    <div data-slot='drawer-popup' hidden>
      <div data-slot='drawer-handle'></div>
      <div data-slot='drawer-content'>
        <div data-slot='drawer-header'>
          <h3 data-slot='drawer-title'>Drawer</h3>
          <p data-slot='drawer-description'>Swipe down or press Escape to close.</p>
        </div>
        <div data-slot='drawer-footer'>
          <button type='button' data-slot='drawer-close' data-button data-variant='outline'>Close</button>
        </div>
      </div>
    </div>
  </div>
</div>
