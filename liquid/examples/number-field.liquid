<div data-slot='field'>
  <label data-slot='field-label' for='quantity'>Quantity</label>
  <div data-slot='number-field'>
    <div data-slot='input-group-addon'>
      <button
        type='button'
        data-slot='number-field-decrement'
        tabindex='-1'
        data-button
        data-variant='ghost'
        data-size='icon-xs'
        aria-label='Decrease quantity'
      >
        <svg
          class='icon'
          data-slot='icon'
          viewBox='0 0 24 24'
          fill='none'
          stroke='currentColor'
          stroke-width='2'
          stroke-linecap='round'
          stroke-linejoin='round'
          aria-hidden='true'
          focusable='false'
        >
          <path d='M5 12h14'/>
        </svg>
      </button>
    </div>
    <input
      data-slot='input'
      id='quantity'
      type='number'
      inputmode='numeric'
      name='quantity'
      value='1'
      min='1'
      step='1'
    >
    <div data-slot='input-group-addon' data-align='inline-end'>
      <button
        type='button'
        data-slot='number-field-increment'
        tabindex='-1'
        data-button
        data-variant='ghost'
        data-size='icon-xs'
        aria-label='Increase quantity'
      >
        <svg
          class='icon'
          data-slot='icon'
          viewBox='0 0 24 24'
          fill='none'
          stroke='currentColor'
          stroke-width='2'
          stroke-linecap='round'
          stroke-linejoin='round'
          aria-hidden='true'
          focusable='false'
        >
          <path d='M5 12h14'/><path d='M12 5v14'/>
        </svg>
      </button>
    </div>
  </div>
</div>
