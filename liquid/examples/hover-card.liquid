<div data-slot='hover-card'>
  <a
    href='{{ routes.all_products_collection_url }}'
    data-slot='hover-card-trigger'
    data-button
    data-variant='link'
    >Products</a
  >
  <div data-slot='hover-card-portal'>
    <div data-slot='hover-card-positioner'>
      <div data-slot='hover-card-content' hidden>
        <p data-slot='typography-muted'>A hover card previews a link on hover or keyboard focus.</p>
      </div>
    </div>
  </div>
</div>
