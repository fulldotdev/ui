<fieldset data-slot='field-set'>
  <legend data-slot='field-legend' data-variant='label'>Color</legend>
  <div style='display:flex;flex-wrap:wrap;gap:8px'>
    <a data-slot='toggle' data-variant='outline' href='#navy' aria-current='true'>
      <span data-slot='swatch' style='background-color:#1e3a5f' aria-hidden='true'></span>
      Navy
    </a>
    <a data-slot='toggle' data-variant='outline' href='#sand'>
      <span data-slot='swatch' style='background-color:#d8c7a6' aria-hidden='true'></span>
      Sand
    </a>
    <a data-slot='toggle' data-variant='outline' href='#white'>
      <span data-slot='swatch' style='background-color:#ffffff' aria-hidden='true'></span>
      White
    </a>
    <a data-slot='toggle' data-variant='outline' href='#stripe'>
      <span
        data-slot='swatch'
        style='background-image:repeating-linear-gradient(45deg,#1e3a5f 0 3px,#ffffff 3px 6px)'
        aria-hidden='true'
      ></span>
      Stripe
    </a>
  </div>
</fieldset>
