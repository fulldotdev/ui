<div data-slot='popover'>
  <button type='button' data-slot='popover-trigger' data-button data-variant='outline'>Popover</button>
  <div data-slot='popover-portal'>
    <div data-slot='popover-positioner'>
      <div data-slot='popover-content' role='dialog' aria-labelledby='ui-reference-popover-title' hidden>
        <div data-slot='popover-header'>
          <p id='ui-reference-popover-title' data-slot='popover-title'>Popover</p>
          <p data-slot='popover-description'>A popover holds short, nonessential content and links.</p>
        </div>
        <a href='{{ routes.search_url }}' data-slot='button' data-variant='outline' data-size='sm'>Search</a>
      </div>
    </div>
  </div>
</div>
