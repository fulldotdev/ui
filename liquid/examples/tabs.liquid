<div data-slot='tabs' data-default-value='description'>
  <div data-slot='tabs-list' role='tablist' aria-label='Product details'>
    <button type='button' data-slot='tabs-trigger' data-value='description'>Description</button>

    <button type='button' data-slot='tabs-trigger' data-value='details'>Details</button>

    <button type='button' data-slot='tabs-trigger' data-value='care'>Care</button>
  </div>

  <div data-slot='tabs-content' data-value='description'>
    <p data-slot='typography-muted'>Add the product description.</p>
  </div>

  <div data-slot='tabs-content' data-value='details'>
    <p data-slot='typography-muted'>Add materials, dimensions or other details.</p>
  </div>

  <div data-slot='tabs-content' data-value='care'>
    <p data-slot='typography-muted'>Add care instructions.</p>
  </div>
</div>
