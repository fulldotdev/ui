<div data-slot='dialog'>
  <button type='button' data-slot='dialog-trigger' data-button>Open sheet</button>
  <div data-slot='dialog-overlay' hidden></div>
  <div data-slot='dialog-content' data-side='right' hidden>
    <header data-slot='sheet-header'>
      <h2 data-slot='dialog-title'>Example sheet</h2>
      <p data-slot='dialog-description'>Keyboard and focus test.</p>
    </header>
    <button type='button' data-slot='dialog-close' data-button>Close</button>
  </div>
</div>
