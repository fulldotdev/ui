{% doc %}
  Fulldev UI pagination styles. Use native markup with its data-slot parts.
{% enddoc %}

{% stylesheet %}
  /* Links take the button look: ghost, and outline for the current page. */
  [data-slot='pagination'] {
    display: flex;
    justify-content: center;
    width: 100%;
  }
  [data-slot='pagination-content'] {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  [data-slot='pagination-link'] {
    min-width: calc(var(--spacing) * 9);
  }
  [data-slot='pagination-ellipsis'] {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: calc(var(--spacing) * 9);
    height: calc(var(--spacing) * 9);
    color: var(--muted-foreground);
  }
{% endstylesheet %}
