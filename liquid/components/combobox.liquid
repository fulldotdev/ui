{% doc %}
  Fulldev UI combobox styles. Use native markup with its data-slot parts.
{% enddoc %}

{% stylesheet %}
  /* The list of a data-slot combobox, after Vega's combobox. The positioner and the content are
   portaled to the body, so the caller puts its scheme class on combobox-portal. */
  [data-slot='combobox-positioner'] {
    z-index: 1000;
    isolation: isolate;
  }
  [data-slot='combobox-content'] {
    width: var(--anchor-width);
    min-width: 9rem;
    max-width: var(--available-width);
    max-height: min(18rem, var(--available-height));
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--popover);
    color: var(--popover-foreground);
    box-shadow:
      0 0 0 1px color-mix(in oklch, var(--foreground) 10%, transparent),
      var(--shadow-md);
    opacity: 1;
    transform: scale(1);
    transform-origin: var(--transform-origin);
    transition:
      opacity 100ms,
      transform 100ms;
  }
  [data-slot='combobox-content'][data-starting-style],
  [data-slot='combobox-content'][data-ending-style] {
    opacity: 0;
    transform: scale(0.95);
  }
  [data-slot='combobox-list'] {
    max-height: min(18rem, var(--available-height));
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 4px;
    scroll-padding-block: 4px;
    scrollbar-width: none;
  }
  [data-slot='combobox-list'][data-empty] {
    padding: 0;
  }
  [data-slot='combobox-item'] {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 32px 6px 8px;
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    cursor: default;
    user-select: none;
    outline: none;
  }
  [data-slot='combobox-item'][data-highlighted] {
    background: var(--accent);
    color: var(--accent-foreground);
  }
  [data-slot='combobox-item'][data-disabled] {
    opacity: 0.5;
    pointer-events: none;
  }
  [data-slot='combobox-item-indicator'] {
    position: absolute;
    right: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    pointer-events: none;
  }
  [data-slot='combobox-item-indicator'] .icon {
    width: 16px;
    height: 16px;
  }
  [data-slot='combobox-empty'] {
    padding: 8px;
    text-align: center;
    font-size: 0.875rem;
    color: var(--muted-foreground);
  }
{% endstylesheet %}
