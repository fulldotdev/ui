{% doc %}
  Fulldev UI sheet styles. Use native markup with its data-slot parts.
{% enddoc %}

{% stylesheet %}
  /* Dialog content with data-side='right' is a sheet, as shadcn's SheetContent. */
  [data-slot='dialog-content'][data-side='right'] {
    position: fixed;
    inset: 0 0 0 auto;
    z-index: calc(var(--dialog-content-stack-index, 0) * 2 + 101);
    display: flex;
    flex-direction: column;
    gap: 0;
    width: 75%;
    max-width: 24rem;
    height: 100%;
    max-height: none;
    overflow-y: auto;
    padding: 0;
    border-left: 1px solid var(--border);
    border-radius: 0;
    background: var(--popover);
    color: var(--popover-foreground);
    font-size: 0.875rem;
    box-shadow: var(--shadow-lg);
    opacity: 1;
    transform: translateX(0);
    transition:
      opacity 200ms ease-in-out,
      transform 200ms ease-in-out;
  }
  [data-slot='dialog-content'][data-side='right'][data-starting-style],
  [data-slot='dialog-content'][data-side='right'][data-ending-style] {
    opacity: 0;
    transform: translateX(2.5rem);
  }
  [data-slot='sheet-header'] {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: calc(var(--spacing) * 3);
    padding: calc(var(--spacing) * 4);
    background: var(--popover);
  }
  [data-slot='sheet-header'] [data-slot='dialog-title'] {
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: var(--tracking-normal);
    line-height: 1.5;
  }
  [data-slot='sheet-header'] [data-slot='dialog-close'] {
    color: var(--muted-foreground);
  }
  [data-slot='sheet-footer'] {
    position: sticky;
    bottom: 0;
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 2);
    margin-top: auto;
    padding: calc(var(--spacing) * 4);
    border-top: 1px solid var(--border);
    background: var(--popover);
  }
{% endstylesheet %}
