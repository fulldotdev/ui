{% doc %}
  Fulldev UI table styles. Use native markup with its data-slot parts.
{% enddoc %}

{% stylesheet %}
  /* Vega's table: rows between rules, a muted footer and the caption below. */
  [data-slot='table-container'] {
    position: relative;
    width: 100%;
    overflow-x: auto;
  }
  [data-slot='table'] {
    width: 100%;
    border-collapse: collapse;
    caption-side: bottom;
    font-size: 0.875rem;
  }
  [data-slot='table-header'] [data-slot='table-row'] {
    border-bottom: 1px solid var(--border);
  }
  [data-slot='table-row'] {
    border-bottom: 1px solid var(--border);
    transition: background-color 150ms;
  }
  [data-slot='table-body'] [data-slot='table-row']:last-child {
    border-bottom: 0;
  }
  [data-slot='table-body'] [data-slot='table-row']:hover {
    background: color-mix(in oklch, var(--muted) 50%, transparent);
  }
  [data-slot='table-row'][data-state='selected'] {
    background: var(--muted);
  }
  [data-slot='table-footer'] {
    border-top: 1px solid var(--border);
    background: color-mix(in oklch, var(--muted) 50%, transparent);
    font-weight: 500;
  }
  [data-slot='table-footer'] [data-slot='table-row']:last-child {
    border-bottom: 0;
  }
  [data-slot='table-head'] {
    height: calc(var(--spacing) * 10);
    padding-inline: calc(var(--spacing) * 2);
    color: var(--foreground);
    font-weight: 500;
    text-align: left;
    vertical-align: middle;
    white-space: nowrap;
  }
  [data-slot='table-cell'] {
    padding: calc(var(--spacing) * 2);
    vertical-align: middle;
    white-space: nowrap;
  }
  :is([data-slot='table-head'], [data-slot='table-cell']):has([data-slot='checkbox']) {
    padding-right: 0;
  }
  [data-slot='table-caption'] {
    margin-top: calc(var(--spacing) * 4);
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }
{% endstylesheet %}
