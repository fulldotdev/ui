{% doc %}
  Fulldev UI skeleton styles. Use native markup with its data-slot parts.
{% enddoc %}

{% stylesheet %}
  /* A placeholder while content loads, as Fulldev UI's skeleton. */
  [data-slot='skeleton'] {
    border-radius: var(--radius-md);
    background: var(--muted);
    animation: skeleton-pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
  @keyframes skeleton-pulse {
    50% {
      opacity: 0.5;
    }
  }
{% endstylesheet %}
