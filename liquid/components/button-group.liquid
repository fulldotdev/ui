{% doc %}
  Fulldev UI button-group styles. Use native markup with its data-slot parts.
{% enddoc %}

{% stylesheet %}
  [data-slot='button-group'] {
    display: flex;
    align-items: stretch;
    width: fit-content;
  }
  [data-slot='button-group'] > :focus-visible {
    position: relative;
    z-index: 1;
  }
  [data-slot='button-group'] > input {
    flex: 1;
  }
  [data-slot='button-group']:not([data-orientation='vertical']) > [data-slot]:not(:last-child) {
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
  }
  [data-slot='button-group']:not([data-orientation='vertical']) > [data-slot] ~ [data-slot] {
    border-left-width: 0;
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
  }
  [data-slot='button-group'][data-orientation='vertical'] {
    flex-direction: column;
  }
  [data-slot='button-group'][data-orientation='vertical'] > [data-slot]:not(:last-child) {
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
  }
  [data-slot='button-group'][data-orientation='vertical'] > [data-slot] ~ [data-slot] {
    border-top-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
  }
  [data-slot='button-group-text'] {
    display: flex;
    align-items: center;
    gap: calc(var(--spacing) * 2);
    padding-inline: calc(var(--spacing) * 2.5);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--muted);
    font-size: 0.875rem;
    font-weight: 500;
    box-shadow: var(--shadow-xs);
  }
  [data-slot='button-group-separator'] {
    align-self: stretch;
    width: 1px;
    background: var(--input);
  }
{% endstylesheet %}
