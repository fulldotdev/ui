{% doc %}
  Fulldev UI invalid-controls styles. Use native markup with its data-slot parts.
{% enddoc %}

{% stylesheet %}
  /* Vega's invalid border and ring, after the focus rules so they win. The select controller sets
   aria-invalid on its trigger. The radio group and switch controllers validate the native input
   they add right after each item and switch, which matches :user-invalid after a submit attempt. */
  [data-slot='select-trigger'][aria-invalid='true'],
  :is([data-slot='radio-group-item'], [data-slot='switch']):is([aria-invalid='true'], :has(+ input:user-invalid)) {
    border-color: light-dark(var(--destructive), color-mix(in oklch, var(--destructive) 50%, transparent));
    box-shadow: 0 0 0 3px
      light-dark(
        color-mix(in oklch, var(--destructive) 20%, transparent),
        color-mix(in oklch, var(--destructive) 40%, transparent)
      );
  }
{% endstylesheet %}
