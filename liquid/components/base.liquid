{% doc %}
  Fulldev UI base styles. Use native markup with its data-slot parts.
{% enddoc %}

{% stylesheet %}
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    border-color: var(--border);
  }
  body {
    margin: 0;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    background: var(--background);
    color: var(--foreground);
    font: 16px/1.5 var(--font-sans);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizelegibility;
  }
  main {
    flex: 1;
  }
  img,
  video,
  svg,
  iframe {
    max-width: 100%;
  }
  img,
  video,
  svg {
    display: block;
    height: auto;
  }
  a {
    color: inherit;
    text-decoration: none;
    text-underline-offset: 4px;
  }
  button,
  input,
  select,
  textarea {
    font: inherit;
    color: inherit;
  }
  button,
  summary {
    cursor: pointer;
  }
  button {
    border: 0;
    background: none;
    padding: 0;
    border-radius: 0;
  }
  :focus-visible {
    outline: 2px solid color-mix(in oklch, var(--ring) 50%, transparent);
    outline-offset: 2px;
  }
  [hidden] {
    display: none !important;
  }
  h1,
  h2,
  h3,
  h4,
  p,
  figure,
  blockquote,
  fieldset,
  dl,
  dd {
    margin: 0;
  }
  fieldset {
    border: 0;
    padding: 0;
    min-width: 0;
  }
  /* Lists that a part or layout styles with a class; merchant rich text keeps its markers. */
  :where(ul, ol)[class] {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  legend {
    padding: 0;
  }
  p,
  h1,
  h2,
  h3,
  h4,
  a,
  li {
    overflow-wrap: anywhere;
  }
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
{% endstylesheet %}
