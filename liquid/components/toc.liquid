{% doc %}
  Fulldev UI toc styles. Use native markup with its data-slot parts.
{% enddoc %}

{% stylesheet %}
  /* Fulldev UI's toc: links to the headings of a page, the current one in the foreground. */
  [data-slot='toc'] {
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 3);
  }
  [data-slot='toc-title'] {
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: var(--tracking-tight);
  }
  [data-slot='toc-menu'] {
    display: flex;
    flex-direction: column;
    gap: var(--spacing);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  [data-slot='toc-menu-item'] {
    position: relative;
  }
  [data-slot='toc-menu-link'] {
    display: block;
    color: var(--muted-foreground);
    font-size: 0.875rem;
    line-height: 1.5rem;
    transition: color 150ms;
  }
  [data-slot='toc-menu-link']:hover,
  [data-slot='toc-menu-link'][aria-current] {
    color: var(--foreground);
  }
  [data-slot='toc-menu-link'][data-depth='3'] {
    padding-inline-start: calc(var(--spacing) * 4);
  }
  [data-slot='toc-menu-link'][data-depth='4'] {
    padding-inline-start: calc(var(--spacing) * 8);
  }
{% endstylesheet %}
