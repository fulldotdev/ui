{% doc %}
  Fulldev UI badge styles. Use native markup with its data-slot parts.
{% enddoc %}

{% stylesheet %}
  /* A label wider than its container wraps, as a button does; one line keeps Vega's 20px. */
  [data-slot='badge'] {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    gap: var(--spacing);
    width: fit-content;
    max-width: 100%;
    min-height: calc(var(--spacing) * 5);
    padding: calc(var(--spacing) * 0.5) calc(var(--spacing) * 2);
    overflow: hidden;
    border: 1px solid transparent;
    border-radius: var(--radius-4xl);
    background: var(--primary);
    color: var(--primary-foreground);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: calc(var(--spacing) * 3.5);
    text-align: center;
    overflow-wrap: anywhere;
    text-underline-offset: 4px;
    transition:
      background-color 150ms,
      color 150ms;
  }
  [data-slot='badge'] > .icon {
    width: calc(var(--spacing) * 3);
    height: calc(var(--spacing) * 3);
  }
  a[data-slot='badge']:hover {
    background: color-mix(in oklch, var(--primary) 80%, transparent);
  }
  a[data-slot='badge']:focus-visible {
    border-color: var(--ring);
    outline: none;
    box-shadow: var(--focus-ring);
  }
  [data-slot='badge'][data-variant='secondary'] {
    background: var(--secondary);
    color: var(--secondary-foreground);
  }
  a[data-slot='badge'][data-variant='secondary']:hover {
    background: color-mix(in oklch, var(--secondary) 80%, transparent);
  }
  [data-slot='badge'][data-variant='outline'] {
    border-color: var(--border);
    background: transparent;
    color: var(--foreground);
  }
  a[data-slot='badge'][data-variant='outline']:hover {
    background: var(--muted);
    color: var(--muted-foreground);
  }
  [data-slot='badge'][data-variant='destructive'] {
    background: light-dark(
      color-mix(in oklch, var(--destructive) 10%, transparent),
      color-mix(in oklch, var(--destructive) 20%, transparent)
    );
    color: var(--destructive);
  }
  a[data-slot='badge'][data-variant='destructive']:hover {
    background: color-mix(in oklch, var(--destructive) 20%, transparent);
  }
  [data-slot='badge'][data-variant='ghost'] {
    background: transparent;
    color: var(--foreground);
  }
  a[data-slot='badge'][data-variant='ghost']:hover {
    background: light-dark(var(--muted), color-mix(in oklch, var(--muted) 50%, transparent));
    color: var(--muted-foreground);
  }
  [data-slot='badge'][data-variant='link'] {
    background: transparent;
    color: var(--primary);
  }
  a[data-slot='badge'][data-variant='link']:hover {
    background: transparent;
    text-decoration: underline;
  }
{% endstylesheet %}
