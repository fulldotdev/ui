{% doc %}
  Fulldev UI avatar styles. Use native markup with its data-slot parts.
{% enddoc %}

{% stylesheet %}
  [data-slot='avatar'] {
    position: relative;
    display: grid;
    flex: none;
    place-items: center;
    width: calc(var(--spacing) * 8);
    height: calc(var(--spacing) * 8);
    overflow: hidden;
    border-radius: 50%;
    font-size: 0.75rem;
    font-weight: 500;
  }
  [data-slot='avatar'][data-size='sm'] {
    width: calc(var(--spacing) * 6);
    height: calc(var(--spacing) * 6);
  }
  [data-slot='avatar'][data-size='lg'] {
    width: calc(var(--spacing) * 10);
    height: calc(var(--spacing) * 10);
    font-size: 0.875rem;
  }
  [data-slot='avatar-image'] {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }
  /* Overlapping avatars, each ringed with the background. */
  [data-slot='avatar-group'] {
    display: flex;
  }
  [data-slot='avatar-group'] > [data-slot='avatar'] {
    box-shadow: 0 0 0 2px var(--background);
  }
  [data-slot='avatar-group'] > [data-slot='avatar'] + [data-slot='avatar'] {
    margin-inline-start: calc(var(--spacing) * -2);
  }
  [data-slot='avatar-fallback'] {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: var(--muted);
    color: var(--muted-foreground);
  }
{% endstylesheet %}
