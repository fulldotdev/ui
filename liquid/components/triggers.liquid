{% doc %}
  Fulldev UI triggers styles. Use native markup with its data-slot parts.
{% enddoc %}

{% stylesheet %}
  /* A control that only works with its controller, such as a popup trigger, a toggle or a tab list,
   shows once the controller has started, which theme.js marks with data-enhanced. Without it, the
   page keeps the content available: collapsible and tab panels stay open. */
  [data-slot='popover']:not([data-enhanced]) > [data-slot='popover-trigger'],
  [data-slot='dropdown-menu']:not([data-enhanced]) > [data-slot='dropdown-menu-trigger'],
  [data-slot='alert-dialog']:not([data-enhanced]) > [data-slot='alert-dialog-trigger'],
  [data-slot='drawer']:not([data-enhanced]) > [data-slot='drawer-trigger'],
  [data-slot='toast']:not([data-enhanced]) [data-toast-title],
  [data-slot='collapsible']:not([data-enhanced]) > [data-slot='collapsible-trigger'],
  [data-slot='tabs']:not([data-enhanced]) > [data-slot='tabs-list'],
  [data-slot='toggle-group']:not([data-enhanced]),
  button[data-slot='toggle']:not([data-enhanced]) {
    display: none;
  }
{% endstylesheet %}
