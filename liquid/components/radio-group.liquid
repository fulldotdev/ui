{% doc %}
  Fulldev UI radio-group styles. Use native markup with its data-slot parts.
{% enddoc %}

{% stylesheet %}
  /* The items are spans; the controller adds a hidden native radio for each, with the group's name. */
  [data-slot='radio-group'] {
    display: grid;
    gap: calc(var(--spacing) * 3);
  }
  [data-slot='radio-group-item'] {
    position: relative;
    display: flex;
    flex-shrink: 0;
    width: calc(var(--spacing) * 4);
    height: calc(var(--spacing) * 4);
    border: 1px solid var(--input);
    border-radius: 50%;
    background: light-dark(transparent, color-mix(in oklch, var(--input) 30%, transparent));
    box-shadow: var(--shadow-xs);
    outline: none;
    transition: box-shadow 150ms;
  }
  [data-slot='radio-group-item'][data-checked] {
    border-color: var(--primary);
    background: var(--primary);
  }
  [data-slot='radio-group-item']:focus-visible {
    border-color: var(--ring);
    box-shadow: var(--focus-ring);
  }
  [data-slot='radio-group-item'][data-disabled] {
    cursor: not-allowed;
    opacity: 0.5;
  }
  [data-slot='radio-group-indicator'] {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    opacity: 0;
  }
  [data-slot='radio-group-indicator']::after {
    content: '';
    width: calc(var(--spacing) * 2);
    height: calc(var(--spacing) * 2);
    border-radius: 50%;
    background: var(--primary-foreground);
  }
  [data-slot='radio-group-indicator'][data-checked] {
    opacity: 1;
  }
{% endstylesheet %}
