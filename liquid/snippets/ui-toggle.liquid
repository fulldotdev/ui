{% doc %}
  Fulldev UI toggle styles. Use native markup with its data-slot parts.
{% enddoc %}

{% stylesheet %}
  /* Option values and filter values: links or labels with the toggle look. The selected value
   also takes a primary border, so it stands out beyond the fill. */
  [data-slot='toggle'] {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing);
    min-width: calc(var(--spacing) * 9);
    height: calc(var(--spacing) * 9);
    padding-inline: calc(var(--spacing) * 2.5);
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    background: transparent;
    font-size: 0.875rem;
    font-weight: 500;
    white-space: nowrap;
    text-decoration: none;
    outline: none;
    transition:
      background-color 150ms,
      border-color 150ms,
      color 150ms,
      box-shadow 150ms;
  }
  [data-slot='toggle'] > .icon {
    width: calc(var(--spacing) * 4);
    height: calc(var(--spacing) * 4);
  }
  [data-slot='toggle']:hover {
    background: var(--muted);
    color: var(--foreground);
  }
  [data-slot='toggle']:focus-visible,
  [data-slot='toggle']:has(:focus-visible) {
    border-color: var(--ring);
    box-shadow: var(--focus-ring);
  }
  [data-slot='toggle']:is([aria-current], [aria-pressed='true'], :has(:checked)) {
    background: var(--muted);
  }
  [data-slot='toggle'][data-variant='outline'] {
    border-color: var(--input);
    box-shadow: var(--shadow-xs);
  }
  [data-slot='toggle'][data-variant='outline']:is([aria-current], [aria-pressed='true'], :has(:checked)) {
    border-color: var(--primary);
  }
  [data-slot='toggle'][data-size='sm'] {
    min-width: calc(var(--spacing) * 8);
    height: calc(var(--spacing) * 8);
  }
  [data-slot='toggle'][data-size='lg'] {
    min-width: calc(var(--spacing) * 10);
    height: calc(var(--spacing) * 10);
  }
{% endstylesheet %}
