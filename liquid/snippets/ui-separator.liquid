{% doc %}
  Fulldev UI separator styles. Use native markup with its data-slot parts.
{% enddoc %}

{% stylesheet %}
  [data-slot='separator'] {
    flex-shrink: 0;
    width: 100%;
    height: 1px;
    margin: 0;
    border: 0;
    background: var(--border);
  }
  [data-slot='separator'][data-orientation='vertical'] {
    width: 1px;
    height: auto;
    align-self: stretch;
  }
{% endstylesheet %}
