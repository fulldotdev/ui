{% doc %}
  Fulldev UI header styles. Use native markup with its data-slot parts.
{% enddoc %}

{% stylesheet %}
  /* Fulldev UI's header: a full-width bar, or a floating framed bar inset by the gutter. */
  [data-slot='header'] {
    position: relative;
    z-index: 50;
    display: flex;
    align-items: center;
    gap: 16px;
    width: 100%;
    padding-block: 8px;
    background: var(--background);
    color: var(--foreground);
  }
  [data-slot='header'][data-variant='floating'] {
    width: calc(100% - 2 * var(--gutter));
    max-width: calc(var(--container) - 2 * var(--gutter));
    margin: 8px auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  [data-slot='header-group'] {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }
{% endstylesheet %}
