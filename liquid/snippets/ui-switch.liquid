{% doc %}
  Fulldev UI switch styles. Use native markup with its data-slot parts.
{% enddoc %}

{% stylesheet %}
  [data-slot='switch'] {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    width: 32px;
    height: 18.4px;
    border: 1px solid transparent;
    border-radius: 9999px;
    background: light-dark(var(--input), color-mix(in oklch, var(--input) 80%, transparent));
    box-shadow: var(--shadow-xs);
    cursor: pointer;
    outline: none;
    transition:
      background-color 150ms,
      box-shadow 150ms;
  }
  [data-slot='switch'][data-checked] {
    background: var(--primary);
  }
  [data-slot='switch']:focus-visible {
    border-color: var(--ring);
    box-shadow: var(--focus-ring);
  }
  [data-slot='switch'][data-disabled] {
    cursor: not-allowed;
    opacity: 0.5;
  }
  [data-slot='switch-thumb'] {
    display: block;
    width: calc(var(--spacing) * 4);
    height: calc(var(--spacing) * 4);
    border-radius: 50%;
    background: light-dark(var(--background), var(--foreground));
    pointer-events: none;
    transition: translate 150ms;
  }
  [data-slot='switch-thumb'][data-checked] {
    background: light-dark(var(--background), var(--primary-foreground));
    translate: calc(100% - 2px) 0;
  }
  [data-slot='switch'][data-size='sm'] {
    width: 24px;
    height: 14px;
  }
  [data-slot='switch'][data-size='sm'] [data-slot='switch-thumb'] {
    width: calc(var(--spacing) * 3);
    height: calc(var(--spacing) * 3);
  }
{% endstylesheet %}
