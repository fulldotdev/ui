{% doc %}
  Fulldev UI aspect-ratio styles. Use native markup with its data-slot parts.
{% enddoc %}

{% stylesheet %}
  /* Media at a fixed ratio, covered by its image on a muted fill until it loads. The caller rounds it
   as its Fulldev UI block does; framed adds the rounded border of Fulldev UI's video. */
  [data-slot='aspect-ratio'] {
    position: relative;
    overflow: hidden;
    aspect-ratio: var(--ratio, 4 / 3);
    background: var(--muted);
  }
  [data-slot='aspect-ratio'][data-variant='framed'] {
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
  }
  [data-slot='aspect-ratio'] > :is(img, svg, video, iframe, picture) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  [data-slot='aspect-ratio'] > svg {
    fill: color-mix(in oklch, var(--muted-foreground) 35%, transparent);
  }
{% endstylesheet %}
