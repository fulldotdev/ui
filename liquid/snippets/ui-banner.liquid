{% doc %}
  Fulldev UI banner styles. Use native markup with its data-slot parts.
{% enddoc %}

{% stylesheet %}
  /* Fulldev UI's banner: inverted across the page, or a floating framed panel inset by the gutter. */
  [data-slot='banner'] {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
    padding-block: 8px;
    background: var(--foreground);
    color: var(--background);
  }
  [data-slot='banner'][data-variant='floating'] {
    width: calc(100% - 2 * var(--gutter));
    max-width: calc(var(--container) - 2 * var(--gutter));
    margin: 8px auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--background);
    color: var(--foreground);
    box-shadow: var(--shadow-sm);
  }
  [data-slot='banner-container'] {
    position: relative;
    display: flex;
    gap: 16px;
    width: 100%;
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  [data-slot='banner'] a:not([data-slot]) {
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
{% endstylesheet %}
