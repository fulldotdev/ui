{% doc %}
  Fulldev UI empty styles. Use native markup with its data-slot parts.
{% enddoc %}

{% stylesheet %}
  [data-slot='empty'] {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: calc(var(--spacing) * 4);
    width: 100%;
    min-width: 0;
    padding: calc(var(--spacing) * 12);
    border-radius: var(--radius-lg);
    text-align: center;
    text-wrap: balance;
  }
  [data-slot='empty'][data-variant='outline'] {
    border: 1px dashed var(--border);
  }
  [data-slot='empty-header'] {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(var(--spacing) * 2);
    max-width: 24rem;
  }
  [data-slot='empty-icon'] {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    margin-bottom: calc(var(--spacing) * 2);
  }
  [data-slot='empty-icon'][data-variant='icon'] {
    width: calc(var(--spacing) * 10);
    height: calc(var(--spacing) * 10);
    border-radius: var(--radius-lg);
    background: var(--muted);
    color: var(--foreground);
  }
  [data-slot='empty-icon'][data-variant='icon'] > .icon {
    width: calc(var(--spacing) * 6);
    height: calc(var(--spacing) * 6);
  }
  [data-slot='empty-title'] {
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.75rem;
    letter-spacing: var(--tracking-tight);
  }
  [data-slot='empty-description'] {
    font-size: 0.875rem;
    line-height: 1.625;
    color: var(--muted-foreground);
  }
  [data-slot='empty-description'] a {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  [data-slot='empty-content'] {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: calc(var(--spacing) * 3);
    width: 100%;
    max-width: 24rem;
    font-size: 0.875rem;
  }
  @media (max-width: 639px) {
    [data-slot='empty'] {
      padding: 32px 16px;
    }
  }
{% endstylesheet %}
