{% doc %}
  Fulldev UI tabs styles. Use native markup with its data-slot parts.
{% enddoc %}

{% stylesheet %}
  /* Vega's tabs. The controller sets data-state='active' on the selected trigger and its content. */
  [data-slot='tabs'] {
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 2);
  }
  [data-slot='tabs-list'] {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    height: calc(var(--spacing) * 9);
    padding: 3px;
    border-radius: var(--radius-lg);
    background: var(--muted);
    color: var(--muted-foreground);
  }
  [data-slot='tabs-trigger'] {
    position: relative;
    display: inline-flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    gap: calc(var(--spacing) * 1.5);
    height: calc(100% - 1px);
    padding: var(--spacing) calc(var(--spacing) * 2);
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    color: color-mix(in oklch, var(--foreground) 60%, transparent);
    font-size: 0.875rem;
    font-weight: 500;
    white-space: nowrap;
    outline: none;
    transition:
      color 150ms,
      background-color 150ms,
      box-shadow 150ms;
  }
  [data-slot='tabs-trigger']:hover {
    color: var(--foreground);
  }
  [data-slot='tabs-trigger']:focus-visible {
    border-color: var(--ring);
    box-shadow: var(--focus-ring);
  }
  [data-slot='tabs-trigger'][data-state='active'] {
    border-color: light-dark(transparent, var(--input));
    background: light-dark(var(--background), color-mix(in oklch, var(--input) 30%, transparent));
    color: var(--foreground);
    box-shadow: var(--shadow-sm);
  }
  [data-slot='tabs-trigger']:disabled {
    opacity: 0.5;
    pointer-events: none;
  }
  [data-slot='tabs-trigger'] > .icon {
    width: calc(var(--spacing) * 4);
    height: calc(var(--spacing) * 4);
  }
  [data-slot='tabs-list'][data-variant='line'] {
    gap: var(--spacing);
    border-radius: 0;
    background: transparent;
  }
  [data-slot='tabs-list'][data-variant='line'] [data-slot='tabs-trigger'][data-state='active'] {
    border-color: transparent;
    background: transparent;
    box-shadow: none;
  }
  [data-slot='tabs-list'][data-variant='line'] [data-slot='tabs-trigger'][data-state='active']::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: -5px;
    height: 2px;
    background: var(--foreground);
  }
  [data-slot='tabs-content'] {
    flex: 1;
    font-size: 0.875rem;
    outline: none;
  }
{% endstylesheet %}
