{% doc %}
  Fulldev UI slider styles. Use native markup with its data-slot parts.
{% enddoc %}

{% stylesheet %}
  /* The controller positions the range and thumbs; these rules only draw them. */
  [data-slot='slider'] {
    width: 100%;
  }
  [data-slot='slider-control'] {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
    min-height: calc(var(--spacing) * 4);
    touch-action: none;
    user-select: none;
  }
  [data-slot='slider-control'][data-disabled] {
    opacity: 0.5;
  }
  [data-slot='slider-track'] {
    position: relative;
    flex-grow: 1;
    height: 6px;
    overflow: hidden;
    border-radius: 9999px;
    background: var(--muted);
  }
  [data-slot='slider-range'] {
    height: 100%;
    background: var(--primary);
  }
  [data-slot='slider-thumb'] {
    display: block;
    flex-shrink: 0;
    width: calc(var(--spacing) * 4);
    height: calc(var(--spacing) * 4);
    border: 1px solid var(--primary);
    border-radius: 50%;
    background: var(--background);
    box-shadow: var(--shadow-sm);
    outline: none;
    transition: box-shadow 150ms;
  }
  [data-slot='slider-thumb']:hover,
  [data-slot='slider-thumb']:focus-visible {
    box-shadow: 0 0 0 4px color-mix(in oklch, var(--ring) 50%, transparent);
  }
{% endstylesheet %}
