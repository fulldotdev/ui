{% doc %}
  Fulldev UI select styles. Use native markup with its data-slot parts.
{% enddoc %}

{% stylesheet %}
  /* The data-slot select: a trigger like the native select and a listbox popup, as Vega's select. */
  [data-slot='select-trigger'] {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: calc(var(--spacing) * 1.5);
    width: 100%;
    height: calc(var(--spacing) * 9);
    padding: calc(var(--spacing) * 2) calc(var(--spacing) * 2) calc(var(--spacing) * 2) calc(var(--spacing) * 2.5);
    border: 1px solid var(--input);
    border-radius: var(--radius-md);
    background: light-dark(transparent, color-mix(in oklch, var(--input) 30%, transparent));
    font-size: 0.875rem;
    white-space: nowrap;
    box-shadow: var(--shadow-xs);
    outline: none;
    transition:
      color 150ms,
      box-shadow 150ms;
  }
  [data-slot='select-trigger'][data-placeholder] {
    color: var(--muted-foreground);
  }
  [data-slot='select-trigger']:focus-visible {
    border-color: var(--ring);
    box-shadow: var(--focus-ring);
  }
  [data-slot='select-trigger']:disabled {
    cursor: not-allowed;
    opacity: 0.5;
  }
  [data-slot='select-trigger'] > .icon {
    width: calc(var(--spacing) * 4);
    height: calc(var(--spacing) * 4);
    color: var(--muted-foreground);
  }
  [data-slot='select'][data-size='sm'] [data-slot='select-trigger'] {
    height: calc(var(--spacing) * 8);
  }
  [data-slot='select-value'] {
    flex: 1;
    overflow: hidden;
    text-align: left;
    text-overflow: ellipsis;
  }
{% endstylesheet %}
