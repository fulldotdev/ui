{% doc %}
  Fulldev UI number field styles. Use native markup with its data-slot parts.
{% enddoc %}

{% stylesheet %}
  /* A native number input with decrement and increment buttons in input group addons, such as a
   quantity. The input works on its own, and its arrow keys step it. The buttons take tabindex='-1',
   as in Base UI; the runtime connects them, so they stay invisible until it has started. */
  [data-slot='number-field'] {
    width: calc(var(--spacing) * 32);
  }
  [data-slot='number-field'] > input {
    text-align: center;
    font-variant-numeric: tabular-nums;
    appearance: textfield;
  }
  [data-slot='number-field'] > input::-webkit-inner-spin-button,
  [data-slot='number-field'] > input::-webkit-outer-spin-button {
    margin: 0;
    appearance: none;
  }
  [data-slot='number-field']:not([data-enhanced])
    :is([data-slot='number-field-decrement'], [data-slot='number-field-increment']) {
    visibility: hidden;
  }
{% endstylesheet %}
