{% doc %}
  Fulldev UI input-group styles. Use native markup with its data-slot parts.
{% enddoc %}

{% stylesheet %}
  /* An input with addons inside one border, as Fulldev UI's input group. The input keeps the slot of
   its own component, such as combobox-input. A number field is an input group with step buttons. */
  :is([data-slot='input-group'], [data-slot='number-field']) {
    display: flex;
    align-items: center;
    min-width: 0;
    height: calc(var(--spacing) * 9);
    border: 1px solid var(--input);
    border-radius: var(--radius-md);
    background-color: light-dark(transparent, color-mix(in oklch, var(--input) 30%, transparent));
    box-shadow: var(--shadow-xs);
    transition:
      border-color 150ms,
      box-shadow 150ms;
  }
  [data-slot='input-group'] {
    width: 100%;
  }
  :is([data-slot='input-group'], [data-slot='number-field'])[data-size='sm'] {
    height: calc(var(--spacing) * 8);
  }
  :is([data-slot='input-group'], [data-slot='number-field']):has(> input:focus-visible) {
    border-color: var(--ring);
    box-shadow: var(--focus-ring);
  }
  :is([data-slot='input-group'], [data-slot='number-field']):has(> input[aria-invalid='true']) {
    border-color: light-dark(var(--destructive), color-mix(in oklch, var(--destructive) 50%, transparent));
    box-shadow: 0 0 0 3px
      light-dark(
        color-mix(in oklch, var(--destructive) 20%, transparent),
        color-mix(in oklch, var(--destructive) 40%, transparent)
      );
  }
  :is([data-slot='input-group'], [data-slot='number-field']) > input {
    flex: 1;
    height: 100%;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }
  :is([data-slot='input-group'], [data-slot='number-field']) > input:is(:focus-visible, [aria-invalid='true']) {
    box-shadow: none;
  }
  /* An addon before the input sits at the start and one after it at the end; data-align='inline-start'
   or 'inline-end' names the side, as in Fulldev UI. A button in it moves a little closer to the
   edge, and the input gives up some of its padding on the addon's side. */
  [data-slot='input-group-addon'] {
    display: flex;
    align-items: center;
    gap: calc(var(--spacing) * 2);
    color: var(--muted-foreground);
    font-size: 0.875rem;
    font-weight: 500;
  }
  [data-slot='input-group-addon']:is([data-align='inline-start'], :not([data-align]):has(~ input)) {
    padding-left: calc(var(--spacing) * 2);
  }
  [data-slot='input-group-addon']:is([data-align='inline-end'], input ~ :not([data-align])) {
    padding-right: calc(var(--spacing) * 2);
  }
  [data-slot='input-group-addon']:is([data-align='inline-start'], :not([data-align]):has(~ input)):has(> button) {
    margin-left: calc(var(--spacing) * -1);
  }
  [data-slot='input-group-addon']:is([data-align='inline-end'], input ~ :not([data-align])):has(> button) {
    margin-right: calc(var(--spacing) * -1);
  }
  :is([data-slot='input-group'], [data-slot='number-field'])
    > [data-slot='input-group-addon']:not([data-align='inline-end'])
    ~ input {
    padding-left: calc(var(--spacing) * 1.5);
  }
  :is([data-slot='input-group'], [data-slot='number-field'])
    > input:has(~ [data-slot='input-group-addon']:not([data-align='inline-start'])) {
    padding-right: calc(var(--spacing) * 1.5);
  }
  [data-slot='input-group-addon'] > .icon {
    width: calc(var(--spacing) * 4);
    height: calc(var(--spacing) * 4);
  }
{% endstylesheet %}
