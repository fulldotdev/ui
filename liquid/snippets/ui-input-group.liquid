{% doc %}
  Fulldev UI input-group styles. Use native markup with its data-slot parts.
{% enddoc %}

{% stylesheet %}
  /* An input with addons inside one border, as Fulldev UI's input group. The input keeps the slot of
   its own component, such as combobox-input. */
  [data-slot='input-group'] {
    display: flex;
    align-items: center;
    width: 100%;
    min-width: 0;
    height: calc(var(--spacing) * 9);
    border: 1px solid var(--input);
    border-radius: var(--radius-md);
    background-color: light-dark(transparent, color-mix(in oklch, var(--input) 30%, transparent));
    box-shadow: var(--shadow-xs);
    transition:
      border-color 150ms,
      box-shadow 150ms;
  }
  [data-slot='input-group'][data-size='sm'] {
    height: calc(var(--spacing) * 8);
  }
  [data-slot='input-group']:has(> input:focus-visible) {
    border-color: var(--ring);
    box-shadow: var(--focus-ring);
  }
  [data-slot='input-group'] > input {
    flex: 1;
    height: 100%;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }
  [data-slot='input-group'] > input:focus-visible {
    box-shadow: none;
  }
  [data-slot='input-group-addon'] {
    display: flex;
    align-items: center;
    gap: calc(var(--spacing) * 2);
    padding-right: calc(var(--spacing) * 2);
    color: var(--muted-foreground);
    font-size: 0.875rem;
    font-weight: 500;
  }
  [data-slot='input-group-addon'] > .icon {
    width: calc(var(--spacing) * 4);
    height: calc(var(--spacing) * 4);
  }
{% endstylesheet %}
