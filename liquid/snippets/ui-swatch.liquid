{% doc %}
  Fulldev UI swatch styles. Use native markup with its data-slot parts.
{% enddoc %}

{% stylesheet %}
  /* A color or pattern beside an option or filter value, such as Shopify's swatch.color or
   swatch.image. Set the background in a style attribute; the faint inner ring keeps white and
   black visible on any background. It is decorative, so the value's name stays in text. */
  [data-slot='swatch'] {
    display: inline-block;
    flex-shrink: 0;
    width: calc(var(--spacing) * 4);
    height: calc(var(--spacing) * 4);
    border-radius: 999px;
    background-position: center;
    background-size: cover;
    box-shadow: inset 0 0 0 1px color-mix(in oklch, var(--foreground) 15%, transparent);
  }
{% endstylesheet %}
