{% doc %}
  Fulldev UI spinner styles. Use native markup with its data-slot parts.
{% enddoc %}

{% stylesheet %}
  /* Fulldev UI's spinner: a turning loader icon in a role=status element with a translated label. */
  [data-slot='spinner'] {
    display: inline-flex;
    flex-shrink: 0;
    width: calc(var(--spacing) * 4);
    height: calc(var(--spacing) * 4);
    animation: spinner-turn 1s linear infinite;
  }
  [data-slot='spinner'] > .icon {
    width: 100%;
    height: 100%;
  }
  @keyframes spinner-turn {
    to {
      rotate: 360deg;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-slot='spinner'] {
      animation-duration: 3s;
    }
  }
{% endstylesheet %}
