{% doc %}
  Fulldev UI item styles. Use native markup with its data-slot parts.
{% enddoc %}

{% stylesheet %}
  /* A row of media, content and actions, as Vega's item. */
  [data-slot='item'] {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: calc(var(--spacing) * 3.5);
    width: 100%;
    padding: calc(var(--spacing) * 3.5) calc(var(--spacing) * 4);
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    font-size: 0.875rem;
    outline: none;
    transition: background-color 100ms;
  }
  a[data-slot='item']:hover {
    background: var(--muted);
  }
  [data-slot='item']:focus-visible {
    border-color: var(--ring);
    box-shadow: var(--focus-ring);
  }
  [data-slot='item'][data-variant='outline'] {
    border-color: var(--border);
  }
  [data-slot='item'][data-variant='muted'] {
    background: color-mix(in oklch, var(--muted) 50%, transparent);
  }
  [data-slot='item'][data-size='sm'] {
    gap: calc(var(--spacing) * 2.5);
    padding: calc(var(--spacing) * 2.5) calc(var(--spacing) * 3);
  }
  [data-slot='item'][data-size='xs'] {
    gap: calc(var(--spacing) * 2);
    padding: calc(var(--spacing) * 2) calc(var(--spacing) * 2.5);
  }
  [data-slot='item-media'] {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    gap: calc(var(--spacing) * 2);
  }
  [data-slot='item']:has([data-slot='item-description']) > [data-slot='item-media'] {
    align-self: flex-start;
    translate: 0 2px;
  }
  [data-slot='item-media'] > .icon {
    width: calc(var(--spacing) * 4);
    height: calc(var(--spacing) * 4);
  }
  [data-slot='item-media'][data-variant='image'] {
    width: calc(var(--spacing) * 10);
    height: calc(var(--spacing) * 10);
    overflow: hidden;
    border-radius: var(--radius-sm);
  }
  [data-slot='item-media'][data-variant='image'] img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  [data-slot='item-content'] {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--spacing);
    min-width: 0;
  }
  [data-slot='item-title'] {
    display: flex;
    align-items: center;
    gap: calc(var(--spacing) * 2);
    font-weight: 500;
    line-height: 1.375;
  }
  [data-slot='item-description'] {
    color: var(--muted-foreground);
    line-height: 1.5;
  }
  [data-slot='item'][data-size='xs'] [data-slot='item-content'] {
    gap: 0;
  }
  [data-slot='item'][data-size='xs'] [data-slot='item-description'] {
    font-size: 0.75rem;
  }
  [data-slot='item-actions'],
  [data-slot='item-header'],
  [data-slot='item-footer'] {
    display: flex;
    align-items: center;
    gap: calc(var(--spacing) * 2);
  }
  [data-slot='item-header'],
  [data-slot='item-footer'] {
    flex-basis: 100%;
    justify-content: space-between;
  }
  [data-slot='item-group'] {
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  [data-slot='item-group']:has([data-slot='item'][data-size='sm']) {
    gap: calc(var(--spacing) * 2.5);
  }
{% endstylesheet %}
