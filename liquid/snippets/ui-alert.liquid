{% doc %}
  Fulldev UI alert styles. Use native markup with its data-slot parts.
{% enddoc %}

{% stylesheet %}
  [data-slot='alert'] {
    display: grid;
    gap: calc(var(--spacing) * 0.5);
    padding: calc(var(--spacing) * 3) calc(var(--spacing) * 4);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--card);
    color: var(--card-foreground);
    font-size: 0.875rem;
    text-align: left;
  }
  [data-slot='alert']:has(> .icon) {
    grid-template-columns: auto 1fr;
    column-gap: calc(var(--spacing) * 2.5);
  }
  [data-slot='alert'] > .icon {
    grid-row: span 2;
    width: calc(var(--spacing) * 4);
    height: calc(var(--spacing) * 4);
    translate: 0 calc(var(--spacing) * 0.5);
    color: currentcolor;
  }
  [data-slot='alert'][data-variant='destructive'] {
    color: var(--destructive);
  }
  [data-slot='alert-title'] {
    font-weight: 500;
  }
  [data-slot='alert-description'] {
    color: var(--muted-foreground);
    text-wrap: balance;
  }
  [data-slot='alert'][data-variant='destructive'] [data-slot='alert-description'] {
    color: color-mix(in oklch, var(--destructive) 90%, transparent);
  }
  [data-slot='alert'] ul {
    margin: 0;
    padding-left: calc(var(--spacing) * 4.5);
  }
{% endstylesheet %}
