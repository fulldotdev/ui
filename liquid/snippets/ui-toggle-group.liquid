{% doc %}
  Fulldev UI toggle-group styles. Use native markup with its data-slot parts.
{% enddoc %}

{% stylesheet %}
  /* Joined toggles, as Vega's toggle group without spacing. The group sets the variant and size. */
  [data-slot='toggle-group'] {
    display: flex;
    align-items: center;
    width: fit-content;
    border-radius: var(--radius-md);
  }
  [data-slot='toggle-group'][data-variant='outline'] {
    box-shadow: var(--shadow-xs);
  }
  [data-slot='toggle-group-item'] {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing);
    min-width: calc(var(--spacing) * 9);
    height: calc(var(--spacing) * 9);
    padding-inline: calc(var(--spacing) * 2);
    border: 1px solid transparent;
    border-radius: 0;
    background: transparent;
    font-size: 0.875rem;
    font-weight: 500;
    white-space: nowrap;
    outline: none;
    transition:
      background-color 150ms,
      color 150ms,
      box-shadow 150ms;
  }
  [data-slot='toggle-group-item']:first-child {
    border-top-left-radius: var(--radius-md);
    border-bottom-left-radius: var(--radius-md);
  }
  [data-slot='toggle-group-item']:last-child {
    border-top-right-radius: var(--radius-md);
    border-bottom-right-radius: var(--radius-md);
  }
  [data-slot='toggle-group-item']:hover,
  [data-slot='toggle-group-item'][data-state='on'] {
    background: var(--muted);
    color: var(--foreground);
  }
  [data-slot='toggle-group-item']:focus-visible {
    position: relative;
    z-index: 1;
    border-color: var(--ring);
    box-shadow: var(--focus-ring);
  }
  [data-slot='toggle-group-item']:disabled {
    opacity: 0.5;
    pointer-events: none;
  }
  [data-slot='toggle-group-item'] > .icon {
    width: calc(var(--spacing) * 4);
    height: calc(var(--spacing) * 4);
  }
  [data-slot='toggle-group'][data-variant='outline'] [data-slot='toggle-group-item'] {
    border-color: var(--input);
  }
  [data-slot='toggle-group'][data-variant='outline'] [data-slot='toggle-group-item'] + [data-slot='toggle-group-item'] {
    border-left-width: 0;
  }
  [data-slot='toggle-group'][data-size='sm'] [data-slot='toggle-group-item'] {
    min-width: calc(var(--spacing) * 8);
    height: calc(var(--spacing) * 8);
  }
  [data-slot='toggle-group'][data-size='lg'] [data-slot='toggle-group-item'] {
    min-width: calc(var(--spacing) * 10);
    height: calc(var(--spacing) * 10);
  }
{% endstylesheet %}
