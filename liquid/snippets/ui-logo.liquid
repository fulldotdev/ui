{% doc %}
  Fulldev UI logo styles. Use native markup with its data-slot parts.
{% enddoc %}

{% stylesheet %}
  /* A wordmark stays on one line and ends in an ellipsis when it is wider than its container;
   the full name stays in the text. */
  [data-slot='logo'] {
    display: flex;
    align-items: center;
    gap: 8px;
    max-width: 100%;
    height: 40px;
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
    white-space: nowrap;
  }
  [data-slot='logo-text'] {
    overflow: hidden;
    font-size: 1.125rem;
    text-overflow: ellipsis;
  }
  [data-slot='logo-image'] {
    flex: none;
    width: var(--logo-width, auto);
    height: auto;
    max-height: 40px;
    object-fit: contain;
    object-position: left;
  }
{% endstylesheet %}
