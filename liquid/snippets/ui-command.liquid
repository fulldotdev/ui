{% doc %}
  Fulldev UI command styles. Use native markup with its data-slot parts.
{% enddoc %}

{% stylesheet %}
  [data-slot='command'] {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  [data-slot='command-input-wrapper'] {
    padding: 4px 4px 0;
  }

  [data-slot='command-input'] {
    flex: 1;
    height: 100%;
    padding: 0 4px;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    font-size: 0.875rem;
  }

  [data-slot='command-input']:focus-visible {
    box-shadow: none;
    outline: 0;
  }

  [data-slot='command-input']::-webkit-search-cancel-button {
    appearance: none;
  }

  [data-slot='command-list'] {
    height: var(--search-results-height, auto);
    max-height: 18rem;
    overflow: hidden auto;
    scroll-padding-block: 4px;
    scrollbar-width: none;
    transition: height 150ms ease-out;
  }

  [data-slot='command-group'] {
    padding: 4px;
  }

  [data-slot='command-group'] + [data-slot='command-group'] {
    border-top: 1px solid var(--border);
  }

  [data-slot='command-group-heading'] {
    padding: 6px 8px;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--muted-foreground);
  }

  [data-slot='command-item'] {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 6px 8px;
    border-radius: var(--radius-lg);
    cursor: default;
    user-select: none;
  }

  [data-slot='command-item'][data-selected] {
    background: var(--muted);
    color: var(--foreground);
  }

  [data-slot='command-item'] > .icon {
    width: 16px;
    height: 16px;
    color: var(--muted-foreground);
  }

  [data-slot='command-item'][data-selected] > .icon {
    color: var(--foreground);
  }
{% endstylesheet %}
