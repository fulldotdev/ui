{% doc %}
  Fulldev UI drawer styles. Use native markup with its data-slot parts.
{% enddoc %}

{% stylesheet %}
  /* A bottom drawer, as Vega's drawer. The controller sets the snap and swipe offsets. */
  [data-slot='drawer-backdrop'] {
    position: fixed;
    inset: 0;
    z-index: calc(var(--drawer-overlay-stack-index, 0) * 2 + 100);
    background: var(--scrim);
    opacity: calc(1 - var(--drawer-swipe-progress, 0));
    transition: opacity 450ms cubic-bezier(0.32, 0.72, 0, 1);
  }
  @supports (backdrop-filter: blur(4px)) {
    [data-slot='drawer-backdrop'] {
      backdrop-filter: blur(4px);
    }
  }
  [data-slot='drawer-backdrop']:is([data-starting-style], [data-ending-style]) {
    opacity: 0;
  }
  [data-slot='drawer-backdrop'][data-swiping] {
    transition: none;
  }
  [data-slot='drawer-popup'] {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: calc(var(--drawer-content-stack-index, 0) * 2 + 101);
    display: flex;
    flex-direction: column;
    width: 100%;
    max-height: 80vh;
    border-top: 1px solid var(--border);
    border-radius: var(--radius-xl) var(--radius-xl) 0 0;
    background: var(--popover);
    color: var(--popover-foreground);
    font-size: 0.875rem;
    box-shadow: var(--shadow-lg);
    outline: none;
    transform: translateY(calc(var(--drawer-snap-point-offset, 0px) + var(--drawer-swipe-amount-y, 0px)));
    transition: transform 450ms cubic-bezier(0.32, 0.72, 0, 1);
  }
  [data-slot='drawer-popup']:is([data-starting-style], [data-ending-style]) {
    transform: translateY(100%);
  }
  [data-slot='drawer-popup'][data-swiping] {
    transition: none;
  }
  [data-slot='drawer-handle'] {
    flex-shrink: 0;
    width: 100px;
    height: 6px;
    margin: calc(var(--spacing) * 4) auto 0;
    border-radius: 9999px;
    background: var(--muted);
  }
  [data-slot='drawer-content'] {
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 32rem;
    min-height: 0;
    margin-inline: auto;
    overflow-y: auto;
  }
  [data-slot='drawer-header'] {
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 0.5);
    padding: calc(var(--spacing) * 4);
    text-align: center;
  }
  [data-slot='drawer-title'] {
    color: var(--foreground);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: var(--tracking-normal);
  }
  [data-slot='drawer-description'] {
    color: var(--muted-foreground);
  }
  [data-slot='drawer-footer'] {
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 2);
    margin-top: auto;
    padding: calc(var(--spacing) * 4);
  }
  @media (min-width: 768px) {
    [data-slot='drawer-header'] {
      gap: calc(var(--spacing) * 1.5);
      text-align: left;
    }
  }
{% endstylesheet %}
