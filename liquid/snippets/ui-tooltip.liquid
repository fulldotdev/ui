{% doc %}
  Fulldev UI tooltip styles. Use native markup with its data-slot parts.
{% enddoc %}

{% stylesheet %}
  /* Inverted colors: the scheme's foreground as the fill, as Fulldev UI's tooltip. */
  [data-slot='tooltip-content'] {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: calc(var(--spacing) * 1.5);
    width: fit-content;
    max-width: 20rem;
    padding: calc(var(--spacing) * 1.5) calc(var(--spacing) * 3);
    border-radius: var(--radius-md);
    background: var(--foreground);
    color: var(--background);
    font-size: 0.75rem;
    line-height: 1.33;
    transform-origin: var(--transform-origin, center);
    transition:
      opacity 100ms,
      scale 100ms;
  }
  [data-slot='tooltip-arrow'] {
    position: absolute;
    width: 10px;
    height: 10px;
    border-radius: 2px;
    background: var(--foreground);
    rotate: 45deg;
  }
  [data-slot='tooltip-arrow'][data-side='bottom'] {
    top: -4px;
  }
  [data-slot='tooltip-arrow'][data-side='top'] {
    bottom: -4px;
  }
  [data-slot='tooltip-arrow'][data-side='left'] {
    right: -4px;
  }
  [data-slot='tooltip-arrow'][data-side='right'] {
    left: -4px;
  }
{% endstylesheet %}
