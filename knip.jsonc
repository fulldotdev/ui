{
  "ignoreBinaries": ["vp"],
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        // The registry publishes these; sites import a component through its index.
        "src/components/ui/*/index.ts",
        "src/components/blocks/*.astro",
        "src/lib/utils.ts",
        // The page route loads layouts through import.meta.glob.
        "src/layouts/*.astro",
        // Example files install from the registry; the docs load them through
        // import.meta.glob.
        "src/components/examples/*/*.astro",
        // Block demos, loaded by src/pages/preview/astro through import.meta.glob.
        "src/gallery/blocks/*.astro",
        // Docs pages, loaded by the content collection, import the examples.
        "src/content/**/*.mdx",
        // astro.config.ts passes this to astro-live-code by path.
        "src/components/live-code.astro",
        // Read by the html-validate CLI in the build.
        "html-validate.config.mjs",
        "liquid/assets/ui-*.js",
        // src/lib/liquid.ts loads this in the generated preview HTML.
        "public/preview/liquid.js",
      ],
      // Read as text by src/lib/styles.ts and the registry scripts.
      "ignoreFiles": [
        "registry/styles/**/*.css",
        "liquid/assets/data-slot-*.js",
        "liquid/assets/*.css",
        "liquid/primitives.css",
      ],
      "ignoreIssues": {
        // Part of the installed price component, shipped unchanged.
        "src/components/ui/price/format-price-value.ts": ["exports"],
      },
      "ignoreDependencies": [
        // Read from node_modules by the Icon component.
        "lucide-static",
        // Native Liquid resolves these through its Shopify import map.
        "@fulldev/lifecycle",
        "@fulldev/controls",
        "@fulldev/carousel",
        "@fulldev/motion",
      ],
    },
    "react": {
      "entry": [
        // The React registry publishes the extras and blocks; the standard
        // shadcn/ui components and hooks are local copies for the gallery.
        "src/components/ui/*.tsx",
        "src/components/blocks/*.tsx",
        "src/hooks/*.{ts,tsx}",
        "src/lib/*.ts",
        // The gallery loads its demos through import.meta.glob.
        "gallery/ui/*.tsx",
        "gallery/blocks/*.tsx",
      ],
    },
  },
}
