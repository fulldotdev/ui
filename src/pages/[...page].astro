---
import { getPages } from "@/lib/pages"
import LayoutRenderer from "@/components/layout-renderer.astro"

export async function getStaticPaths() {
  const pages = await getPages()
  return pages.map((page) => ({
    params: { page: page.id === "index" ? undefined : page.id },
    props: page,
  }))
}
---

<LayoutRenderer {...Astro.props} />
