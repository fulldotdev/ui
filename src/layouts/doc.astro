---
import type { MarkdownHeading } from "astro"

import type { GlobalSchema } from "@/schemas/global"
import type { DocSchema } from "@/schemas/layouts/doc"
import type { Page, PageContext } from "@/lib/pages"
import { getMarkdownHref, getPageHref } from "@/lib/pages"
import { getPagePagination } from "@/lib/pagination"
import Base from "@/layouts/base.astro"
import DocBlock from "@/components/blocks/doc-1.astro"

type Props = {
  entry: Page
  context: PageContext
  global: GlobalSchema
  page: DocSchema
  headings: MarkdownHeading[]
}

const props: Props = Astro.props
const globalCallout = props.global.docs?.callout
const markdownUrl = new URL(
  getMarkdownHref(getPageHref(props.entry)),
  Astro.url
).toString()
const { previousPage, nextPage } = await getPagePagination(props.entry)
const copySource = props.entry.body
const copyButton = copySource
  ? {
      id: `docs-copy-page-${crypto.randomUUID()}`,
      source: copySource,
    }
  : undefined

const tocItems = props.headings
  .filter((heading) => heading.depth === 2 || heading.depth === 3)
  .map((heading) => ({
    depth: heading.depth,
    href: `#${heading.slug}`,
    label: heading.text,
  }))
---

<Base {...props}>
  <DocBlock
    title={props.page.title}
    description={props.page.description}
    copyButton={copyButton}
    markdownUrl={markdownUrl}
    tocItems={tocItems}
    callout={globalCallout}
    previousPage={previousPage}
    nextPage={nextPage}
    labels={props.global.labels}
  >
    <slot />
  </DocBlock>
</Base>
