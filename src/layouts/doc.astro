---
import type { MarkdownHeading } from "astro"

import type { GlobalSchema } from "@/schemas/global"
import { getPagePagination } from "@/lib/docs"
import { getMarkdownHref, getPageHref, type Page } from "@/lib/pages"
import Base from "@/layouts/base.astro"
import DocBlock from "@/components/blocks/doc-1.astro"

type Props = {
  page: Page
  global: GlobalSchema
  headings: MarkdownHeading[]
}

const { page, global, headings } = Astro.props
const markdownUrl = new URL(getMarkdownHref(getPageHref(page)), Astro.url).href
const { previousPage, nextPage } = await getPagePagination(
  page,
  global.sidebar.navigation
)
const copyButton = page.body
  ? { id: `docs-copy-page-${crypto.randomUUID()}`, source: page.body }
  : undefined

const tocItems = headings
  .filter((heading) => heading.depth === 2 || heading.depth === 3)
  .map((heading) => ({
    depth: heading.depth,
    href: `#${heading.slug}`,
    label: heading.text,
  }))
---

<Base page={page} global={global}>
  <DocBlock
    title={page.data.title}
    description={page.data.description}
    copyButton={copyButton}
    markdownUrl={markdownUrl}
    tocItems={tocItems}
    callout={global.docs?.callout}
    previousPage={previousPage}
    nextPage={nextPage}
    labels={global.labels}
  >
    <slot />
  </DocBlock>
</Base>
