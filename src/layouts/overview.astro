---
import { getCollection } from "astro:content"

import type { GlobalSchema } from "@/schemas/global"
import type { OverviewSchema } from "@/schemas/layouts/overview"
import { getFramework, getPageId, getReadingOrder } from "@/lib/pages"
import Base from "@/layouts/base.astro"
import { SectionContainer } from "@/components/ui/section"
import { TypographyH1, TypographyLead } from "@/components/ui/typography"

type Props = {
  global: GlobalSchema
  page: OverviewSchema
}

const { global, page }: Props = Astro.props
const pageId = getPageId(Astro.url.pathname)
const [framework, section] = pageId.split("/")
const pages = await getCollection("pages")

// An edition's index lists its sections; a section lists its pages.
const entries = section
  ? section === "docs"
    ? (await getReadingOrder(getFramework(pageId)))
        .filter((link) => link.href.startsWith(`/${pageId}/`))
        .map((link) => pages.find((entry) => `/${entry.id}/` === link.href))
        .filter((entry): entry is (typeof pages)[number] => Boolean(entry))
    : pages
        .filter(({ id }) => id.startsWith(`${pageId}/`))
        .sort((a, b) => a.data.title.localeCompare(b.data.title))
  : ["docs", "components", "blocks"]
      .map((name) => pages.find((entry) => entry.id === `${framework}/${name}`))
      .filter((entry): entry is (typeof pages)[number] => Boolean(entry))

const overviewLinks = entries.map((entry) => ({
  href: `/${entry.id}/`,
  title: entry.data.title,
  description: entry.data.description,
}))
---

<Base global={global} page={page}>
  <SectionContainer class="flex flex-col gap-10 pt-10 pb-10 sm:pt-12 sm:pb-12">
    <div class="mx-auto flex w-full max-w-[84rem] flex-col gap-10">
      <header class="flex min-w-0 flex-col gap-4 border-b pb-8">
        <TypographyH1 class="text-foreground text-left text-3xl tracking-tight sm:text-4xl">
          {page.title}
        </TypographyH1>
        {page.description && (
          <TypographyLead class="max-w-2xl text-base leading-7">
            {page.description}
          </TypographyLead>
        )}
      </header>

      <p
        data-missing-page
        hidden
        role="status"
        class="bg-muted/60 rounded-lg px-4 py-3 text-sm"
      ></p>

      <section class="grid gap-2 md:grid-cols-2 xl:grid-cols-3">
        {overviewLinks.map((item) => (
          <a
            href={item.href}
            class="bg-muted/40 hover:bg-muted/60 focus-visible:ring-ring/50 rounded-lg px-4 py-4 transition-colors focus-visible:ring-2 focus-visible:outline-none"
          >
            <span class="text-sm font-medium">{item.title}</span>
            {item.description && (
              <span class="text-muted-foreground mt-1 block text-sm leading-5">
                {item.description}
              </span>
            )}
          </a>
        ))}
      </section>
    </div>
  </SectionContainer>
</Base>

<script>
  // Another edition links here when it has a page this one lacks.
  const missing = new URLSearchParams(location.search).get("missing")
  const note = document.querySelector<HTMLElement>("[data-missing-page]")
  if (missing && note) {
    const title = missing
      .split("-")
      .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
      .join(" ")
    note.textContent = `${title} is not in this edition yet. These are the pages it has.`
    note.hidden = false
  }
</script>

<script is:inline>
  // Links to the former React gallery, such as /react/#/ui/button.
  if (location.pathname === "/react/" && location.hash.startsWith("#/")) {
    const [kind, name] = location.hash.slice(2).split("?")[0].split("/")
    if (kind === "ui" && name) location.replace(`/react/components/${name}/`)
    if (kind === "blocks" && name)
      location.replace(`/react/blocks/${name.replace(/-\d+$/, "")}/#${name}`)
  }
</script>
