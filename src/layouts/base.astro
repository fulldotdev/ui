---
import { Font } from "astro:assets"
import { siteConfig } from "@/site.config"

import type { GlobalSchema } from "@/schemas/global"
import type { BaseSchema } from "@/schemas/layouts/base"
import type { Page, PageContext } from "@/lib/pages"
import { getPageSearchItems } from "@/lib/pages"
import { getStructuredData } from "@/lib/seo"
import Sidebar1 from "@/components/blocks/sidebar-1.astro"
import {
  Layout,
  LayoutBody,
  LayoutHead,
  LayoutMain,
} from "@/components/ui/layout"
import { ThemeProvider } from "@/components/ui/theme-toggle"

type Props = {
  entry: Page
  context: PageContext
  global: GlobalSchema
  page: BaseSchema
}

const { global, page, entry, context }: Props = Astro.props

const searchItems = await getPageSearchItems(context.locale)
const structuredData = getStructuredData(
  entry,
  context,
  siteConfig,
  global.organization
)
---

<Layout lang={context.locale}>
  <LayoutHead
    name={global.name}
    title={page.title}
    description={page.description}
    image={page.image}
    {...page.seo}
    alternates={context.alternates}
    structuredData={structuredData}
  >
    <Font cssVariable="--font-sans" />
    <Font cssVariable="--font-mono" />
    <ThemeProvider />
  </LayoutHead>
  <LayoutBody>
    <Sidebar1
      logo={global.logo}
      search={{
        items: searchItems,
        ...global.sidebar.search,
      }}
      breadcrumb={{
        items: context.breadcrumbs,
        menu: global.header.navigation,
      }}
      navigation={global.sidebar.navigation}
      githubRepo={global.header.githubRepo}
    >
      <LayoutMain>
        <slot />
      </LayoutMain>
    </Sidebar1>
  </LayoutBody>
</Layout>
