---
import { Font } from "astro:assets"

import type { GlobalSchema } from "@/schemas/global"
import type { BaseSchema } from "@/schemas/layouts/base"
import {
  frameworks,
  getCounterpartHref,
  getFramework,
  getNavigation,
  getPageBreadcrumbItems,
  getPageId,
  getPageSearchItems,
  getSectionMenu,
} from "@/lib/pages"
import Sidebar1 from "@/components/blocks/sidebar-1.astro"
import { Layout, LayoutBody, LayoutHead } from "@/components/ui/layout"
import { ThemeProvider } from "@/components/ui/theme-toggle"
import FrameworkSelect from "@/components/framework-select.astro"
import Posthog from "@/components/posthog.astro"
import PresetHead from "@/components/preset-head.astro"
import socialImage from "@/assets/social.png"

type Props = {
  global: GlobalSchema
  page: BaseSchema
}

const { global, page }: Props = Astro.props

const pageId = getPageId(Astro.url.pathname)
const framework = getFramework(pageId)
const [searchItems, breadcrumbItems, navigation, ...counterparts] =
  await Promise.all([
    getPageSearchItems(framework),
    getPageBreadcrumbItems(Astro.url.pathname),
    getNavigation(framework),
    ...frameworks.map((target) =>
      target === framework
        ? Astro.url.pathname
        : getCounterpartHref(pageId, target)
    ),
  ])
const frameworkHrefs = Object.fromEntries(
  frameworks.map((target, index) => [target, counterparts[index]])
) as Record<(typeof frameworks)[number], string>

let githubStars: number | undefined

try {
  const response = await fetch(
    `https://api.github.com/repos/${global.header.githubRepo}`
  )
  const data = await response.json()

  if (response.ok && typeof data.stargazers_count === "number") {
    githubStars = data.stargazers_count
  }
} catch {
  // Leave the stars unset so Sidebar1 shows its fallback label.
}
---

<Layout>
  <LayoutHead
    {...global}
    {...page}
    {...page.seo}
    image={
      page.seo?.image || page.image || { src: socialImage, alt: "Fulldev UI" }
    }
  >
    <Font cssVariable="--font-sans" />
    <Font cssVariable="--font-mono" />
    <ThemeProvider />
    <PresetHead />
    <Posthog />
  </LayoutHead>
  <LayoutBody>
    <Sidebar1
      currentPath={Astro.url.pathname}
      logo={global.logo}
      search={{
        items: searchItems,
        ...global.sidebar.search,
      }}
      breadcrumb={{
        items: breadcrumbItems,
        menu: getSectionMenu(framework),
      }}
      navigation={navigation}
      githubRepo={global.header.githubRepo}
      githubStars={githubStars}
      labels={{
        sidebar: "Documentation",
        github: `View ${global.header.githubRepo} on GitHub`,
        stars: "Stars",
        breadcrumb: "Breadcrumb",
        breadcrumbMenu: "Toggle menu",
        sidebarToggle: "Toggle Sidebar",
        mobileTitle: "Sidebar",
        mobileDescription: "Displays the mobile sidebar.",
        theme: "Toggle theme",
        shortcut: { mac: "⌘ + K", other: "Ctrl + K" },
      }}
    >
      <FrameworkSelect
        slot="header"
        current={framework}
        hrefs={frameworkHrefs}
      />
      {/* SidebarInset already renders the page's main element. */}
      <div class="@container flex flex-col rounded-[inherit]">
        <slot />
      </div>
    </Sidebar1>
  </LayoutBody>
</Layout>
