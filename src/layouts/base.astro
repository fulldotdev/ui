---
import { Font } from "astro:assets"

import type { GlobalSchema } from "@/schemas/global"
import type { BaseSchema } from "@/schemas/layouts/base"
import { getGithubStars } from "@/lib/github"
import {
  frameworks,
  getCounterpartHref,
  getFramework,
  getLiquidNavigation,
  getPageId,
  getPageSearchItems,
  getPageSeo,
  getReactNavigation,
} from "@/lib/pages"
import {
  Layout,
  LayoutBody,
  LayoutHead,
  LayoutMain,
} from "@/components/ui/layout"
import { ThemeProvider } from "@/components/ui/theme-toggle"
import DocsHeader from "@/components/docs-header.astro"
import DocsNav from "@/components/docs-nav.astro"
import DocsSearch from "@/components/docs-search.astro"
import DocsSwitcher from "@/components/docs-switcher.astro"
import Posthog from "@/components/posthog.astro"
import PresetHead from "@/components/preset-head.astro"
import socialImage from "@/assets/social.png"

type Props = {
  global: GlobalSchema
  page: BaseSchema
}

const { global, page }: Props = Astro.props

const pageId = getPageId(Astro.url.pathname)
const framework = getFramework(pageId)
// The homepage and the create page span the full width; the create page has
// its own sidebar.
const withSidebar = pageId !== "index" && pageId !== "create"
const [searchItems, navigation, ...counterparts] = await Promise.all([
  getPageSearchItems(framework),
  framework === "react"
    ? getReactNavigation()
    : framework === "liquid"
      ? getLiquidNavigation()
      : global.sidebar.navigation,
  ...frameworks.map((target) =>
    target === framework
      ? Astro.url.pathname
      : getCounterpartHref(pageId, target)
  ),
])
const frameworkHrefs = Object.fromEntries(
  frameworks.map((target, index) => [target, counterparts[index]])
) as Record<(typeof frameworks)[number], string>

// Docs, Components and Blocks lead to the library of the current page.
const headerNavigation = await Promise.all(
  global.header.navigation
    .filter(
      (item) =>
        framework !== "liquid" || !["/blocks/", "/create/"].includes(item.href)
    )
    .map(async (item) => {
      const id = getPageId(item.href)
      const react = await getCounterpartHref(id, "react")
      const reactHref = react === `/react/${id}/` ? react : undefined
      const liquidHref = await getCounterpartHref(id, "liquid")
      return {
        ...item,
        href:
          framework === "liquid" && ["docs", "components"].includes(id)
            ? liquidHref
            : framework === "react" && reactHref
              ? reactHref
              : item.href,
        reactHref,
        liquidHref: ["docs", "components"].includes(id)
          ? liquidHref
          : undefined,
      }
    })
)

const stars = await getGithubStars(global.header.githubRepo)
const githubStars =
  stars === undefined ? undefined : new Intl.NumberFormat("en").format(stars)

const seo = getPageSeo(pageId, {
  title: page.seo?.title ?? page.title,
  description: page.seo?.description ?? page.description,
})

// The homepage tells search engines what the site is and who publishes it.
const websiteData = pageId === "index" && {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Fulldev UI",
  url: new URL("/", Astro.site ?? Astro.url).toString(),
  publisher: {
    "@type": "Organization",
    name: "Fulldev",
    url: "https://full.dev",
  },
}

const switcherLabels = {
  framework: "Framework",
  preset: "Preset",
  custom: "Your preset",
  create: "Create a preset",
}
---

<Layout>
  <LayoutHead
    {...global}
    {...page}
    {...page.seo}
    {...seo}
    image={
      page.seo?.image || page.image || { src: socialImage, alt: "Fulldev UI" }
    }
  >
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" />
    <ThemeProvider />
    <PresetHead />
    <Posthog />
    {websiteData && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(websiteData)}
      />
    )}
  </LayoutHead>
  <LayoutBody
    data-framework-neutral={
      pageId === "index" || pageId === "create" ? "" : undefined
    }
  >
    <DocsHeader
      logo={global.logo}
      navigation={headerNavigation}
      button={global.header.button}
      githubRepo={global.header.githubRepo}
      githubStars={githubStars}
      labels={{
        navigation: "Main navigation",
        menu: "Open menu",
        menuTitle: "Menu",
        github: `View ${global.header.githubRepo} on GitHub`,
        theme: "Toggle theme",
      }}
    >
      <DocsSearch
        slot="search"
        label={global.sidebar.search.label}
        empty={global.sidebar.search.empty}
        items={searchItems}
      />
      {withSidebar && (
        <div slot="menu" class="flex flex-col gap-6">
          <DocsSwitcher
            current={framework}
            hrefs={frameworkHrefs}
            labels={switcherLabels}
          />
          <DocsNav
            currentPath={Astro.url.pathname}
            navigation={navigation}
            label="Documentation menu"
          />
        </div>
      )}
    </DocsHeader>
    {withSidebar ? (
      <div class="flex flex-1 flex-col px-4 lg:px-6">
        <div class="lg:grid lg:grid-cols-[16.5rem_minmax(0,1fr)]">
          <aside class="sticky top-20 -ml-2 hidden h-[calc(100svh-6rem)] overflow-y-auto pl-2 [scrollbar-width:none] lg:block">
            <div class="flex w-56 flex-col gap-6 pb-8">
              <DocsSwitcher
                current={framework}
                hrefs={frameworkHrefs}
                labels={switcherLabels}
              />
              <DocsNav
                currentPath={Astro.url.pathname}
                navigation={navigation}
                label="Documentation"
              />
            </div>
          </aside>
          <LayoutMain id="main" class="min-w-0">
            <slot />
          </LayoutMain>
        </div>
      </div>
    ) : (
      <LayoutMain id="main">
        <slot />
      </LayoutMain>
    )}
  </LayoutBody>
</Layout>

<script>
  // The whole site follows the stored preset; see src/lib/preset-store.ts.
  import {
    applyPreset,
    FRAMEWORK_EVENT,
    FRAMEWORK_KEY,
    readPreset,
    writeFramework,
  } from "@/lib/preset-store"

  applyPreset(readPreset())

  // On a page of both libraries, the homepage and Create, links lead to the
  // library chosen last, in the switcher, on the homepage or on Create.
  const followFramework = () => {
    if (!document.body.hasAttribute("data-framework-neutral")) return
    const framework = localStorage.getItem(FRAMEWORK_KEY) ?? "astro"
    document
      .querySelectorAll<HTMLAnchorElement>(
        "a[data-react-href], a[data-liquid-href]"
      )
      .forEach((link) => {
        link.dataset.astroHref ??= link.getAttribute("href") ?? ""
        const href =
          framework === "liquid"
            ? link.dataset.liquidHref
            : framework === "react"
              ? link.dataset.reactHref
              : link.dataset.astroHref
        if (href) link.setAttribute("href", href)
      })
  }
  followFramework()
  document.addEventListener(FRAMEWORK_EVENT, followFramework)
  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return
    const choice = event.target.closest<HTMLElement>("[data-framework-choice]")
      ?.dataset.frameworkChoice
    if (choice) writeFramework(choice)
  })
</script>
