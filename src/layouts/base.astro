---
import { Font } from "astro:assets"

import type { GlobalSchema } from "@/schemas/global"
import type { BaseSchema } from "@/schemas/layouts/base"
import {
  getBlockCategoryLinks,
  getComponentLinks,
  getPageBreadcrumbItems,
  getPageSearchItems,
} from "@/lib/pages"
import Sidebar1 from "@/components/blocks/sidebar-1.astro"
import {
  Layout,
  LayoutBody,
  LayoutHead,
  LayoutMain,
} from "@/components/ui/layout"
import { ThemeProvider } from "@/components/ui/theme-toggle"
import ogImage from "@/assets/og-image.png"

type Props = {
  global: GlobalSchema
  page: BaseSchema
}

const { global, page }: Props = Astro.props

const [searchItems, breadcrumbItems, componentLinks, blockLinks] =
  await Promise.all([
    getPageSearchItems(),
    getPageBreadcrumbItems(Astro.url.pathname),
    getComponentLinks(),
    getBlockCategoryLinks(),
  ])

const navigation = [
  ...global.sidebar.navigation,
  {
    label: "Components",
    href: "/components/",
    links: componentLinks.map(({ title, href }) => ({ label: title, href })),
  },
  {
    label: "Blocks",
    href: "/blocks/",
    links: blockLinks.map(({ title, href }) => ({ label: title, href })),
  },
]

const image = page.image ?? { src: ogImage, alt: page.title }
---

<Layout>
  <LayoutHead {...global} {...page} image={image} {...page.seo}>
    <Fragment slot="head">
      <Font
        cssVariable="--font-geist-sans"
        preload={[{ subset: "latin", weight: "100 900", style: "normal" }]}
      />
      <Font cssVariable="--font-geist-mono" />
    </Fragment>
    <ThemeProvider />
  </LayoutHead>
  <LayoutBody>
    <Sidebar1
      logo={global.logo}
      search={{
        items: searchItems,
        ...global.sidebar.search,
      }}
      breadcrumb={{
        items: breadcrumbItems,
        menu: global.header.navigation,
      }}
      navigation={navigation}
      githubRepo={global.header.githubRepo}
      githubStars={global.header.githubStars}
    >
      <LayoutMain>
        <slot />
      </LayoutMain>
    </Sidebar1>
  </LayoutBody>
</Layout>
