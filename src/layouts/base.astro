---
import { Font } from "astro:assets"

import type { GlobalSchema } from "@/schemas/global"
import type { BaseSchema } from "@/schemas/layouts/base"
import { getPageBreadcrumbItems, getPageSearchItems } from "@/lib/pages"
import Sidebar1 from "@/components/blocks/sidebar-1.astro"
import { Layout, LayoutBody, LayoutHead } from "@/components/ui/layout"
import { ThemeProvider } from "@/components/ui/theme-toggle"
import Posthog from "@/components/posthog.astro"
import PresetHead from "@/components/preset-head.astro"
import socialImage from "@/assets/social.png"

type Props = {
  global: GlobalSchema
  page: BaseSchema
}

const { global, page }: Props = Astro.props

const [searchItems, breadcrumbItems] = await Promise.all([
  getPageSearchItems(),
  getPageBreadcrumbItems(Astro.url.pathname),
])

let githubStars: number | undefined

try {
  const response = await fetch(
    `https://api.github.com/repos/${global.header.githubRepo}`
  )
  const data = await response.json()

  if (response.ok && typeof data.stargazers_count === "number") {
    githubStars = data.stargazers_count
  }
} catch {
  // Leave the stars unset so Sidebar1 shows its fallback label.
}
---

<Layout>
  <LayoutHead
    {...global}
    {...page}
    {...page.seo}
    image={
      page.seo?.image || page.image || { src: socialImage, alt: "Fulldev UI" }
    }
  >
    <Font cssVariable="--font-sans" />
    <Font cssVariable="--font-mono" />
    <ThemeProvider />
    <PresetHead />
    <Posthog />
  </LayoutHead>
  <LayoutBody>
    <Sidebar1
      logo={global.logo}
      search={{
        items: searchItems,
        ...global.sidebar.search,
      }}
      breadcrumb={{
        items: breadcrumbItems,
        menu: global.header.navigation,
      }}
      navigation={global.sidebar.navigation}
      githubRepo={global.header.githubRepo}
      githubStars={githubStars}
      labels={{
        github: `View ${global.header.githubRepo} on GitHub`,
        stars: "Stars",
        breadcrumb: "Breadcrumb",
        breadcrumbMenu: "Toggle menu",
        sidebar: "Toggle Sidebar",
        theme: "Toggle theme",
        shortcut: { mac: "⌘ + K", other: "Ctrl + K" },
      }}
    >
      {/* SidebarInset already renders the page's main element. */}
      <div class="@container flex flex-col rounded-[inherit]">
        <slot />
      </div>
    </Sidebar1>
  </LayoutBody>
</Layout>
