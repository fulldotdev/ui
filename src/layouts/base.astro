---
import { Font } from "astro:assets"

import type { GlobalSchema } from "@/schemas/global"
import { getPageSearchItems } from "@/lib/docs"
import {
  getPageBreadcrumbs,
  getPageLocale,
  getPages,
  getPageUrl,
  type Page,
} from "@/lib/pages"
import { getStructuredData } from "@/lib/seo"
import Sidebar1 from "@/components/blocks/sidebar-1.astro"
import {
  Layout,
  LayoutBody,
  LayoutHead,
  LayoutMain,
} from "@/components/ui/layout"
import { ThemeProvider } from "@/components/ui/theme-toggle"

type Props = {
  page: Page
  global: GlobalSchema
}

const { page, global } = Astro.props
const pages = await getPages()
const locale = getPageLocale(page)
const breadcrumbs = getPageBreadcrumbs(pages, page)
const searchItems = await getPageSearchItems(locale)
---

<Layout lang={locale}>
  <LayoutHead
    name={global.name}
    title={page.data.title}
    description={page.data.description}
    image={page.data.image}
    {...page.data.seo}
    canonical={page.data.seo?.canonical ?? getPageUrl(page)}
    structuredData={getStructuredData(page, {
      name: global.name,
      locale,
      breadcrumbs,
    })}
  >
    <Font cssVariable="--font-sans" />
    <Font cssVariable="--font-mono" />
    <ThemeProvider />
  </LayoutHead>
  <LayoutBody>
    <Sidebar1
      logo={global.logo}
      search={{
        items: searchItems,
        ...global.sidebar.search,
      }}
      breadcrumb={{
        items: breadcrumbs,
        menu: global.header.navigation,
      }}
      navigation={global.sidebar.navigation}
      githubRepo={global.header.githubRepo}
    >
      <LayoutMain>
        <slot />
      </LayoutMain>
    </Sidebar1>
  </LayoutBody>
</Layout>
