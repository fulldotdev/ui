---
import type { GlobalSchema } from "@/schemas/global"
import type { CreateSchema } from "@/schemas/layouts/create"
import Base from "@/layouts/base.astro"
import { Typography } from "@/components/ui/typography"
import Create from "@/components/create.astro"

type Props = {
  global: GlobalSchema
  page: CreateSchema
}

const { global, page }: Props = Astro.props
---

<Base global={global} page={page}>
  <div class="mx-auto flex w-full max-w-7xl flex-col gap-8 px-4 py-8 @3xl:px-8">
    <div class="flex max-w-2xl flex-col gap-2">
      <h1 class="text-3xl font-semibold tracking-tight">{page.title}</h1>
      <p class="text-muted-foreground text-lg">{page.description}</p>
    </div>
    <Create />
    <Typography class="max-w-2xl">
      <slot />
    </Typography>
  </div>
</Base>
