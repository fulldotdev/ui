---
import type { MarkdownHeading } from "astro"
import { getCollection } from "astro:content"

import type { GlobalSchema } from "@/schemas/global"
import type { BlockSchema } from "@/schemas/layouts/block"
import { getPageMarkdown } from "@/lib/markdown"
import { getFramework, getPageId } from "@/lib/pages"
import Base from "@/layouts/base.astro"
import BlocksBlock from "@/components/blocks/blocks-1.astro"

type Props = {
  global: GlobalSchema
  page: BlockSchema
  headings: MarkdownHeading[]
}

const props: Props = Astro.props
const currentPath = Astro.url.pathname
const markdownPath =
  currentPath === "/" ? "/index.md" : `${currentPath.replace(/\/$/, "")}.md`
const markdownUrl = new URL(markdownPath, Astro.site ?? Astro.url).toString()

const blockPages = await getCollection("pages", ({ data }) => {
  return data.type === "block"
})
const orderedBlockLinks = blockPages
  .filter(
    (entry) => getFramework(entry.id) === getFramework(getPageId(currentPath))
  )
  .map((entry) => ({
    href: `/${entry.id}/`,
    title: entry.data.title,
  }))
  .sort((a, b) => a.title.localeCompare(b.title))
const currentPageIndex = orderedBlockLinks.findIndex(
  (item) => item.href === currentPath
)
const previousPage =
  currentPageIndex > 0 ? orderedBlockLinks[currentPageIndex - 1] : undefined
const nextPage =
  currentPageIndex >= 0 ? orderedBlockLinks[currentPageIndex + 1] : undefined
const currentBlock = blockPages.find((entry) => `/${entry.id}/` === currentPath)
const copySource = currentBlock && (await getPageMarkdown(currentBlock))
const copyButton = copySource
  ? {
      id: `blocks-copy-page-${crypto.randomUUID()}`,
      source: copySource,
    }
  : undefined
---

<Base global={props.global} page={props.page}>
  <BlocksBlock
    title={props.page.title}
    description={props.page.description}
    copyButton={copyButton}
    markdownUrl={markdownUrl}
    previousPage={previousPage}
    nextPage={nextPage}
    labels={{
      copyMarkdown: "Copy Markdown",
      openIn: "Open in",
      openInMarkdown: "Open in Markdown",
      openInChatGPT: "Open in ChatGPT",
      openInClaude: "Open in Claude",
      openInCursor: "Open in Cursor",
      assistantPrompt: `Read ${markdownUrl}, I want to ask questions about it.`,
      pagination: "Blocks pagination",
    }}
  >
    <slot />
  </BlocksBlock>
</Base>
