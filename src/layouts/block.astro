---
import type { GlobalSchema } from "@/schemas/global"
import { getPagePagination } from "@/lib/docs"
import { getMarkdownHref, getPageHref, type Page } from "@/lib/pages"
import Base from "@/layouts/base.astro"
import BlocksBlock from "@/components/blocks/blocks-1.astro"

type Props = {
  page: Page
  global: GlobalSchema
}

const { page, global } = Astro.props
const markdownUrl = new URL(getMarkdownHref(getPageHref(page)), Astro.url).href
const { previousPage, nextPage } = await getPagePagination(
  page,
  global.sidebar.navigation
)
const copyButton = page.body
  ? { id: `blocks-copy-page-${crypto.randomUUID()}`, source: page.body }
  : undefined
---

<Base page={page} global={global}>
  <BlocksBlock
    title={page.data.title}
    description={page.data.description}
    copyButton={copyButton}
    markdownUrl={markdownUrl}
    previousPage={previousPage}
    nextPage={nextPage}
    labels={global.labels}
  >
    <slot />
  </BlocksBlock>
</Base>
