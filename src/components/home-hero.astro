---
// Docs only: the homepage hero. The framework names in the title show with
// their logos, and the tiles show real blocks and components in the current
// preset.
import type { HomeSchema } from "@/schemas/layouts/home"
import Features2 from "@/components/blocks/features-2.astro"
import Pricing1 from "@/components/blocks/pricing-1.astro"
import { Button } from "@/components/ui/button"
import CreatePreview from "@/components/create-preview.astro"
import FrameworkLogo from "@/components/framework-logo.astro"

type Props = HomeSchema["hero"] & {
  counts: { blocks: number; components: number }
  // The same pages in React by href, for the visitor who chose React last.
  reactHrefs: Record<string, string | undefined>
}

const {
  title,
  description,
  buttons,
  frameworks,
  blocks,
  components,
  presets,
  counts,
  reactHrefs,
} = Astro.props

// The title in parts, with each framework name as its own part.
const names = frameworks.map((framework) => framework.label)
const parts = title
  .split(new RegExp(`(${names.join("|")})`))
  .filter(Boolean)
  .map((text) => ({
    text,
    framework: frameworks.find((framework) => framework.label === text),
  }))

// Sample content for the blocks tile.
const sample = {
  features: {
    title: "Why teams choose us",
    description: "Three reasons in one block.",
    features: [
      {
        icon: "pencil",
        title: "Easy to edit",
        description: "Text and images live in content files.",
      },
      {
        icon: "zap",
        title: "Fast by default",
        description: "Static pages, scripts only where needed.",
      },
      {
        icon: "search",
        title: "Found in search",
        description: "Metadata and structured data built in.",
      },
    ],
  },
  pricing: {
    title: "Simple pricing",
    description: "Pick the plan that fits.",
    featuredLabel: "Popular",
    plans: [
      {
        name: "Starter",
        description: "For a small site.",
        price: { value: 19, currency: "USD", unit: "month" },
        features: ["5 pages", "Contact form"],
        button: { label: "Choose", href: "/blocks/pricing/" },
      },
      {
        name: "Business",
        description: "For a growing site.",
        price: { value: 49, currency: "USD", unit: "month" },
        featured: true,
        features: ["Unlimited pages", "Blog", "Analytics"],
        button: { label: "Choose", href: "/blocks/pricing/" },
      },
      {
        name: "Agency",
        description: "For many sites.",
        price: { value: 99, currency: "USD", unit: "month" },
        features: ["Everything in Business", "Priority support"],
        button: { label: "Choose", href: "/blocks/pricing/" },
      },
    ],
  },
}
---

<section class="mx-auto flex w-full max-w-6xl flex-col items-center px-4 pt-16 pb-8 text-center lg:px-6 lg:pt-24">
  <h1 class="max-w-4xl text-4xl leading-[1.15] font-semibold tracking-tight text-balance sm:text-5xl lg:text-6xl">
    {parts.map(({ text, framework }) =>
      framework ? (
        <span class="bg-muted mx-[0.1em] inline-flex h-[1.05em] translate-y-[-0.06em] items-center gap-[0.22em] rounded-[0.25em] px-[0.25em] align-middle text-[0.8em]">
          <FrameworkLogo name={framework.name} class="size-[0.75em]" />
          {text}
        </span>
      ) : (
        text
      )
    )}
  </h1>
  <p class="text-muted-foreground mt-6 max-w-2xl text-lg text-balance">
    {description}
  </p>
  <div class="mt-8 flex flex-wrap justify-center gap-2">
    {buttons.map((button, index) => (
      <Button
        as="a"
        href={button.href}
        data-react-href={reactHrefs[button.href]}
        variant={index === 0 ? "default" : "outline"}
      >
        {button.label}
      </Button>
    ))}
  </div>
  <div class="mt-14 grid w-full grid-cols-6 gap-4 text-left">
    <div class="bg-background relative col-span-6 flex flex-col overflow-hidden rounded-xl border lg:col-span-4">
      <div class="flex items-baseline justify-between gap-4 px-5 pt-4 pb-3">
        <a
          href={blocks.href}
          data-react-href={reactHrefs[blocks.href]}
          class="shrink-0 font-medium after:absolute after:inset-0"
        >
          {counts.blocks} {blocks.label}
        </a>
        <span class="text-muted-foreground hidden truncate text-sm sm:block">
          {blocks.description}
        </span>
      </div>
      <div class="h-[330px] overflow-hidden border-t">
        <div
          class="w-[1280px] [zoom:0.26] sm:[zoom:0.46] md:[zoom:0.56] lg:[zoom:0.5] xl:[zoom:0.53]"
          inert
        >
          <Features2 {...sample.features} />
          <Pricing1 {...sample.pricing} />
        </div>
      </div>
    </div>
    <div class="bg-muted/40 relative col-span-6 flex flex-col overflow-hidden rounded-xl border lg:col-span-2">
      <div class="flex items-baseline justify-between gap-4 px-5 pt-4 pb-3">
        <a
          href={components.href}
          data-react-href={reactHrefs[components.href]}
          class="font-medium after:absolute after:inset-0"
        >
          {counts.components} {components.label}
        </a>
      </div>
      <div class="h-[330px] overflow-hidden border-t p-4">
        <div
          class="@container w-[560px] [zoom:0.58] lg:[zoom:0.5] xl:[zoom:0.6]"
          inert
        >
          <CreatePreview />
        </div>
      </div>
    </div>
    {frameworks.map((framework) => (
      <a
        href={framework.href}
        class="hover:bg-muted/50 col-span-6 flex items-center gap-4 rounded-xl border p-5 transition-colors sm:col-span-3 lg:col-span-2"
      >
        <FrameworkLogo name={framework.name} class="size-7" />
        <span class="flex flex-col">
          <span class="font-medium">{framework.label}</span>
          <span class="text-muted-foreground text-sm">
            {framework.description}
          </span>
        </span>
      </a>
    ))}
    <a
      href={presets.href}
      class="hover:bg-muted/50 col-span-6 flex items-center gap-4 rounded-xl border p-5 transition-colors lg:col-span-2"
    >
      <span class="flex shrink-0 -space-x-1.5">
        <span class="border-background bg-primary size-6 rounded-full border-2" />
        <span class="border-background bg-foreground size-6 rounded-full border-2" />
        <span class="border-background bg-muted size-6 rounded-full border-2" />
      </span>
      <span class="flex flex-col">
        <span class="font-medium">{presets.label}</span>
        <span class="text-muted-foreground text-sm">{presets.description}</span>
      </span>
    </a>
  </div>
</section>
