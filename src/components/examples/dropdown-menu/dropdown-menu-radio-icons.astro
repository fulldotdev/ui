---
import BuildingComplexIcon from "@lucide/astro/icons/building-complex"
import CreditCardIcon from "@lucide/astro/icons/credit-card"
import WalletIcon from "@lucide/astro/icons/wallet"

import { buttonVariants } from "@/components/ui/button"
import {
  DropdownMenu,
  DropdownMenuContent,
  DropdownMenuGroup,
  DropdownMenuLabel,
  DropdownMenuRadioItem,
  DropdownMenuTrigger,
} from "@/components/ui/dropdown-menu"
---

<DropdownMenu defaultValue="card" closeOnSelect={false}>
  <DropdownMenuTrigger class={buttonVariants({ variant: "outline" })}>
    Payment Method
  </DropdownMenuTrigger>
  <DropdownMenuContent class="min-w-56">
    <DropdownMenuGroup>
      <DropdownMenuLabel>Select Payment Method</DropdownMenuLabel>
      <DropdownMenuRadioItem value="card">
        <CreditCardIcon />
        Credit Card
      </DropdownMenuRadioItem>
      <DropdownMenuRadioItem value="paypal">
        <WalletIcon />
        PayPal
      </DropdownMenuRadioItem>
      <DropdownMenuRadioItem value="bank">
        <BuildingComplexIcon />
        Bank Transfer
      </DropdownMenuRadioItem>
    </DropdownMenuGroup>
  </DropdownMenuContent>
</DropdownMenu>
