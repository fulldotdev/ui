---
import { ToggleGroup, ToggleGroupItem } from "@/components/ui/toggle-group"

const translations = {
  en: {
    dir: "ltr",
    values: {
      list: "List",
      grid: "Grid",
      cards: "Cards",
    },
  },
  ar: {
    dir: "rtl",
    values: {
      list: "قائمة",
      grid: "شبكة",
      cards: "بطاقات",
    },
  },
  he: {
    dir: "rtl",
    values: {
      list: "רשימה",
      grid: "רשת",
      cards: "כרטיסים",
    },
  },
} as const

const { dir, values: t } = translations.ar
---

<ToggleGroup variant="outline" defaultValue={["list"]} dir={dir}>
  <ToggleGroupItem value="list" aria-label={t.list}>
    {t.list}
  </ToggleGroupItem>
  <ToggleGroupItem value="grid" aria-label={t.grid}>
    {t.grid}
  </ToggleGroupItem>
  <ToggleGroupItem value="cards" aria-label={t.cards}>
    {t.cards}
  </ToggleGroupItem>
</ToggleGroup>
