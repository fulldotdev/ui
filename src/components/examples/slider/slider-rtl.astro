---
import { Slider } from "@/components/ui/slider"

const translations = {
  en: {
    dir: "ltr",
    values: {},
  },
  ar: {
    dir: "rtl",
    values: {},
  },
  he: {
    dir: "rtl",
    values: {},
  },
} as const

const { dir } = translations.ar
---

<Slider
  defaultValue={75}
  max={100}
  step={1}
  class="mx-auto w-full max-w-xs"
  dir={dir}
/>
