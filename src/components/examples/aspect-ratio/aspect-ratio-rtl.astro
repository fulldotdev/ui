---
import { AspectRatio } from "@/components/ui/aspect-ratio"

const translations = {
  en: {
    dir: "ltr",
    values: {
      caption: "Beautiful landscape",
    },
  },
  ar: {
    dir: "rtl",
    values: {
      caption: "منظر طبيعي جميل",
    },
  },
  he: {
    dir: "rtl",
    values: {
      caption: "נוף יפה",
    },
  },
} as const

const { dir, values: t } = translations.ar
---

<figure class="w-full max-w-sm" dir={dir}>
  <AspectRatio ratio={16 / 9} class="bg-muted rounded-lg">
    <img
      src="https://avatar.vercel.sh/shadcn1"
      alt="Photo"
      class="absolute inset-0 size-full rounded-lg object-cover grayscale dark:brightness-20"
    />
  </AspectRatio>
  <figcaption class="text-muted-foreground mt-2 text-center text-sm">
    {t.caption}
  </figcaption>
</figure>
