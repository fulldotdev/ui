---
import ArchiveIcon from "@lucide/astro/icons/archive"
import ArrowLeftIcon from "@lucide/astro/icons/arrow-left"
import CalendarPlusIcon from "@lucide/astro/icons/calendar-plus"
import ClockIcon from "@lucide/astro/icons/clock"
import MoreHorizontalIcon from "@lucide/astro/icons/ellipsis"
import ListFilterIcon from "@lucide/astro/icons/list-filter"
import MailCheckIcon from "@lucide/astro/icons/mail-check"
import TagIcon from "@lucide/astro/icons/tag"
import Trash2Icon from "@lucide/astro/icons/trash"

import { Button, buttonVariants } from "@/components/ui/button"
import { ButtonGroup } from "@/components/ui/button-group"
import {
  DropdownMenu,
  DropdownMenuContent,
  DropdownMenuGroup,
  DropdownMenuItem,
  DropdownMenuLabel,
  DropdownMenuRadioItem,
  DropdownMenuSeparator,
  DropdownMenuTrigger,
} from "@/components/ui/dropdown-menu"
---

<ButtonGroup>
  <ButtonGroup class="hidden sm:flex">
    <Button variant="outline" size="icon" aria-label="Go Back">
      <ArrowLeftIcon />
    </Button>
  </ButtonGroup>
  <ButtonGroup>
    <Button variant="outline">Archive</Button>
    <Button variant="outline">Report</Button>
  </ButtonGroup>
  <ButtonGroup>
    <Button variant="outline">Snooze</Button>
    <DropdownMenu defaultValue="personal">
      <DropdownMenuTrigger
        class={buttonVariants({
          variant: "outline",
          size: "icon",
          class: "rounded-l-none border-l-0",
        })}
        aria-label="More Options"
      >
        <MoreHorizontalIcon />
      </DropdownMenuTrigger>
      <DropdownMenuContent align="end" class="w-40">
        <DropdownMenuGroup>
          <DropdownMenuItem>
            <MailCheckIcon />
            Mark as Read
          </DropdownMenuItem>
          <DropdownMenuItem>
            <ArchiveIcon />
            Archive
          </DropdownMenuItem>
        </DropdownMenuGroup>
        <DropdownMenuSeparator />
        <DropdownMenuGroup>
          <DropdownMenuItem>
            <ClockIcon />
            Snooze
          </DropdownMenuItem>
          <DropdownMenuItem>
            <CalendarPlusIcon />
            Add to Calendar
          </DropdownMenuItem>
          <DropdownMenuItem>
            <ListFilterIcon />
            Add to List
          </DropdownMenuItem>
        </DropdownMenuGroup>
        <DropdownMenuSeparator />
        <DropdownMenuGroup>
          <DropdownMenuLabel class="flex items-center gap-2">
            <TagIcon class="size-4" />
            Label As...
          </DropdownMenuLabel>
          <DropdownMenuRadioItem value="personal">
            Personal
          </DropdownMenuRadioItem>
          <DropdownMenuRadioItem value="work">Work</DropdownMenuRadioItem>
          <DropdownMenuRadioItem value="other">Other</DropdownMenuRadioItem>
        </DropdownMenuGroup>
        <DropdownMenuSeparator />
        <DropdownMenuGroup>
          <DropdownMenuItem variant="destructive">
            <Trash2Icon />
            Trash
          </DropdownMenuItem>
        </DropdownMenuGroup>
      </DropdownMenuContent>
    </DropdownMenu>
  </ButtonGroup>
</ButtonGroup>
