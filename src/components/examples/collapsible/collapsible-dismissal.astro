---
import ChevronDownIcon from "@lucide/astro/icons/chevron-down"

import { buttonVariants } from "@/components/ui/button"
import {
  Collapsible,
  CollapsibleContent,
  CollapsibleTrigger,
} from "@/components/ui/collapsible"
---

<div class="mx-auto flex w-full max-w-xs flex-col gap-4">
  <Collapsible closeOnEscape closeOnClickOutside class="flex flex-col gap-2">
    <CollapsibleTrigger
      class={buttonVariants({ variant: "outline", class: "w-full" })}
    >
      Browse documentation
      <ChevronDownIcon class="ml-auto group-aria-expanded/button:rotate-180" />
    </CollapsibleTrigger>
    <CollapsibleContent>
      <nav aria-label="Documentation example" class="flex flex-col gap-1">
        <a
          href="/docs/installation/"
          class={buttonVariants({ variant: "ghost", class: "justify-start" })}
        >
          Installation
        </a>
        <a
          href="/components/accordion/"
          class={buttonVariants({ variant: "ghost", class: "justify-start" })}
        >
          Accordion
        </a>
        <a
          href="/components/collapsible/"
          class={buttonVariants({ variant: "ghost", class: "justify-start" })}
        >
          Collapsible
        </a>
      </nav>
    </CollapsibleContent>
  </Collapsible>
  <p class="text-muted-foreground text-sm">
    Open the panel, then press Escape or click outside it to close.
  </p>
</div>
