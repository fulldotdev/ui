---
import { buttonVariants } from "@/components/ui/button"
import {
  Popover,
  PopoverContent,
  PopoverTrigger,
} from "@/components/ui/popover"
---

<div class="flex gap-6">
  <Popover>
    <PopoverTrigger class={buttonVariants({ variant: "outline", size: "sm" })}>
      Start
    </PopoverTrigger>
    <PopoverContent align="start" class="w-40">
      Aligned to start
    </PopoverContent>
  </Popover>
  <Popover>
    <PopoverTrigger class={buttonVariants({ variant: "outline", size: "sm" })}>
      Center
    </PopoverTrigger>
    <PopoverContent align="center" class="w-40">
      Aligned to center
    </PopoverContent>
  </Popover>
  <Popover>
    <PopoverTrigger class={buttonVariants({ variant: "outline", size: "sm" })}>
      End
    </PopoverTrigger>
    <PopoverContent align="end" class="w-40">
      Aligned to end
    </PopoverContent>
  </Popover>
</div>
