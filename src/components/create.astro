---
// Docs only: build a shadcn/ui preset and preview Fulldev UI with it.
import Check from "@lucide/astro/icons/check"
import Copy from "@lucide/astro/icons/copy"
import Shuffle from "@lucide/astro/icons/shuffle"

import {
  baseColorOptions,
  DEFAULT_CONFIG,
  FONTS,
  MENU_ACCENTS,
  MENU_COLORS,
  presetCode,
  RADII,
  STYLE_OPTIONS,
  themeOptions,
} from "@/lib/presets"
import { Button } from "@/components/ui/button"
import { Field, FieldGroup, FieldLabel } from "@/components/ui/field"
import {
  NativeSelect,
  NativeSelectOptGroup,
  NativeSelectOption,
} from "@/components/ui/native-select"
import { Tabs, TabsContent, TabsList, TabsTrigger } from "@/components/ui/tabs"
import CreatePreview from "@/components/create-preview.astro"

const fontGroups = ["sans", "serif", "mono"].map((type) => ({
  label: type[0].toUpperCase() + type.slice(1),
  fonts: FONTS.filter((font) => font.type === type),
}))

const controls = [
  { name: "style", label: "Style", options: STYLE_OPTIONS },
  { name: "baseColor", label: "Base color", options: baseColorOptions },
  {
    name: "theme",
    label: "Theme",
    options: themeOptions(DEFAULT_CONFIG.baseColor),
  },
  {
    name: "chartColor",
    label: "Chart color",
    options: themeOptions(DEFAULT_CONFIG.baseColor),
  },
  { name: "font", label: "Font" },
  { name: "fontHeading", label: "Heading font" },
  { name: "radius", label: "Radius", options: RADII },
  { name: "menuColor", label: "Menu color", options: MENU_COLORS },
  { name: "menuAccent", label: "Menu accent", options: MENU_ACCENTS },
]
const code = presetCode(DEFAULT_CONFIG)
// {preset} and {style} are replaced with the current preset code and style.
const commands = {
  init: "npx shadcn@latest init https://ui.full.dev/r/styles/base-{style}/base.json",
  theme: "npx shadcn@latest apply {preset} --only theme,font",
  style: '"style": "base-{style}"',
  reinstall: "npx shadcn@latest add @fulldev/button @fulldev/card --overwrite",
}
const command = (template: string) =>
  template.replace("{preset}", code).replace("{style}", DEFAULT_CONFIG.style)
---

{/* The create sidebar takes the place of the docs sidebar, as on
    ui.shadcn.com/create: the framework, then the preset options. */}
<div
  class="flex flex-col gap-8 lg:grid lg:grid-cols-[16.5rem_minmax(0,1fr)] lg:gap-0"
  data-create
>
  <aside
    aria-label="Preset options"
    class="flex flex-col gap-6 pt-4 lg:sticky lg:top-16 lg:pb-8 lg:h-[calc(100svh-4rem)] lg:w-56 lg:overflow-y-auto lg:[scrollbar-width:none]"
  >
    <Field class="gap-1.5">
      <FieldLabel
        for="create-option-framework"
        class="text-muted-foreground text-xs"
      >
        Framework
      </FieldLabel>
      <NativeSelect
        id="create-option-framework"
        size="sm"
        class="w-full max-md:[&_select]:text-base"
        data-create-framework
      >
        <NativeSelectOption value="astro">Astro</NativeSelectOption>
        <NativeSelectOption value="react">React</NativeSelectOption>
        <NativeSelectOption value="liquid">Liquid</NativeSelectOption>
      </NativeSelect>
    </Field>
    <FieldGroup class="grid grid-cols-2 gap-3 lg:flex lg:flex-col">
      {controls.map(({ name, label, options }) => (
        <Field class="gap-1.5">
          <FieldLabel
            for={`create-${name}`}
            class="text-muted-foreground text-xs"
          >
            {label}
          </FieldLabel>
          <NativeSelect
            id={`create-${name}`}
            data-preset-field={name}
            size="sm"
            class="w-full max-md:[&_select]:text-base"
          >
            {name === "fontHeading" && (
              <NativeSelectOption value="inherit">
                Same as font
              </NativeSelectOption>
            )}
            {options
              ? options.map((option) => (
                  <NativeSelectOption
                    value={option.name}
                    selected={
                      DEFAULT_CONFIG[name as keyof typeof DEFAULT_CONFIG] ===
                      option.name
                    }
                  >
                    {option.label}
                  </NativeSelectOption>
                ))
              : fontGroups.map((group) => (
                  <NativeSelectOptGroup label={group.label}>
                    {group.fonts.map((font) => (
                      <NativeSelectOption
                        value={font.name}
                        selected={
                          DEFAULT_CONFIG[
                            name as keyof typeof DEFAULT_CONFIG
                          ] === font.name
                        }
                      >
                        {font.title}
                      </NativeSelectOption>
                    ))}
                  </NativeSelectOptGroup>
                ))}
          </NativeSelect>
        </Field>
      ))}
    </FieldGroup>
    <div class="flex gap-2">
      <Button variant="outline" size="sm" data-preset-random class="flex-1">
        <Shuffle data-icon="inline-start" />
        Shuffle
      </Button>
      <Button variant="outline" size="sm" data-preset-reset class="flex-1">
        Reset
      </Button>
    </div>
  </aside>

  <div class="flex min-w-0 flex-col gap-6 pt-4 pb-16">
    <div class="bg-muted/40 flex flex-wrap items-center justify-between gap-3 rounded-xl border p-3">
      <div class="flex min-w-0 flex-col">
        <span class="text-muted-foreground text-xs" data-preset-status>
          Fulldev UI default, change an option to create a preset
        </span>
        <code class="font-mono text-sm font-medium" data-preset-code>
          {code}
        </code>
      </div>
      <div class="flex flex-wrap gap-2">
        <Button variant="outline" size="sm" data-copy="code">
          <Copy data-icon="inline-start" data-copy-icon />
          <Check data-icon="inline-start" data-check-icon class="hidden" />
          Copy code
        </Button>
        <Button variant="outline" size="sm" data-copy="link">
          <Copy data-icon="inline-start" data-copy-icon />
          <Check data-icon="inline-start" data-check-icon class="hidden" />
          Copy link
        </Button>
        <Button
          as="a"
          variant="outline"
          size="sm"
          href={`https://ui.shadcn.com/create?preset=${code}`}
          target="_blank"
          rel="noopener"
          data-preset-shadcn
        >
          Open in shadcn/ui
        </Button>
      </div>
    </div>

    <div class="bg-muted/30 @container rounded-xl border p-4 @3xl:p-10">
      <div class="w-full">
        <CreatePreview />
      </div>
    </div>

    <div
      data-framework-panel="liquid"
      hidden
      class="flex flex-col gap-3 text-sm"
    >
      <p>
        Install in your Shopify theme and render <code>ui</code> once in the
        layout head. Liquid uses native Vega CSS; Tailwind style presets do not
        transform it. Customize the shared tokens in your theme.
      </p>
      <pre class="bg-muted overflow-x-auto rounded-lg p-3 font-mono text-xs"><code>npx shadcn@latest add https://ui.full.dev/r/liquid/components.json</code></pre>
      <a href="/liquid/docs/installation/" class="underline">
        Liquid installation and theming
      </a>
    </div>
    <Tabs defaultValue="new" class="gap-3" data-framework-exclude="liquid">
      <TabsList>
        <TabsTrigger value="new">New project</TabsTrigger>
        <TabsTrigger value="existing">Existing Fulldev UI project</TabsTrigger>
      </TabsList>
      <TabsContent value="new" class="flex flex-col gap-3 text-sm">
        <div class="flex flex-col gap-3" data-framework-panel="astro">
          <p class="text-muted-foreground">
            In your Astro project, set up Fulldev UI in the preset's style, then
            apply the preset's theme and fonts:
          </p>
          <pre class="bg-muted overflow-x-auto rounded-lg p-3 font-mono text-xs whitespace-pre"><code data-preset-command={commands.init}>{command(commands.init)}</code>
<code data-preset-command={commands.theme}>{command(commands.theme)}</code></pre>
        </div>
        <div class="flex flex-col gap-3" data-framework-panel="react" hidden>
          <p class="text-muted-foreground">
            Create a shadcn/ui project with the preset, add the{" "}
            <code>@fulldev</code> registry to <code>components.json</code>, then
            add Fulldev UI extras and blocks:
          </p>
          <pre class="bg-muted overflow-x-auto rounded-lg p-3 font-mono text-xs whitespace-pre"><code data-preset-command="npx shadcn@latest init --preset {preset}">{`npx shadcn@latest init --preset ${code}`}</code>
<code>npx shadcn@latest add @fulldev/section @fulldev/hero-1</code></pre>
        </div>
      </TabsContent>
      <TabsContent value="existing" class="flex flex-col gap-3 text-sm" hidden>
        <p class="text-muted-foreground">
          Set the style in <code>components.json</code>, apply the theme and
          fonts, then reinstall the Fulldev UI components you use in the new
          style. Commit first, because <code>--overwrite</code> replaces your
          component files. The <code>@fulldev</code> registry must contain{" "}
          <code>{"{style}"}</code>, or components install in Vega.
        </p>
        <pre class="bg-muted overflow-x-auto rounded-lg p-3 font-mono text-xs whitespace-pre"><code data-preset-command={commands.style}>{command(commands.style)}</code></pre>
        <pre class="bg-muted overflow-x-auto rounded-lg p-3 font-mono text-xs whitespace-pre"><code data-preset-command={commands.theme}>{command(commands.theme)}</code>
<code>{commands.reinstall}</code></pre>
      </TabsContent>
    </Tabs>
    <p class="text-muted-foreground text-sm" data-menu-color-note hidden>
      The shadcn CLI applies menu colors to React components only, so the Astro
      components of Fulldev UI install with the default menu color. The React
      extension uses the shadcn/ui menus, which get the preset's menu color.
    </p>
    <slot />
  </div>
</div>

<script>
  // The framework choice picks the install steps and is remembered for the
  // docs header and switcher.
  import { FRAMEWORK_KEY, writeFramework } from "@/lib/preset-store"

  const select = document.querySelector<HTMLSelectElement>(
    "[data-create-framework]"
  )
  const show = (framework: string) => {
    document
      .querySelectorAll<HTMLElement>("[data-framework-exclude]")
      .forEach((panel) => {
        panel.hidden = panel.dataset.frameworkExclude === framework
      })
    document
      .querySelectorAll<HTMLElement>("[data-framework-panel]")
      .forEach((panel) => {
        panel.hidden = panel.dataset.frameworkPanel !== framework
      })
  }
  if (select) {
    select.value = localStorage.getItem(FRAMEWORK_KEY) ?? "astro"
    show(select.value)
    select.addEventListener("change", () => {
      writeFramework(select.value)
      show(select.value)
    })
  }
</script>

<script>
  import {
    applyPreset,
    PRESET_EVENT,
    readPreset,
    writePreset,
  } from "@/lib/preset-store"
  import {
    decodePreset,
    DEFAULT_CONFIG,
    encodePreset,
    normalizeConfig,
    presetCss,
    presetFontUrls,
    randomConfig,
    themeOptions,
    type PresetConfig,
  } from "@/lib/presets"

  const root = document.querySelector<HTMLElement>("[data-create]")
  const fields = [
    ...document.querySelectorAll<HTMLSelectElement>("[data-preset-field]"),
  ]

  const current = (): PresetConfig => ({
    ...DEFAULT_CONFIG,
    ...(readPreset()?.config as Partial<PresetConfig>),
  })

  const save = (input: PresetConfig) => {
    const config = normalizeConfig(input)
    writePreset({
      config,
      css: presetCss(config),
      fonts: presetFontUrls(config),
    })
  }

  // Theme and chart colors depend on the base color, like on ui.shadcn.com.
  const fillThemes = (baseColor: string) => {
    for (const field of fields) {
      if (!["theme", "chartColor"].includes(field.dataset.presetField ?? "")) {
        continue
      }
      field.replaceChildren(
        ...themeOptions(baseColor).map(
          ({ name, label }) => new Option(label, name)
        )
      )
    }
  }

  const render = () => {
    const config = current()
    fillThemes(config.baseColor)
    for (const field of fields) {
      field.value =
        config[field.dataset.presetField as keyof PresetConfig] ?? ""
    }
    const code = encodePreset(config)
    const custom = Boolean(readPreset()?.css)
    root?.querySelectorAll("[data-preset-code]").forEach((element) => {
      element.textContent = code
    })
    const status = root?.querySelector("[data-preset-status]")
    if (status) {
      status.textContent = custom
        ? "Preset"
        : "Fulldev UI default, change an option to create a preset"
    }
    root
      ?.querySelectorAll<HTMLElement>("[data-preset-command]")
      .forEach((element) => {
        element.textContent = (element.dataset.presetCommand ?? "")
          .replace("{preset}", code)
          .replace("{style}", config.style)
      })
    root
      ?.querySelector<HTMLAnchorElement>("[data-preset-shadcn]")
      ?.setAttribute("href", `https://ui.shadcn.com/create?preset=${code}`)
    root
      ?.querySelector<HTMLElement>("[data-menu-color-note]")
      ?.toggleAttribute("hidden", config.menuColor === "default")
  }

  // A shared link opens that preset, then the address drops it, so later
  // changes and Reset survive a reload.
  const url = new URL(location.href)
  const shared = url.searchParams.get("preset")
  const decoded = shared ? decodePreset(shared) : null
  if (shared) {
    url.searchParams.delete("preset")
    history.replaceState(history.state, "", url)
  }
  if (decoded) save({ ...decoded, iconLibrary: "lucide" })
  else applyPreset(readPreset())
  render()
  document.addEventListener(PRESET_EVENT, render)

  for (const field of fields) {
    field.addEventListener("change", () => {
      save({
        ...current(),
        [field.dataset.presetField!]: field.value,
      } as PresetConfig)
    })
  }

  root?.querySelector("[data-preset-random]")?.addEventListener("click", () => {
    save(randomConfig())
  })

  root?.querySelector("[data-preset-reset]")?.addEventListener("click", () => {
    writePreset(undefined)
  })

  root?.querySelectorAll<HTMLElement>("[data-copy]").forEach((button) => {
    button.addEventListener("click", async () => {
      const code = encodePreset(current())
      const text =
        button.dataset.copy === "link"
          ? `${location.origin}/create/?preset=${code}`
          : code
      await navigator.clipboard.writeText(text).catch(() => {})
      button.querySelector("[data-copy-icon]")?.classList.add("hidden")
      button.querySelector("[data-check-icon]")?.classList.remove("hidden")
      setTimeout(() => {
        button.querySelector("[data-copy-icon]")?.classList.remove("hidden")
        button.querySelector("[data-check-icon]")?.classList.add("hidden")
      }, 1500)
    })
  })
</script>
