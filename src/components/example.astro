---
// Docs only: preview, source and install command of one example file, see
// src/lib/examples.ts. Astro component examples render here, as on
// ui.shadcn.com. Astro blocks render in an iframe of /preview/astro/<name>/
// and React examples in one of the preview app, in the style picked in the
// docs. Search engines do not index the frames (public/_headers), so the
// headings and copy of a block are not part of the docs page.
import { Code } from "astro:components"

import { inheritCodeColors } from "@/lib/code"
import { getExample } from "@/lib/examples"
import { getFramework, getPageId } from "@/lib/pages"
import LiveCode from "@/components/live-code.astro"

type Props = {
  name: string
}

const { name } = Astro.props
const framework = getFramework(getPageId(Astro.url.pathname))
const example = getExample(name, framework)
if (!example) throw new Error(`No ${framework} example named ${name}`)

const components = import.meta.glob<{ default: unknown }>(
  "/src/components/examples/*/*.astro",
  { eager: true }
)
const Component = components[`/${example.path}`]?.default as
  ((props: Record<string, unknown>) => unknown) | undefined
const block = example.kind === "blocks"
// Full-page examples (a block preview upstream) stay inside a frame: the
// transform keeps their fixed parts in it and the viewport heights become the
// frame height.
const fullPage = ["sidebar-demo"].includes(name)
// Header menus open as overlays outside the page height the preview reports,
// so their frames keep room for them. Heroes as tall as the viewport take
// the height of their frame, so it keeps the height of a viewport.
const minHeight =
  /^header-\d+$/.test(name) || ["hero-4", "hero-10", "hero-11"].includes(name)
    ? 640
    : undefined
---

<LiveCode
  componentProps={{
    name: example.item,
    frame: framework !== "astro" || block,
    installCommand:
      framework === "liquid"
        ? `npx shadcn@latest add ${(example.dependencies ?? [example.item]).map((name) => `https://ui.full.dev/r/liquid/${name}.json`).join(" ")}`
        : undefined,
    codeLabel: example.kind === "examples" ? "Code" : "Usage",
  }}
>
  {framework === "liquid" ? (
    <iframe
      slot="example"
      data-liquid-preview
      data-min-height="240"
      src={`/preview/liquid/${example.route}.html`}
      title={`${name} native Liquid preview`}
      loading="lazy"
      class="block w-full"
      style="height: 360px"
    />
  ) : framework === "astro" && block ? (
    <iframe
      slot="example"
      data-astro-preview={name}
      data-min-height={minHeight}
      src={`/preview/astro/${name}/`}
      title={`${name} preview`}
      loading="lazy"
      class="block w-full"
      style="height: 640px"
    />
  ) : Component && fullPage ? (
    <div
      slot="example"
      class="relative h-[640px] w-full transform-gpu overflow-hidden text-left [&_[data-slot=sidebar-container]]:h-full [&_[data-slot=sidebar-wrapper]]:min-h-full"
    >
      <Component />
    </div>
  ) : Component ? (
    <Component slot="example" />
  ) : (
    <iframe
      slot="example"
      data-react-preview={example.route}
      data-dev={import.meta.env.DEV ? "" : undefined}
      data-full-page={fullPage ? "" : undefined}
      data-min-height={minHeight}
      src={`/preview/react/#/${example.route}`}
      title={`${name} preview`}
      loading="lazy"
      class="block w-full"
      style={`height: ${block || fullPage ? 640 : 360}px`}
    />
  )}
  <Code
    slot="code"
    code={example.source}
    lang={example.lang}
    themes={{
      light: "github-light-high-contrast",
      dark: "github-dark-default",
    }}
    transformers={[inheritCodeColors]}
  />
</LiveCode>

<script>
  import { PRESET_EVENT, readPreset } from "@/lib/preset-store"

  // Show each React preview in the docs style. Development serves only vega.
  const sync = () => {
    const style = readPreset()?.config.style ?? "vega"
    document
      .querySelectorAll<HTMLIFrameElement>("iframe[data-react-preview]")
      .forEach((frame) => {
        const path =
          style === "vega" || frame.dataset.dev !== undefined ? "" : `${style}/`
        const src = `/preview/react/${path}#/${frame.dataset.reactPreview}`
        if (frame.getAttribute("src") !== src) frame.setAttribute("src", src)
      })
  }
  sync()
  document.addEventListener(PRESET_EVENT, sync)

  // The previews read the theme and preset from localStorage and set their
  // own height.
</script>
