---
import type { ImageMetadata } from "astro"
import { Image } from "astro:assets"
import type { HTMLAttributes } from "astro/types"
import XIcon from "@lucide/astro/icons/x"

import { cn } from "@/lib/utils"
import { Button } from "@/components/ui/button"
import { Header, HeaderContainer, HeaderGroup } from "@/components/ui/header"
import { Icon } from "@/components/ui/icon"
import { Logo, LogoImage, LogoText } from "@/components/ui/logo"
import {
  NavigationMenu,
  NavigationMenuContent,
  NavigationMenuItem,
  NavigationMenuLink,
  NavigationMenuList,
  NavigationMenuTrigger,
  navigationMenuTriggerStyle,
} from "@/components/ui/navigation-menu"
import {
  Sheet,
  SheetClose,
  SheetContent,
  SheetDescription,
  SheetHeader,
  SheetTitle,
  SheetTrigger,
} from "@/components/ui/sheet"

type Props = HTMLAttributes<"header"> & {
  logo: {
    label: string
    href: string
    src?: ImageMetadata
    srcLight?: ImageMetadata
    srcDark?: ImageMetadata
  }
  navigation: {
    label: string
    href: string
    description?: string
    active?: boolean
    image?: {
      src: ImageMetadata
    }
    links?: {
      label: string
      href: string
      description?: string
      icon?: string
      active?: boolean
    }[]
  }[]
  buttons: {
    label: string
    href: string
    icon?: string
    target?: "_self" | "_blank"
  }[]
  navigationLabel: string
  menu: {
    label: string
    title: string
    description: string
    closeLabel: string
  }
}

const {
  class: className,
  logo,
  navigation,
  buttons,
  navigationLabel,
  menu,
  ...props
} = Astro.props
---

<Header class={cn("border-b", className)} {...props}>
  <HeaderContainer class="justify-between">
    <HeaderGroup>
      <Logo href={logo.href}>
        <LogoImage
          src={logo.src}
          srcLight={logo.srcLight}
          srcDark={logo.srcDark}
          alt=""
        />
        <LogoText>{logo.label}</LogoText>
      </Logo>
    </HeaderGroup>
    <NavigationMenu
      aria-label={navigationLabel}
      class="absolute left-1/2 hidden max-w-none -translate-x-1/2 lg:flex"
      align="center"
    >
      <NavigationMenuList>
        {navigation.map((item, index) =>
          item.links?.length ? (
            <NavigationMenuItem value={`nav-${index}`}>
              <NavigationMenuTrigger>{item.label}</NavigationMenuTrigger>
              <NavigationMenuContent>
                <div class="grid w-[min(46rem,calc(100vw-2rem))] gap-2 p-1 lg:grid-cols-[1fr_1.1fr]">
                  <NavigationMenuLink
                    href={item.href}
                    active={item.active}
                    class="bg-muted/50 hover:bg-muted focus:bg-muted flex min-h-40 flex-col items-start justify-end gap-3 p-4 text-left"
                  >
                    {item.image && (
                      <Image
                        src={item.image.src}
                        alt=""
                        class="mb-auto aspect-[16/9] w-full rounded-md object-cover"
                        widths={[320, 480, 640]}
                        sizes="(min-width: 1024px) 22rem, 100vw"
                      />
                    )}
                    <span class="text-base font-medium">{item.label}</span>
                    {item.description && (
                      <span class="text-muted-foreground text-sm leading-relaxed">
                        {item.description}
                      </span>
                    )}
                  </NavigationMenuLink>
                  <div class="grid gap-1">
                    {item.links.map((link) => (
                      <NavigationMenuLink
                        href={link.href}
                        active={link.active}
                        class="items-start gap-3 p-3"
                      >
                        {link.icon && (
                          <Icon
                            name={link.icon}
                            class="text-muted-foreground mt-0.5"
                          />
                        )}
                        <span class="grid gap-1">
                          <span class="font-medium">{link.label}</span>
                          {link.description && (
                            <span class="text-muted-foreground text-sm leading-relaxed">
                              {link.description}
                            </span>
                          )}
                        </span>
                      </NavigationMenuLink>
                    ))}
                  </div>
                </div>
              </NavigationMenuContent>
            </NavigationMenuItem>
          ) : (
            <NavigationMenuItem value={`nav-${index}`}>
              <NavigationMenuLink
                href={item.href}
                active={item.active}
                class={navigationMenuTriggerStyle()}
              >
                {item.label}
              </NavigationMenuLink>
            </NavigationMenuItem>
          )
        )}
      </NavigationMenuList>
    </NavigationMenu>
    <HeaderGroup class="ml-auto hidden justify-end lg:flex">
      {buttons.map(({ label, href, icon, target }, index) => (
        <Button
          as="a"
          href={href}
          target={target}
          rel={target === "_blank" ? "noreferrer" : undefined}
          size="sm"
          variant={index === buttons.length - 1 ? "default" : "ghost"}
        >
          {icon && <Icon name={icon} />}
          {label}
        </Button>
      ))}
    </HeaderGroup>
    <Sheet class="lg:hidden">
      <SheetTrigger
        variant="ghost"
        size="icon-sm"
        class="ml-auto"
        aria-label={menu.label}
      >
        <Icon name="menu" />
      </SheetTrigger>
      <SheetContent side="right" showCloseButton={false} class="p-0">
        <SheetHeader class="sr-only">
          <SheetTitle>{menu.title}</SheetTitle>
          <SheetDescription>{menu.description}</SheetDescription>
        </SheetHeader>
        <div class="flex h-full flex-col gap-6 overflow-y-auto px-4 py-12">
          <nav aria-label={menu.title} class="flex flex-col gap-4">
            {navigation.map((item) => (
              <div class="grid gap-1">
                <SheetClose
                  as="a"
                  href={item.href}
                  aria-current={item.active ? "page" : undefined}
                  variant="ghost"
                  class="justify-start font-medium"
                >
                  {item.label}
                </SheetClose>
                {item.links && item.links.length > 0 && (
                  <div class="border-border ml-3 grid gap-1 border-l pl-3">
                    {item.links.map((link) => (
                      <SheetClose
                        as="a"
                        href={link.href}
                        aria-current={link.active ? "page" : undefined}
                        variant="ghost"
                        class="text-muted-foreground justify-start"
                      >
                        {link.icon && <Icon name={link.icon} />}
                        {link.label}
                      </SheetClose>
                    ))}
                  </div>
                )}
              </div>
            ))}
          </nav>
          {buttons.length > 0 && (
            <div class="mt-auto flex flex-col gap-2">
              {buttons.map(({ label, href, icon, target }, index) => (
                <SheetClose
                  as="a"
                  href={href}
                  target={target}
                  rel={target === "_blank" ? "noreferrer" : undefined}
                  variant={index === buttons.length - 1 ? "default" : "outline"}
                >
                  {icon && <Icon name={icon} />}
                  {label}
                </SheetClose>
              ))}
            </div>
          )}
        </div>
        <SheetClose
          type="button"
          variant="ghost"
          size="icon-sm"
          class="cn-sheet-close"
        >
          <XIcon />
          <span class="sr-only">{menu.closeLabel}</span>
        </SheetClose>
      </SheetContent>
    </Sheet>
  </HeaderContainer>
</Header>
