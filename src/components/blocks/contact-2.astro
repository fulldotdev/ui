---
import type { HTMLAttributes } from "astro/types"

import { cn } from "@/lib/utils"
import { Button } from "@/components/ui/button"
import { Icon } from "@/components/ui/icon"
import {
  Section,
  SectionContainer,
  SectionTitle,
} from "@/components/ui/section"

type Props = HTMLAttributes<"section"> & {
  title: string
  description: string
  contactItems: {
    icon: string
    title: string
    description: string
    href?: string
  }[]
}

const {
  class: className,
  title,
  description,
  contactItems,
  ...props
} = Astro.props
---

<Section class={cn("", className)} {...props}>
  <SectionContainer class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-start">
    <div class="flex flex-col gap-6">
      <div class="flex flex-col gap-4">
        <SectionTitle>{title}</SectionTitle>
        <p class="text-muted-foreground max-w-xl text-base leading-relaxed">
          {description}
        </p>
      </div>
      {Astro.slots.has("default") && (
        <div class="rounded-xl border p-6">
          <slot />
        </div>
      )}
    </div>

    <ul class="flex flex-col gap-3">
      {contactItems.map((item) => (
        <li class="flex gap-4 rounded-xl border p-4">
          <Button
            as="span"
            variant="secondary"
            size="icon"
            class="text-primary shrink-0"
            aria-hidden="true"
          >
            <Icon name={item.icon} />
          </Button>
          <div class="flex flex-col gap-1">
            <p class="text-foreground text-sm font-medium">{item.title}</p>
            {item.href != null ? (
              <a
                href={item.href}
                class="text-muted-foreground hover:text-foreground text-sm leading-relaxed wrap-anywhere underline-offset-4 hover:underline"
              >
                {item.description}
              </a>
            ) : (
              <p class="text-muted-foreground text-sm leading-relaxed wrap-anywhere">
                {item.description}
              </p>
            )}
          </div>
        </li>
      ))}
    </ul>
  </SectionContainer>
</Section>
