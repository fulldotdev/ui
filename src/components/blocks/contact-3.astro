---
import type { ImageMetadata } from "astro"
import { Image } from "astro:assets"
import type { HTMLAttributes } from "astro/types"

import { cn } from "@/lib/utils"
import { Button } from "@/components/ui/button"
import { Icon } from "@/components/ui/icon"
import {
  Section,
  SectionContainer,
  SectionTitle,
} from "@/components/ui/section"
import PlaceholderImage from "@/assets/placeholder.svg"

type Props = HTMLAttributes<"section"> & {
  title: string
  description: string
  contactItems: {
    icon: string
    title: string
    description: string
    href?: string
  }[]
  image?: {
    src: ImageMetadata
    alt: string
  }
}

const {
  class: className,
  title,
  description,
  contactItems,
  image = { src: PlaceholderImage, alt: "" },
  ...props
} = Astro.props
---

<Section class={cn("", className)} {...props}>
  <SectionContainer class="grid gap-12 lg:grid-cols-2 lg:items-start">
    <div class="flex flex-col gap-8">
      <div class="flex flex-col gap-4">
        <SectionTitle>{title}</SectionTitle>
        <p class="text-muted-foreground max-w-xl text-base leading-relaxed">
          {description}
        </p>
      </div>
      <ul class="grid gap-4 sm:grid-cols-2">
        {contactItems.map((item) => (
          <li class="flex gap-4">
            <Button
              as="span"
              variant="secondary"
              size="icon"
              class="text-primary shrink-0"
              aria-hidden="true"
            >
              <Icon name={item.icon} />
            </Button>
            <div class="flex min-w-0 flex-col gap-1">
              <p class="text-foreground text-sm font-medium">{item.title}</p>
              {item.href != null ? (
                <a
                  href={item.href}
                  class="text-muted-foreground hover:text-foreground text-sm leading-relaxed wrap-anywhere underline-offset-4 hover:underline"
                >
                  {item.description}
                </a>
              ) : (
                <p class="text-muted-foreground text-sm leading-relaxed wrap-anywhere">
                  {item.description}
                </p>
              )}
            </div>
          </li>
        ))}
      </ul>
      {Astro.slots.has("default") && (
        <div class="rounded-xl border p-6">
          <slot />
        </div>
      )}
    </div>
    <Image
      src={image.src}
      alt={image.alt}
      class="aspect-[3/4] w-full rounded-xl border object-cover lg:sticky lg:top-24"
      widths={[640, 960, 1280]}
      sizes="(min-width: 80rem) 600px, (min-width: 64rem) 50vw, 100vw"
    />
  </SectionContainer>
</Section>
