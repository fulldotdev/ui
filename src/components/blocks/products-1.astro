---
import type { ImageMetadata } from "astro"
import { Image } from "astro:assets"
import type { HTMLAttributes } from "astro/types"

import { cn } from "@/lib/utils"
import { Badge } from "@/components/ui/badge"
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card"
import { Price, PriceUnit, PriceValue } from "@/components/ui/price"
import {
  Section,
  SectionContainer,
  SectionTitle,
} from "@/components/ui/section"

type Props = HTMLAttributes<"section"> & {
  badge: string
  title: string
  locale?: string
  discountLabel?: string
  products: {
    image: {
      src: ImageMetadata
      alt: string
    }
    title: string
    description: string
    price: {
      value: number
      compareAt?: number
      currency: string
      unit: string
    }
  }[]
}

const {
  class: className,
  badge,
  title,
  locale,
  discountLabel,
  products,
  ...props
} = Astro.props
---

<Section class={cn("", className)} {...props}>
  <SectionContainer class="flex flex-col gap-8">
    <div class="mx-auto max-w-2xl text-center">
      <Badge variant="secondary">{badge}</Badge>
      <SectionTitle class="mt-4">{title}</SectionTitle>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {products.map((product) => (
        <Card>
          <Image
            src={product.image.src}
            alt={product.image.alt}
            class="aspect-[4/3] w-full object-cover"
            widths={[320, 480, 640]}
            sizes="(min-width: 80rem) 302px, (min-width: 64rem) 25vw, (min-width: 40rem) 50vw, 100vw"
          />
          <CardHeader>
            <CardTitle as="h3">{product.title}</CardTitle>
            <CardDescription>{product.description}</CardDescription>
          </CardHeader>
          <CardContent>
            <Price>
              <PriceValue
                price={product.price.value}
                compareAt={product.price.compareAt}
                currency={product.price.currency}
                locale={locale}
                discountLabel={discountLabel}
              />
              <PriceUnit>{product.price.unit}</PriceUnit>
            </Price>
          </CardContent>
        </Card>
      ))}
    </div>
  </SectionContainer>
</Section>
