---
import type { HTMLAttributes } from "astro/types"
import ArrowRightIcon from "@lucide/astro/icons/arrow-right"

import { cn } from "@/lib/utils"
import { Button } from "@/components/ui/button"
import { Icon } from "@/components/ui/icon"
import {
  Section,
  SectionContainer,
  SectionTitle,
} from "@/components/ui/section"

type Props = HTMLAttributes<"section"> & {
  title: string
  description: string
  buttons: {
    label: string
    href: string
  }[]
  features: {
    title: string
    description: string
    icon: string
    link?: {
      label: string
      href: string
    }
  }[]
}

const {
  class: className,
  title,
  description,
  buttons,
  features,
  ...props
} = Astro.props
---

<Section class={cn("", className)} {...props}>
  <SectionContainer>
    <div class="grid gap-12 lg:grid-cols-[1fr_2fr] lg:items-start">
      <div class="lg:sticky lg:top-28">
        <SectionTitle>{title}</SectionTitle>
        <p class="text-muted-foreground mt-4 text-base leading-relaxed text-balance">
          {description}
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          {buttons.map(({ href, label }, index) => (
            <Button
              as="a"
              href={href}
              variant={index === 0 ? "default" : "outline"}
            >
              {label}
            </Button>
          ))}
        </div>
      </div>
      <ul class="grid gap-6 sm:grid-cols-2">
        {features.map((feature) => (
          <li class="flex flex-col gap-4 rounded-xl border p-6">
            <div class="bg-primary/10 text-primary flex size-10 items-center justify-center rounded-lg">
              <Icon name={feature.icon} class="size-5" />
            </div>
            <div class="flex flex-col gap-1.5">
              <h3 class="text-foreground text-base font-medium">
                {feature.title}
              </h3>
              <p class="text-muted-foreground text-sm leading-relaxed">
                {feature.description}
              </p>
            </div>
            {feature.link && (
              <a
                href={feature.link.href}
                class="text-primary mt-auto inline-flex items-center gap-1 text-sm font-medium hover:underline"
              >
                {feature.link.label}
                <ArrowRightIcon class="size-3.5" />
              </a>
            )}
          </li>
        ))}
      </ul>
    </div>
  </SectionContainer>
</Section>
