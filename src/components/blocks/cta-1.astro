---
import type { ImageMetadata } from "astro"
import type { HTMLAttributes } from "astro/types"

import { cn } from "@/lib/utils"
import {
  Avatar,
  AvatarFallback,
  AvatarGroup,
  AvatarImage,
} from "@/components/ui/avatar"
import { Button } from "@/components/ui/button"
import { Rating } from "@/components/ui/rating"
import {
  Section,
  SectionContainer,
  SectionDescription,
  SectionTitle,
} from "@/components/ui/section"

type Props = HTMLAttributes<"section"> & {
  title: string
  description: string
  buttons?: {
    label: string
    href: string
    variant?: "default" | "outline" | "secondary" | "ghost"
  }[]
  socialProof?: {
    avatars: {
      image?: ImageMetadata
      initials: string
      name?: string
    }[]
    rating: number
    text: string
  }
}

const {
  class: className,
  title,
  description,
  buttons,
  socialProof,
  ...props
} = Astro.props
---

<Section variant="floating" class={cn("", className)} {...props}>
  <SectionContainer class="items-center text-center">
    {
      socialProof && (
        <div class="flex flex-col items-center gap-3">
          <AvatarGroup>
            {socialProof.avatars.map((avatar) => (
              <Avatar class="ring-background size-11 ring">
                <AvatarImage
                  src={avatar.image}
                  alt={avatar.name ?? avatar.initials}
                />
                <AvatarFallback>{avatar.initials}</AvatarFallback>
              </Avatar>
            ))}
          </AvatarGroup>
          <div class="flex items-center gap-2">
            <Rating value={socialProof.rating} />
            <span class="text-muted-foreground text-sm">
              {socialProof.text}
            </span>
          </div>
        </div>
      )
    }
    <div class="flex max-w-2xl flex-col items-center gap-5">
      <SectionTitle class="leading-[1.1]">
        {title}
      </SectionTitle>
      <SectionDescription>
        {description}
      </SectionDescription>
    </div>
    {
      buttons?.length && (
        <div class="flex flex-wrap justify-center gap-3">
          {buttons.map(({ href, label, ...button }, index) => (
            <Button
              as="a"
              href={href}
              size="lg"
              variant={
                button.variant ?? (index === 0 ? "default" : "secondary")
              }
              {...button}
            >
              {label}
            </Button>
          ))}
        </div>
      )
    }
  </SectionContainer>
</Section>
