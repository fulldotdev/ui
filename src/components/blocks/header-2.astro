---
import type { HTMLAttributes } from "astro/types"
import XIcon from "@lucide/astro/icons/x"

import { cn } from "@/lib/utils"
import { Button } from "@/components/ui/button"
import { Header, HeaderContainer, HeaderGroup } from "@/components/ui/header"
import { Icon } from "@/components/ui/icon"
import { Logo, LogoImage, LogoText } from "@/components/ui/logo"
import {
  NavigationMenu,
  NavigationMenuItem,
  NavigationMenuLink,
  NavigationMenuList,
} from "@/components/ui/navigation-menu"
import {
  Sheet,
  SheetClose,
  SheetContent,
  SheetDescription,
  SheetHeader,
  SheetTitle,
  SheetTrigger,
} from "@/components/ui/sheet"

type Props = HTMLAttributes<"header"> & {
  logo: {
    label: string
    href: string
    src?: any
    srcLight?: any
    srcDark?: any
    alt?: string
  }
  navigation: {
    label: string
    href: string
    active?: boolean
  }[]
  buttons: {
    label: string
    href: string
    icon?: string
  }[]
  navigationLabel: string
  menu: {
    label: string
    title: string
    description: string
    closeLabel: string
  }
}

const {
  class: className,
  logo,
  navigation,
  buttons,
  navigationLabel,
  menu,
  ...props
} = Astro.props
---

<Header variant="floating" class={cn("", className)} {...props}>
  <HeaderContainer class="justify-between">
    <HeaderGroup>
      <Logo href={logo.href}>
        <LogoImage
          src={logo.src}
          srcLight={logo.srcLight}
          srcDark={logo.srcDark}
          alt={logo.alt}
        />
        {logo.label && <LogoText>{logo.label}</LogoText>}
      </Logo>
    </HeaderGroup>
    <NavigationMenu
      aria-label={navigationLabel}
      class="absolute left-1/2 hidden max-w-none -translate-x-1/2 lg:flex"
    >
      <NavigationMenuList>
        {navigation.map((item, index) => (
          <NavigationMenuItem value={`nav-${index}`}>
            <NavigationMenuLink href={item.href} active={item.active}>
              {item.label}
            </NavigationMenuLink>
          </NavigationMenuItem>
        ))}
      </NavigationMenuList>
    </NavigationMenu>
    <HeaderGroup class="ml-auto hidden justify-end lg:flex">
      <slot />
      {buttons.map(({ label, href, icon }, index) => (
        <Button
          as="a"
          href={href}
          size={icon && !label ? "icon-sm" : "sm"}
          variant={index === buttons.length - 1 ? "default" : "ghost"}
          aria-label={label}
          target={href.startsWith("http") ? "_blank" : undefined}
          rel={href.startsWith("http") ? "noreferrer" : undefined}
        >
          {icon && <Icon name={icon} />}
          {label}
        </Button>
      ))}
    </HeaderGroup>
    <Sheet class="lg:hidden">
      <SheetTrigger
        variant="ghost"
        size="icon-sm"
        class="ml-auto"
        aria-label={menu.label}
      >
        <Icon name="menu" />
      </SheetTrigger>
      <SheetContent side="right" showCloseButton={false} class="p-0">
        <SheetHeader class="sr-only">
          <SheetTitle>{menu.title}</SheetTitle>
          <SheetDescription>{menu.description}</SheetDescription>
        </SheetHeader>
        <div class="flex h-full flex-col gap-6 px-4 py-12">
          <nav aria-label={menu.title} class="flex flex-col gap-1">
            {navigation.map((item) => (
              <SheetClose
                as="a"
                href={item.href}
                aria-current={item.active ? "page" : undefined}
                variant="ghost"
                class="justify-start"
              >
                {item.label}
              </SheetClose>
            ))}
          </nav>
          <div class="mt-auto flex flex-col gap-2">
            <slot name="mobile" />
          </div>
        </div>
        <SheetClose
          type="button"
          variant="ghost"
          size="icon-sm"
          class="cn-sheet-close"
        >
          <XIcon />
          <span class="sr-only">{menu.closeLabel}</span>
        </SheetClose>
      </SheetContent>
    </Sheet>
  </HeaderContainer>
</Header>
