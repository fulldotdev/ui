---
import type { HTMLAttributes } from "astro/types"

import { cn } from "@/lib/utils"
import { Button } from "@/components/ui/button"
import {
  Section,
  SectionContainer,
  SectionDescription,
  SectionTitle,
} from "@/components/ui/section"

type Props = HTMLAttributes<"section"> & {
  title: string
  description: string
  buttons?: {
    label: string
    href: string
    variant?: "default" | "outline" | "secondary" | "ghost"
  }[]
}

const { class: className, title, description, buttons, ...props } = Astro.props
---

<Section
  variant="floating"
  class={cn("border-primary/20 shadow-none", className)}
  {...props}
>
  <SectionContainer
    class="before:from-primary/20 relative items-center before:absolute before:top-full before:left-1/2 before:-z-10 before:h-[200%] before:w-full before:-translate-x-1/2 before:rounded-full before:bg-gradient-to-b before:to-transparent before:blur-3xl"
  >
    <div class="flex max-w-2xl flex-col items-center gap-5 text-center">
      <SectionTitle class="leading-[1.1]">
        {title}
      </SectionTitle>
      <SectionDescription>
        {description}
      </SectionDescription>
    </div>
    {
      buttons?.length && (
        <div class="flex flex-wrap justify-center gap-3">
          {buttons.map(({ href, label, ...button }, index) => (
            <Button
              as="a"
              href={href}
              size="lg"
              variant={button.variant ?? (index === 0 ? "default" : "outline")}
              {...button}
            >
              {label}
            </Button>
          ))}
        </div>
      )
    }
  </SectionContainer>
</Section>
