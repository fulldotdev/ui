---
import type { HTMLAttributes } from "astro/types"

import { cn } from "@/lib/utils"
import {
  Accordion,
  AccordionContent,
  AccordionItem,
  AccordionTrigger,
} from "@/components/ui/accordion"
import { Button } from "@/components/ui/button"
import {
  Section,
  SectionContainer,
  SectionDescription,
  SectionTitle,
} from "@/components/ui/section"

type Props = HTMLAttributes<"section"> & {
  title: string
  description: string
  faqs: {
    id: string
    question: string
    answer: string
  }[]
  buttons?: {
    label: string
    href: string
    variant?: "default" | "outline" | "secondary" | "ghost"
  }[]
}

const {
  class: className,
  title,
  description,
  faqs,
  buttons,
  ...props
} = Astro.props
---

<Section class={cn("", className)} {...props}>
  <SectionContainer class="items-center text-center">
    <div class="flex max-w-2xl flex-col items-center gap-5">
      <SectionTitle>
        {title}
      </SectionTitle>
      <SectionDescription>
        {description}
      </SectionDescription>
    </div>
    {
      buttons?.length && (
        <div class="flex flex-wrap justify-center gap-3">
          {buttons.map(({ href, label, ...button }, index) => (
            <Button
              as="a"
              href={href}
              size="lg"
              variant={
                button.variant ?? (index === 0 ? "default" : "secondary")
              }
              {...button}
            >
              {label}
            </Button>
          ))}
        </div>
      )
    }
  </SectionContainer>
  <SectionContainer>
    <div class="mx-auto w-full max-w-3xl">
      <Accordion collapsible>
        {
          faqs.map((item) => (
            <AccordionItem value={item.id}>
              <AccordionTrigger>{item.question}</AccordionTrigger>
              <AccordionContent>{item.answer}</AccordionContent>
            </AccordionItem>
          ))
        }
      </Accordion>
    </div>
  </SectionContainer>
</Section>
