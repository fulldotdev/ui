---
import type { ImageMetadata } from "astro"
import { Image } from "astro:assets"
import type { HTMLAttributes } from "astro/types"
import ArrowRightIcon from "@lucide/astro/icons/arrow-right"

import { cn } from "@/lib/utils"
import { Button } from "@/components/ui/button"
import {
  Section,
  SectionContainer,
  SectionTitle,
} from "@/components/ui/section"
import PlaceholderImage from "@/assets/placeholder.svg"

type Props = HTMLAttributes<"section"> & {
  title: string
  description: string
  buttons: {
    label: string
    href: string
  }[]
  services: {
    image?: {
      src: ImageMetadata
      alt: string
    }
    title: string
    description: string
    link?: {
      label: string
      href: string
    }
  }[]
}

const {
  class: className,
  title,
  description,
  buttons,
  services,
  ...props
} = Astro.props
---

<Section class={cn("", className)} {...props}>
  <SectionContainer class="flex flex-col gap-8">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div class="max-w-2xl">
        <SectionTitle>{title}</SectionTitle>
        <p class="text-muted-foreground mt-4 text-base leading-relaxed text-balance">
          {description}
        </p>
      </div>
      <div class="flex flex-wrap gap-3">
        {buttons.map(({ href, label }, index) => (
          <Button
            as="a"
            href={href}
            variant={index === 0 ? "default" : "outline"}
          >
            {label}
          </Button>
        ))}
      </div>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {services.map((service) => (
        <article class="flex flex-col gap-4">
          <Image
            src={service.image?.src ?? PlaceholderImage}
            alt={service.image?.alt ?? ""}
            class="aspect-[16/10] w-full rounded-lg object-cover"
            widths={[320, 480, 640]}
            sizes="(min-width: 80rem) 294px, (min-width: 64rem) 25vw, (min-width: 40rem) 50vw, 100vw"
          />
          <div class="flex flex-1 flex-col gap-1">
            <h3 class="text-base font-medium">{service.title}</h3>
            <p class="text-muted-foreground text-sm leading-relaxed">
              {service.description}
            </p>
          </div>
          {service.link && (
            <a
              href={service.link.href}
              class="text-primary inline-flex w-fit items-center gap-1.5 text-sm font-medium underline-offset-4 hover:underline"
            >
              {service.link.label}
              <ArrowRightIcon class="size-3.5" />
            </a>
          )}
        </article>
      ))}
    </div>
  </SectionContainer>
</Section>
