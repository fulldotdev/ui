---
import type { ImageMetadata } from "astro"
import type { HTMLAttributes } from "astro/types"

import { cn } from "@/lib/utils"
import {
  Avatar,
  AvatarFallback,
  AvatarGroup,
  AvatarGroupCount,
  AvatarImage,
} from "@/components/ui/avatar"
import { Button } from "@/components/ui/button"
import {
  Section,
  SectionContainer,
  SectionDescription,
  SectionTitle,
} from "@/components/ui/section"

type Props = HTMLAttributes<"section"> & {
  title: string
  description: string
  buttons: {
    label: string
    href: string
  }[]
  socialProof: {
    avatars: {
      image?: ImageMetadata
      initials: string
      name?: string
    }[]
    count?: string | number
    text: string
  }
}

const {
  class: className,
  title,
  description,
  buttons,
  socialProof,
  ...props
} = Astro.props
---

<Section
  class={cn("bg-primary/10 border-primary/15 border-y", className)}
  {...props}
>
  <SectionContainer class="items-center text-center">
    <div class="flex max-w-2xl flex-col items-center gap-5">
      <SectionTitle class="leading-[1.1]">{title}</SectionTitle>
      <SectionDescription>{description}</SectionDescription>
    </div>
    <div class="flex flex-wrap justify-center gap-3">
      {buttons.map(({ href, label }, index) => (
        <Button
          as="a"
          href={href}
          size="lg"
          variant={index === 0 ? "default" : "secondary"}
        >
          {label}
        </Button>
      ))}
    </div>
    <div class="flex flex-col items-center gap-4">
      <AvatarGroup>
        {socialProof.avatars.map((avatar) => (
          <Avatar class="ring-primary/10 bg-background size-11 ring">
            <AvatarImage
              src={avatar.image}
              alt={avatar.name ?? avatar.initials}
            />
            <AvatarFallback>{avatar.initials}</AvatarFallback>
          </Avatar>
        ))}
        {socialProof.count != null && (
          <AvatarGroupCount class="bg-background text-foreground ring-primary/10 size-11 ring">
            {socialProof.count}
          </AvatarGroupCount>
        )}
      </AvatarGroup>
      <span class="text-muted-foreground text-sm leading-snug">
        {socialProof.text}
      </span>
    </div>
  </SectionContainer>
</Section>
