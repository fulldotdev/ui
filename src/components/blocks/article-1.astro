---
import type { ImageMetadata } from "astro"
import { Image } from "astro:assets"
import type { HTMLAttributes } from "astro/types"

import { cn } from "@/lib/utils"
import { Avatar, AvatarFallback, AvatarImage } from "@/components/ui/avatar"
import { Section, SectionContainer } from "@/components/ui/section"

type Props = HTMLAttributes<"section"> & {
  title: string
  description: string
  author: {
    image?: ImageMetadata
    initials: string
    name: string
    date: string
  }
  image: {
    src: ImageMetadata
    alt: string
  }
}

const {
  class: className,
  title,
  description,
  author,
  image,
  ...props
} = Astro.props
---

<Section class={cn("", className)} {...props}>
  <SectionContainer class="max-w-2xl">
    <article class="flex flex-col gap-8">
      <header class="flex flex-col gap-6">
        <div class="flex flex-col gap-4">
          <h1 class="text-4xl leading-tight font-semibold tracking-tight text-balance sm:text-5xl">
            {title}
          </h1>
          <p class="text-muted-foreground text-lg leading-8 text-balance">
            {description}
          </p>
        </div>
        <div class="flex items-center gap-3">
          <Avatar size="lg" aria-hidden="true">
            <AvatarImage src={author.image} />
            <AvatarFallback>{author.initials}</AvatarFallback>
          </Avatar>
          <div class="flex flex-col">
            <p class="text-sm font-medium">{author.name}</p>
            <p class="text-muted-foreground text-xs">{author.date}</p>
          </div>
        </div>
      </header>
      <Image
        src={image.src}
        alt={image.alt}
        class="aspect-[16/10] w-full rounded-xl object-cover"
        widths={[640, 960, 1280]}
        sizes="(min-width: 42rem) 42rem, 100vw"
        loading="eager"
        fetchpriority="high"
      />
      <div class="flex flex-col gap-6 text-base leading-8">
        <slot />
      </div>
    </article>
  </SectionContainer>
</Section>
