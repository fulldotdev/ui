---
import type { HTMLAttributes } from "astro/types"

import { cn } from "@/lib/utils"
import { Button } from "@/components/ui/button"
import { Icon } from "@/components/ui/icon"
import {
  Section,
  SectionContainer,
  SectionDescription,
  SectionTitle,
} from "@/components/ui/section"

type Props = HTMLAttributes<"section"> & {
  title: string
  description: string
  contactItems: {
    icon: string
    title: string
    description: string
    href?: string
  }[]
}

const {
  class: className,
  title,
  description,
  contactItems,
  ...props
} = Astro.props
---

<Section class={cn("", className)} {...props}>
  <SectionContainer class="flex flex-col items-center gap-6 text-center">
    <div class="flex max-w-2xl flex-col items-center gap-4">
      <SectionTitle>{title}</SectionTitle>
      <SectionDescription class="max-w-2xl">{description}</SectionDescription>
    </div>
  </SectionContainer>
  <SectionContainer>
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {contactItems.map((item) => (
        <li class="flex flex-col gap-3 rounded-xl border p-5">
          <Button
            as="span"
            variant="secondary"
            size="icon"
            class="text-primary"
            aria-hidden="true"
          >
            <Icon name={item.icon} />
          </Button>
          <h3 class="text-foreground text-sm font-medium">{item.title}</h3>
          {item.href != null ? (
            <a
              href={item.href}
              class="text-muted-foreground hover:text-foreground text-sm leading-relaxed wrap-anywhere underline-offset-4 hover:underline"
            >
              {item.description}
            </a>
          ) : (
            <p class="text-muted-foreground text-sm leading-relaxed wrap-anywhere">
              {item.description}
            </p>
          )}
        </li>
      ))}
    </ul>
  </SectionContainer>
  {Astro.slots.has("default") && (
    <SectionContainer>
      <div class="mx-auto w-full max-w-2xl rounded-xl border p-6 sm:p-8">
        <slot />
      </div>
    </SectionContainer>
  )}
</Section>
