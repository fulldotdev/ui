---
import type { ImageMetadata } from "astro"
import type { HTMLAttributes } from "astro/types"
import QuoteIcon from "@lucide/astro/icons/quote"

import { cn } from "@/lib/utils"
import { Avatar, AvatarFallback, AvatarImage } from "@/components/ui/avatar"
import { Rating } from "@/components/ui/rating"
import { Section, SectionContainer } from "@/components/ui/section"
import { Separator } from "@/components/ui/separator"

type Props = HTMLAttributes<"section"> & {
  featured: {
    quote: string
    image?: ImageMetadata
    initials: string
    name: string
    role: string
  }
  reviews: {
    rating: number
    ratingLabel: string
    quote: string
    image?: ImageMetadata
    initials: string
    name: string
    role: string
  }[]
}

const { class: className, featured, reviews, ...props } = Astro.props
---

<Section class={cn("", className)} {...props}>
  <SectionContainer class="grid gap-10 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)] lg:items-start">
    <figure class="flex flex-col gap-6 rounded-xl border p-8">
      <QuoteIcon class="text-primary size-8" />
      <blockquote class="text-foreground text-2xl leading-snug font-semibold text-balance sm:text-3xl">
        <p>{featured.quote}</p>
      </blockquote>
      <figcaption class="flex items-center gap-3 pt-2">
        <Avatar size="lg" aria-hidden="true">
          <AvatarImage src={featured.image} />
          <AvatarFallback>{featured.initials}</AvatarFallback>
        </Avatar>
        <div>
          <p class="text-foreground text-sm font-medium">{featured.name}</p>
          <p class="text-muted-foreground text-xs">{featured.role}</p>
        </div>
      </figcaption>
    </figure>
    <div class="grid gap-6">
      {reviews.map((item) => (
        <div class="flex flex-col">
          <Separator />
          <figure class="flex flex-col gap-3 pt-6">
            <Rating value={item.rating} aria-label={item.ratingLabel} />
            <blockquote class="text-muted-foreground text-sm leading-relaxed">
              <p>{item.quote}</p>
            </blockquote>
            <figcaption class="flex items-center gap-3 pt-1">
              <Avatar aria-hidden="true">
                <AvatarImage src={item.image} />
                <AvatarFallback>{item.initials}</AvatarFallback>
              </Avatar>
              <div>
                <p class="text-foreground text-sm font-medium">{item.name}</p>
                <p class="text-muted-foreground text-xs">{item.role}</p>
              </div>
            </figcaption>
          </figure>
        </div>
      ))}
    </div>
  </SectionContainer>
</Section>
