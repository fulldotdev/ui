---
import type { ImageMetadata } from "astro"
import { Image } from "astro:assets"
import type { HTMLAttributes } from "astro/types"
import { CheckIcon } from "@lucide/astro"

import { cn } from "@/lib/utils"
import { Button } from "@/components/ui/button"
import {
  Section,
  SectionContainer,
  SectionDescription,
  SectionTitle,
} from "@/components/ui/section"
import PlaceholderImage from "@/assets/placeholder.svg"

type Props = HTMLAttributes<"section"> & {
  title: string
  description: string
  features: string[]
  buttons: {
    label: string
    href: string
  }[]
  image?: {
    src: ImageMetadata
    alt: string
  }
}

const {
  class: className,
  title,
  description,
  features,
  buttons,
  image = { src: PlaceholderImage, alt: "" },
  ...props
} = Astro.props
---

<Section class={cn("", className)} {...props}>
  <SectionContainer class="gap-6">
    <div class="flex flex-col gap-4">
      <SectionTitle>{title}</SectionTitle>
      <SectionDescription>{description}</SectionDescription>
    </div>
    <ul class="flex flex-col gap-3">
      {features.map((feature) => (
        <li class="flex items-center gap-3 text-sm">
          <CheckIcon class="text-primary size-4 shrink-0" />
          {feature}
        </li>
      ))}
    </ul>
    <div class="flex flex-wrap gap-3">
      {buttons.map(({ href, label }, index) => (
        <Button
          as="a"
          href={href}
          size="lg"
          variant={index === 0 ? "default" : "secondary"}
        >
          {label}
        </Button>
      ))}
    </div>
  </SectionContainer>
  <SectionContainer>
    <Image
      src={image.src}
      alt={image.alt}
      class="aspect-video w-full rounded-xl border object-cover"
      widths={[640, 960, 1280, 1536]}
      sizes="(min-width: 80rem) 80rem, 100vw"
    />
  </SectionContainer>
</Section>
