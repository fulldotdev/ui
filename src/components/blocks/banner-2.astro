---
import type { HTMLAttributes } from "astro/types"

import { cn } from "@/lib/utils"
import { Banner, BannerContainer } from "@/components/ui/banner"
import { Button } from "@/components/ui/button"

type Props = HTMLAttributes<"aside"> & {
  title: string
  description: string
  buttons: {
    label: string
    href: string
  }[]
}

const { class: className, title, description, buttons, ...props } = Astro.props
---

<Banner variant="floating" class={cn("@container", className)} {...props}>
  <BannerContainer
    class="flex-col items-start gap-4 py-1 @2xl:flex-row @2xl:items-center"
    showClose={false}
  >
    <div class="flex min-w-0 flex-1 flex-col gap-0.5 @5xl:flex-row @5xl:items-center @5xl:gap-x-4">
      <p class="text-sm font-semibold">{title}</p>
      <p class="text-muted-foreground text-sm">{description}</p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      {buttons.map(({ href, label }, index) => (
        <Button
          as="a"
          href={href}
          size="sm"
          variant={index === 0 ? "default" : "outline"}
        >
          {label}
        </Button>
      ))}
    </div>
  </BannerContainer>
</Banner>
