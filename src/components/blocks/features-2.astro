---
import type { HTMLAttributes } from "astro/types"

import { cn } from "@/lib/utils"
import { Icon } from "@/components/ui/icon"
import {
  Section,
  SectionContainer,
  SectionDescription,
  SectionTitle,
} from "@/components/ui/section"

type Props = HTMLAttributes<"section"> & {
  title: string
  description: string
  features: {
    title: string
    description: string
    icon: string
  }[]
}

const { class: className, title, description, features, ...props } = Astro.props
---

<Section class={cn("", className)} {...props}>
  <SectionContainer class="flex flex-col items-center gap-6 text-center">
    <div class="flex max-w-2xl flex-col items-center gap-4">
      <SectionTitle>{title}</SectionTitle>
      <SectionDescription class="max-w-2xl">{description}</SectionDescription>
    </div>
  </SectionContainer>
  <SectionContainer>
    <ul class="ring-foreground/10 bg-border grid gap-px overflow-hidden rounded-xl ring-1 ring-inset sm:grid-cols-2 lg:grid-cols-3">
      {features.map((feature) => (
        <li class="bg-background relative flex flex-col items-center gap-4 p-7 text-center">
          <div class="bg-primary/10 text-primary ring-primary/15 flex size-10 items-center justify-center rounded-lg ring-1 ring-inset">
            <Icon name={feature.icon} class="size-5" />
          </div>
          <h3 class="text-foreground text-base font-medium tracking-tight text-balance">
            {feature.title}
          </h3>
          <p class="text-muted-foreground text-sm leading-relaxed text-balance">
            {feature.description}
          </p>
        </li>
      ))}
    </ul>
  </SectionContainer>
</Section>
