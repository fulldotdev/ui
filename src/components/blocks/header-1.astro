---
import type { ImageMetadata } from "astro"
import type { HTMLAttributes } from "astro/types"
import XIcon from "@lucide/astro/icons/x"

import { cn } from "@/lib/utils"
import { Button } from "@/components/ui/button"
import { Header, HeaderContainer, HeaderGroup } from "@/components/ui/header"
import { Icon } from "@/components/ui/icon"
import { Logo, LogoImage, LogoText } from "@/components/ui/logo"
import {
  NavigationMenu,
  NavigationMenuItem,
  NavigationMenuLink,
  NavigationMenuList,
} from "@/components/ui/navigation-menu"
import {
  Sheet,
  SheetClose,
  SheetContent,
  SheetDescription,
  SheetHeader,
  SheetTitle,
  SheetTrigger,
} from "@/components/ui/sheet"

type Props = HTMLAttributes<"header"> & {
  fold?: "lg" | "xl"
  logo: {
    label: string
    href: string
    src?: ImageMetadata
    srcLight?: ImageMetadata
    srcDark?: ImageMetadata
  }
  navigation: {
    label: string
    href: string
    active?: boolean
  }[]
  buttons: {
    label: string
    href: string
    icon?: string
    target?: "_self" | "_blank"
  }[]
  navigationLabel: string
  menu: {
    label: string
    title: string
    description: string
    closeLabel: string
  }
}

const {
  fold = "lg",
  class: className,
  logo,
  navigation,
  buttons,
  navigationLabel,
  menu,
  ...props
} = Astro.props

const desktopClass = fold === "xl" ? "xl:flex" : "lg:flex"
const mobileClass = fold === "xl" ? "xl:hidden" : "lg:hidden"
---

<Header class={cn("", className)} {...props}>
  <HeaderContainer class="items-center justify-between gap-4">
    <HeaderGroup>
      <Logo href={logo.href}>
        <LogoImage
          src={logo.src}
          srcLight={logo.srcLight}
          srcDark={logo.srcDark}
          alt=""
        />
        <LogoText>{logo.label}</LogoText>
      </Logo>
    </HeaderGroup>
    {navigation.length > 0 && (
      <NavigationMenu
        aria-label={navigationLabel}
        class={cn("hidden flex-none justify-start", desktopClass)}
      >
        <NavigationMenuList class="justify-start">
          {navigation.map((item, index) => (
            <NavigationMenuItem value={`nav-${index}`}>
              <NavigationMenuLink href={item.href} active={item.active}>
                {item.label}
              </NavigationMenuLink>
            </NavigationMenuItem>
          ))}
        </NavigationMenuList>
      </NavigationMenu>
    )}
    <HeaderGroup class={cn("ml-auto hidden flex-1 justify-end", desktopClass)}>
      {buttons.map(({ label, href, icon, target }, index) => (
        <Button
          as="a"
          href={href}
          target={target}
          rel={target === "_blank" ? "noreferrer" : undefined}
          size="sm"
          variant={index === buttons.length - 1 ? "default" : "ghost"}
        >
          {icon && <Icon name={icon} />}
          {label}
        </Button>
      ))}
    </HeaderGroup>
    <Sheet class={mobileClass}>
      <SheetTrigger
        variant="ghost"
        size="icon-sm"
        class="ml-auto"
        aria-label={menu.label}
      >
        <Icon name="menu" />
      </SheetTrigger>
      <SheetContent side="right" showCloseButton={false} class="p-0">
        <SheetHeader class="sr-only">
          <SheetTitle>{menu.title}</SheetTitle>
          <SheetDescription>{menu.description}</SheetDescription>
        </SheetHeader>
        <div class="flex h-full flex-col gap-6 px-4 py-12">
          <nav aria-label={menu.title} class="flex flex-col gap-1">
            {navigation.map((item) => (
              <SheetClose
                as="a"
                href={item.href}
                aria-current={item.active ? "page" : undefined}
                variant="ghost"
                class="justify-start"
              >
                {item.label}
              </SheetClose>
            ))}
          </nav>
          {buttons.length > 0 && (
            <div class="mt-auto flex flex-col gap-2">
              {buttons.map(({ label, href, icon, target }, index) => (
                <SheetClose
                  as="a"
                  href={href}
                  target={target}
                  rel={target === "_blank" ? "noreferrer" : undefined}
                  variant={index === buttons.length - 1 ? "default" : "outline"}
                >
                  {icon && <Icon name={icon} />}
                  {label}
                </SheetClose>
              ))}
            </div>
          )}
        </div>
        <SheetClose
          type="button"
          variant="ghost"
          size="icon-sm"
          class="cn-sheet-close"
        >
          <XIcon />
          <span class="sr-only">{menu.closeLabel}</span>
        </SheetClose>
      </SheetContent>
    </Sheet>
  </HeaderContainer>
</Header>

<script>
  // Close a menu that the header hides at its fold breakpoint, so it does not
  // stay open, or keep the page from scrolling, while hidden.
  const hidden = (element: Element) => element.getClientRects().length === 0
  const close = () => {
    for (const sheet of document.querySelectorAll(
      '[data-slot="header"] [data-slot="dialog"]'
    ))
      if (hidden(sheet))
        sheet.dispatchEvent(
          new CustomEvent("dialog:set", { detail: { open: false } })
        )
    for (const menu of document.querySelectorAll(
      '[data-slot="header"] [data-slot="navigation-menu"]'
    ))
      if (hidden(menu))
        menu.dispatchEvent(
          new CustomEvent("navigation-menu:set", { detail: { value: null } })
        )
  }
  for (const query of ["(min-width: 64rem)", "(min-width: 80rem)"])
    matchMedia(query).addEventListener("change", close)
</script>
