---
import type { HTMLAttributes } from "astro/types"

import { cn } from "@/lib/utils"
import { Logo, LogoText } from "@/components/ui/logo"
import {
  Marquee,
  MarqueeContent,
  MarqueeItem,
  MarqueeToggle,
} from "@/components/ui/marquee"
import {
  Section,
  SectionContainer,
  SectionDescription,
  SectionTitle,
} from "@/components/ui/section"

type Props = HTMLAttributes<"section"> & {
  title: string
  description: string
  brands: {
    name: string
    href?: string
  }[]
  labels: {
    play: string
    pause: string
  }
}

const {
  class: className,
  title,
  description,
  brands,
  labels,
  ...props
} = Astro.props
---

<Section class={cn("", className)} {...props}>
  <SectionContainer class="flex flex-col items-center gap-4 text-center">
    <SectionTitle>{title}</SectionTitle>
    <SectionDescription class="max-w-2xl">{description}</SectionDescription>
  </SectionContainer>
  <Marquee class="flex flex-col gap-4 [--marquee-gap:--spacing(12)]">
    <SectionContainer class="flex justify-end">
      <MarqueeToggle playLabel={labels.play} pauseLabel={labels.pause} />
    </SectionContainer>
    <MarqueeContent class="text-muted-foreground mask-x-from-90%">
      {brands.map((brand) => (
        <MarqueeItem class="flex items-center">
          <Logo
            class={cn(
              brand.href != null &&
                "hover:text-foreground focus-visible:text-foreground transition-colors"
            )}
            href={brand.href}
          >
            <LogoText>{brand.name}</LogoText>
          </Logo>
        </MarqueeItem>
      ))}
    </MarqueeContent>
  </Marquee>
</Section>
