---
import type { HTMLAttributes } from "astro/types"

import { cn } from "@/lib/utils"
import { Logo, LogoText } from "@/components/ui/logo"
import { Marquee } from "@/components/ui/marquee"
import {
  Section,
  SectionContainer,
  SectionDescription,
  SectionTitle,
} from "@/components/ui/section"

type Props = HTMLAttributes<"section"> & {
  title?: string
  description?: string
  brands: {
    name: string
    href?: string
  }[]
}

const { class: className, title, description, brands, ...props } = Astro.props
---

<Section class={cn("", className)} {...props}>
  {
    (title || description) && (
      <SectionContainer class="items-center gap-4 text-center">
        {title && <SectionTitle>{title}</SectionTitle>}
        {description && (
          <SectionDescription class="max-w-2xl">
            {description}
          </SectionDescription>
        )}
      </SectionContainer>
    )
  }
  <Marquee
    class="text-muted-foreground mask-x-from-90%"
    gap="3rem"
    duration="30s"
    pauseOnHover
    infinite
  >
    {
      brands.map((brand) => (
        <Logo
          class="hover:text-foreground grayscale transition-all hover:grayscale-0"
          href={brand.href}
        >
          <LogoText>{brand.name}</LogoText>
        </Logo>
      ))
    }
  </Marquee>
</Section>
