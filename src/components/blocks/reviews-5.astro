---
import type { ImageMetadata } from "astro"
import type { HTMLAttributes } from "astro/types"
import QuoteIcon from "@lucide/astro/icons/quote"

import { cn } from "@/lib/utils"
import { Avatar, AvatarFallback, AvatarImage } from "@/components/ui/avatar"
import { Marquee } from "@/components/ui/marquee"
import { Rating } from "@/components/ui/rating"
import {
  Section,
  SectionContainer,
  SectionDescription,
  SectionTitle,
} from "@/components/ui/section"

type Props = HTMLAttributes<"section"> & {
  title?: string
  description?: string
  reviews: {
    quote: string
    image?: ImageMetadata
    initials: string
    name: string
    role: string
    rating: number
  }[]
}

const { class: className, title, description, reviews, ...props } = Astro.props

const third = Math.ceil(reviews.length / 3)
const row1 = reviews.slice(0, third)
const row2 = reviews.slice(third, third * 2)
const row3 = reviews.slice(third * 2)
---

<Section class={cn("", className)} {...props}>
  {
    (title || description) && (
      <SectionContainer class="items-center gap-4 text-center">
        {title && <SectionTitle>{title}</SectionTitle>}
        {description && (
          <SectionDescription class="max-w-2xl">
            {description}
          </SectionDescription>
        )}
      </SectionContainer>
    )
  }
  <div class="flex flex-col gap-5">
    <Marquee
      direction="left"
      pauseOnHover
      infinite
      gap="1.25rem"
      class="[&>div]:items-stretch"
    >
      {
        row1.map((item) => (
          <div class="bg-muted/50 flex w-[26rem] shrink-0 rounded-2xl p-6">
            <div class="flex flex-1 flex-col gap-4">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <Avatar size="lg">
                    <AvatarImage src={item.image} alt={item.name} />
                    <AvatarFallback>{item.initials}</AvatarFallback>
                  </Avatar>
                  <div>
                    <p class="text-foreground text-sm font-semibold">
                      {item.name}
                    </p>
                    <p class="text-muted-foreground text-xs">{item.role}</p>
                  </div>
                </div>
                <Rating value={item.rating} />
              </div>
              <div class="flex gap-2.5">
                <QuoteIcon class="text-primary/30 mt-0.5 size-5 shrink-0" />
                <p class="text-foreground/80 text-sm leading-relaxed">
                  {item.quote}
                </p>
              </div>
            </div>
          </div>
        ))
      }
    </Marquee>
    <Marquee
      direction="right"
      pauseOnHover
      infinite
      gap="1.25rem"
      class="[&>div]:items-stretch"
    >
      {
        row2.map((item) => (
          <div class="bg-muted/50 flex w-[26rem] shrink-0 rounded-2xl p-6">
            <div class="flex flex-1 flex-col gap-4">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <Avatar size="lg">
                    <AvatarImage src={item.image} alt={item.name} />
                    <AvatarFallback>{item.initials}</AvatarFallback>
                  </Avatar>
                  <div>
                    <p class="text-foreground text-sm font-semibold">
                      {item.name}
                    </p>
                    <p class="text-muted-foreground text-xs">{item.role}</p>
                  </div>
                </div>
                <Rating value={item.rating} />
              </div>
              <div class="flex gap-2.5">
                <QuoteIcon class="text-primary/30 mt-0.5 size-5 shrink-0" />
                <p class="text-foreground/80 text-sm leading-relaxed">
                  {item.quote}
                </p>
              </div>
            </div>
          </div>
        ))
      }
    </Marquee>
    <Marquee
      direction="left"
      pauseOnHover
      infinite
      gap="1.25rem"
      class="[&>div]:items-stretch"
    >
      {
        row3.map((item) => (
          <div class="bg-muted/50 flex w-[26rem] shrink-0 rounded-2xl p-6">
            <div class="flex flex-1 flex-col gap-4">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <Avatar size="lg">
                    <AvatarImage src={item.image} alt={item.name} />
                    <AvatarFallback>{item.initials}</AvatarFallback>
                  </Avatar>
                  <div>
                    <p class="text-foreground text-sm font-semibold">
                      {item.name}
                    </p>
                    <p class="text-muted-foreground text-xs">{item.role}</p>
                  </div>
                </div>
                <Rating value={item.rating} />
              </div>
              <div class="flex gap-2.5">
                <QuoteIcon class="text-primary/30 mt-0.5 size-5 shrink-0" />
                <p class="text-foreground/80 text-sm leading-relaxed">
                  {item.quote}
                </p>
              </div>
            </div>
          </div>
        ))
      }
    </Marquee>
  </div>
</Section>
