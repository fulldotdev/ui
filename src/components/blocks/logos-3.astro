---
import type { HTMLAttributes } from "astro/types"

import { cn } from "@/lib/utils"
import { Logo, LogoText } from "@/components/ui/logo"
import { Section, SectionContainer } from "@/components/ui/section"

type Props = HTMLAttributes<"section"> & {
  brands: {
    name: string
    href?: string
  }[]
}

const { class: className, brands, ...props } = Astro.props
---

<Section class={cn("py-12 lg:py-16", className)} {...props}>
  <SectionContainer>
    <ul class="text-muted-foreground flex flex-wrap items-center justify-center gap-x-12 gap-y-6">
      {brands.map((brand) => (
        <li>
          <Logo
            class={cn(
              brand.href != null &&
                "hover:text-foreground transition-colors focus-visible:text-foreground"
            )}
            href={brand.href}
          >
            <LogoText>{brand.name}</LogoText>
          </Logo>
        </li>
      ))}
    </ul>
  </SectionContainer>
</Section>
