---
import type { ImageMetadata } from "astro"
import { Image } from "astro:assets"
import type { HTMLAttributes } from "astro/types"

import { cn } from "@/lib/utils"
import { Badge } from "@/components/ui/badge"
import { Button } from "@/components/ui/button"
import {
  Section,
  SectionContainer,
  SectionTitle,
} from "@/components/ui/section"
import PlaceholderImage from "@/assets/placeholder.svg"

type Props = HTMLAttributes<"section"> & {
  badge: string
  title: string
  description: string
  buttons: {
    label: string
    href: string
  }[]
  services: {
    image?: {
      src: ImageMetadata
      alt: string
    }
    title: string
    description: string
    button: {
      label: string
      href: string
    }
  }[]
}

const {
  class: className,
  badge,
  title,
  description,
  buttons,
  services,
  ...props
} = Astro.props
---

<Section class={cn("", className)} {...props}>
  <SectionContainer class="flex flex-col gap-8">
    <div class="mx-auto max-w-2xl text-center">
      <Badge variant="secondary">{badge}</Badge>
      <SectionTitle class="mt-4">{title}</SectionTitle>
      <p class="text-muted-foreground mt-4 text-base leading-relaxed text-balance">
        {description}
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        {buttons.map(({ href, label }, index) => (
          <Button
            as="a"
            href={href}
            variant={index === 0 ? "default" : "outline"}
          >
            {label}
          </Button>
        ))}
      </div>
    </div>
    <div class="grid gap-6 sm:grid-cols-2">
      {services.map((service) => (
        <div class="relative isolate flex aspect-[4/3] flex-col justify-end overflow-hidden rounded-xl">
          <Image
            src={service.image?.src ?? PlaceholderImage}
            alt={service.image?.alt ?? ""}
            class="absolute inset-0 -z-10 size-full object-cover"
            widths={[480, 640, 960]}
            sizes="(min-width: 80rem) 612px, (min-width: 40rem) 50vw, 100vw"
          />
          <div class="absolute inset-0 -z-10 bg-gradient-to-t from-black/80 via-black/40 to-transparent" />
          <div class="flex flex-col gap-2 p-6 text-white">
            <h3 class="text-xl font-semibold">{service.title}</h3>
            <p class="text-sm leading-relaxed text-white/80">
              {service.description}
            </p>
            <Button
              as="a"
              href={service.button.href}
              variant="secondary"
              class="mt-2 w-fit"
            >
              {service.button.label}
            </Button>
          </div>
        </div>
      ))}
    </div>
  </SectionContainer>
</Section>
