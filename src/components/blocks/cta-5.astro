---
import type { ImageMetadata } from "astro"
import { Image } from "astro:assets"
import type { HTMLAttributes } from "astro/types"
import { CheckIcon } from "@lucide/astro"

import { cn } from "@/lib/utils"
import { Button } from "@/components/ui/button"
import {
  Section,
  SectionContainer,
  SectionTitle,
} from "@/components/ui/section"
import PlaceholderImage from "@/assets/placeholder.svg"

type Props = HTMLAttributes<"section"> & {
  title: string
  description: string
  features: string[]
  buttons: {
    label: string
    href: string
  }[]
  image?: {
    src: ImageMetadata
    alt: string
  }
}

const {
  class: className,
  title,
  description,
  features,
  buttons,
  image = { src: PlaceholderImage, alt: "" },
  ...props
} = Astro.props
---

<Section class={cn("", className)} {...props}>
  <SectionContainer class="grid gap-12 lg:grid-cols-2 lg:items-center">
    <div class="flex flex-col gap-6">
      <div class="flex flex-col gap-4">
        <SectionTitle class="leading-[1.1]">{title}</SectionTitle>
        <p class="text-muted-foreground text-lg leading-relaxed">
          {description}
        </p>
      </div>
      {features.length > 0 && (
        <ul class="flex flex-col gap-3">
          {features.map((feature) => (
            <li class="flex items-start gap-3 text-sm">
              <CheckIcon class="text-primary mt-0.5 size-4 shrink-0" />
              {feature}
            </li>
          ))}
        </ul>
      )}
      {buttons.length > 0 && (
        <div class="flex flex-wrap gap-3">
          {buttons.map(({ href, label }, index) => (
            <Button
              as="a"
              href={href}
              size="lg"
              variant={index === 0 ? "default" : "outline"}
            >
              {label}
            </Button>
          ))}
        </div>
      )}
    </div>
    <Image
      src={image.src}
      alt={image.alt}
      class="aspect-[4/3] w-full rounded-xl border object-cover"
      widths={[640, 960, 1280]}
      sizes="(min-width: 80rem) 600px, (min-width: 64rem) 50vw, 100vw"
    />
  </SectionContainer>
</Section>
