---
import type { HTMLAttributes } from "astro/types"
import ArrowLeft from "@lucide/astro/icons/arrow-left"
import ArrowRight from "@lucide/astro/icons/arrow-right"
import Check from "@lucide/astro/icons/check"
import ChevronDown from "@lucide/astro/icons/chevron-down"
import Copy from "@lucide/astro/icons/copy"
import ExternalLink from "@lucide/astro/icons/external-link"
import Claude from "simple-icons/icons/claude.svg"
import Cursor from "simple-icons/icons/cursor.svg"
import Markdown from "simple-icons/icons/markdown.svg"

import { cn } from "@/lib/utils"
import { Button, buttonVariants } from "@/components/ui/button"
import {
  Card,
  CardDescription,
  CardFooter,
  CardHeader,
} from "@/components/ui/card"
import {
  DropdownMenu,
  DropdownMenuContent,
  DropdownMenuGroup,
  DropdownMenuItem,
  DropdownMenuTrigger,
} from "@/components/ui/dropdown-menu"
import { SectionContainer } from "@/components/ui/section"
import {
  Toc,
  TocMenu,
  TocMenuItem,
  TocMenuLink,
  TocTitle,
} from "@/components/ui/toc"
import {
  Typography,
  TypographyH1,
  TypographyLead,
} from "@/components/ui/typography"

type Props = HTMLAttributes<"div"> & {
  title: string
  description: string
  copyButton?: {
    id: string
    source: string
  }
  markdownUrl?: string
  tocItems: {
    depth: number
    href: string
    label: string
  }[]
  callout?: {
    description: string
    button: {
      label: string
      href: string
    }
  }
  previousPage?: {
    href: string
    title: string
  }
  nextPage?: {
    href: string
    title: string
  }
  labels: {
    copyMarkdown: string
    openIn: string
    openInMarkdown: string
    openInChatGPT: string
    openInClaude: string
    openInCursor: string
    assistantPrompt: string
    copyCode: string
    pagination: string
    toc: string
  }
}

const {
  class: className,
  title,
  description,
  copyButton,
  markdownUrl,
  tocItems,
  callout,
  previousPage,
  nextPage,
  labels,
  ...props
} = Astro.props
const showCopyButton = Boolean(copyButton)
const showOpenButton = Boolean(markdownUrl)
const showPagination = Boolean(previousPage || nextPage)
const openLinks = markdownUrl
  ? [
      {
        label: labels.openInMarkdown,
        href: markdownUrl,
        icon: "markdown",
      },
      {
        label: labels.openInChatGPT,
        href: `https://chatgpt.com/?hints=search&q=${encodeURIComponent(labels.assistantPrompt)}`,
        icon: "chatgpt",
      },
      {
        label: labels.openInClaude,
        href: `https://claude.ai/new?q=${encodeURIComponent(labels.assistantPrompt)}`,
        icon: "claude",
      },
      {
        label: labels.openInCursor,
        href: `https://cursor.com/link/prompt?text=${encodeURIComponent(labels.assistantPrompt)}`,
        icon: "cursor",
      },
    ]
  : []
---

<SectionContainer
  class={cn(
    "flex flex-col gap-10 pt-10 pb-8 sm:pt-12 sm:pb-10 xl:grid xl:grid-cols-[minmax(0,1fr)_16rem] xl:items-start xl:gap-x-16",
    className
  )}
  {...props}
>
  <div class="mx-auto flex w-full max-w-3xl min-w-0 flex-col gap-10">
    <header class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div class="flex min-w-0 flex-1 flex-col gap-2">
        <TypographyH1
          size="sm"
          class="text-foreground text-left tracking-tight"
        >
          {title}
        </TypographyH1>
        <TypographyLead size="sm" class="max-w-2xl leading-7">
          {description}
        </TypographyLead>
      </div>
      <div class="flex shrink-0 items-center gap-2 self-start">
        {showCopyButton && (
          <Button
            id={copyButton?.id}
            type="button"
            variant="outline"
            size="xs"
            data-source={copyButton?.source}
            data-doc-copy
            aria-label={labels.copyMarkdown}
          >
            <Copy data-copy-icon class="docs-copy-icon size-3.5" />
            <Check data-check-icon class="docs-check-icon hidden size-3.5" />
            <span>{labels.copyMarkdown}</span>
          </Button>
        )}
        {showOpenButton && (
          <DropdownMenu>
            <DropdownMenuTrigger
              class={buttonVariants({ variant: "outline", size: "xs" })}
            >
              <span>{labels.openIn}</span>
              <ChevronDown class="size-3.5 opacity-70" />
            </DropdownMenuTrigger>
            <DropdownMenuContent align="end" sideOffset={6} class="w-56">
              <DropdownMenuGroup>
                {openLinks.map((link) => (
                  <DropdownMenuItem
                    href={link.href}
                    target="_blank"
                    rel="noreferrer noopener"
                  >
                    {link.icon === "markdown" && (
                      <Markdown
                        class="size-4"
                        fill="currentColor"
                        aria-hidden="true"
                      />
                    )}
                    {link.icon === "chatgpt" && (
                      <svg
                        role="img"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        class="size-4"
                        aria-hidden="true"
                      >
                        <path d="M22.282 9.821a5.985 5.985 0 0 0-.516-4.91 6.046 6.046 0 0 0-6.51-2.9A6.065 6.065 0 0 0 4.981 4.182a5.985 5.985 0 0 0-3.998 2.9 6.046 6.046 0 0 0 .743 7.097 5.98 5.98 0 0 0 .511 4.91 6.051 6.051 0 0 0 6.515 2.9A5.985 5.985 0 0 0 13.26 24a6.056 6.056 0 0 0 5.772-4.206 5.989 5.989 0 0 0 3.998-2.9 6.056 6.056 0 0 0-.748-7.073ZM13.26 22.43a4.476 4.476 0 0 1-2.876-1.04l.142-.081 4.778-2.758a.795.795 0 0 0 .393-.681v-6.737l2.02 1.169a.071.071 0 0 1 .038.052v5.583a4.504 4.504 0 0 1-4.495 4.494Zm-9.66-4.125a4.471 4.471 0 0 1-.535-3.014l.142.085 4.783 2.758a.771.771 0 0 0 .781 0l5.843-3.368v2.332a.08.08 0 0 1-.034.062L9.74 19.95a4.499 4.499 0 0 1-6.14-1.646ZM2.34 7.896a4.485 4.485 0 0 1 2.366-1.973V11.6a.766.766 0 0 0 .388.677l5.814 3.354-2.02 1.169a.076.076 0 0 1-.071 0l-4.83-2.787A4.504 4.504 0 0 1 2.34 7.872Zm16.596 3.856-5.833-3.388L15.12 7.2a.076.076 0 0 1 .071 0l4.83 2.791a4.494 4.494 0 0 1-.676 8.104v-5.677a.79.79 0 0 0-.407-.667Zm2.011-3.024-.142-.085-4.774-2.782a.776.776 0 0 0-.785 0L9.409 9.23V6.897a.066.066 0 0 1 .028-.061l4.83-2.787a4.499 4.499 0 0 1 6.68 4.66ZM8.307 12.863l-2.02-1.164a.08.08 0 0 1-.038-.057V6.074a4.499 4.499 0 0 1 7.376-3.453l-.142.08-4.778 2.758a.795.795 0 0 0-.393.681Zm1.097-2.365 2.602-1.5 2.607 1.5v2.999l-2.597 1.5-2.607-1.5Z" />
                      </svg>
                    )}
                    {link.icon === "claude" && (
                      <Claude
                        class="size-4"
                        fill="currentColor"
                        aria-hidden="true"
                      />
                    )}
                    {link.icon === "cursor" && (
                      <Cursor
                        class="size-4"
                        fill="currentColor"
                        aria-hidden="true"
                      />
                    )}
                    <span>{link.label}</span>
                    <ExternalLink class="text-muted-foreground ml-auto size-3.5" />
                  </DropdownMenuItem>
                ))}
              </DropdownMenuGroup>
            </DropdownMenuContent>
          </DropdownMenu>
        )}
      </div>
    </header>

    <Typography
      as="article"
      size="sm"
      data-doc-content
      data-copy-label={labels.copyCode}
    >
      <slot />
    </Typography>

    {showPagination && (
      <nav
        class="flex items-center justify-between gap-3"
        aria-label={labels.pagination}
      >
        {previousPage ? (
          <Button
            as="a"
            href={previousPage.href}
            variant="outline"
            class="h-auto min-w-0 items-center justify-start gap-2 px-3 py-2 whitespace-normal"
          >
            <ArrowLeft class="size-4" />
            <span class="truncate text-sm font-medium">
              {previousPage.title}
            </span>
          </Button>
        ) : (
          <div aria-hidden="true" />
        )}

        {nextPage ? (
          <Button
            as="a"
            href={nextPage.href}
            variant="outline"
            class="h-auto min-w-0 items-center justify-end gap-2 px-3 py-2 text-right whitespace-normal"
          >
            <span class="truncate text-sm font-medium">{nextPage.title}</span>
            <ArrowRight class="size-4" />
          </Button>
        ) : (
          <div aria-hidden="true" />
        )}
      </nav>
    )}
  </div>

  {(tocItems.length > 0 || callout) && (
    <div class="hidden w-64 xl:sticky xl:top-12 xl:mr-0 xl:ml-auto xl:block xl:self-start">
      <div class="flex flex-col gap-6">
        {tocItems.length > 0 && (
          <Toc aria-label={labels.toc}>
            <TocTitle>{labels.toc}</TocTitle>
            <TocMenu>
              {tocItems.map((item) => (
                <TocMenuItem>
                  <TocMenuLink href={item.href} depth={item.depth}>
                    {item.label}
                  </TocMenuLink>
                </TocMenuItem>
              ))}
            </TocMenu>
          </Toc>
        )}

        {callout && (
          <Card size="sm">
            <CardHeader>
              <CardDescription>{callout.description}</CardDescription>
            </CardHeader>
            <CardFooter>
              <Button
                as="a"
                href={callout.button.href}
                variant="outline"
                size="sm"
                target="_blank"
                rel="noreferrer"
              >
                {callout.button.label}
              </Button>
            </CardFooter>
          </Card>
        )}
      </div>
    </div>
  )}
</SectionContainer>

<style is:global>
  .docs-code-block {
    position: relative;
    overflow: hidden;
    margin-block-start: var(--typeset-flow);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: color-mix(in oklab, var(--color-muted) 60%, transparent);
  }

  .docs-code-block > pre,
  .docs-code-block > pre.astro-code {
    margin: 0;
    overflow-x: auto;
    border: 0;
    border-radius: 0;
    background: transparent !important;
    padding: 1rem 3.5rem 1rem 1rem;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: var(--text-sm--line-height);
  }

  .docs-code-block > pre.astro-code code {
    color: var(--shiki-light, var(--color-foreground)) !important;
    font: inherit;
  }

  .dark .docs-code-block > pre.astro-code code {
    color: var(--shiki-dark, var(--color-foreground)) !important;
  }

  .dark .docs-code-block > pre.astro-code span[style*="--shiki-dark"] {
    color: var(--shiki-dark) !important;
    font-style: var(--shiki-dark-font-style, inherit) !important;
    font-weight: var(--shiki-dark-font-weight, inherit) !important;
    text-decoration: var(--shiki-dark-text-decoration, inherit) !important;
  }

  .docs-code-copy {
    position: absolute;
    z-index: 10;
    top: 0.75rem;
    right: 0.75rem;
    display: inline-flex;
    width: 2rem;
    height: 2rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-background);
    color: var(--color-muted-foreground);
    box-shadow: var(--shadow-sm);
    transition:
      color 150ms,
      background-color 150ms;
  }

  .docs-code-copy:hover {
    background: var(--color-accent);
    color: var(--color-accent-foreground);
  }

  .docs-code-copy:focus-visible {
    outline: 2px solid var(--color-ring);
    outline-offset: 2px;
  }

  .docs-code-copy svg {
    width: 1rem;
    height: 1rem;
  }
</style>

<script>
  const copyIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>`
  const checkIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>`
  const initializeCodeBlocks = () => {
    document
      .querySelectorAll<HTMLElement>("[data-doc-content]")
      .forEach((content) => {
        content.querySelectorAll(":scope > pre").forEach((pre) => {
          if (pre.closest(".docs-code-block")) return
          const wrapper = document.createElement("div")
          const button = document.createElement("button")
          wrapper.className = "docs-code-block"
          wrapper.dataset.notTypeset = ""
          button.type = "button"
          button.className = "docs-code-copy"
          button.ariaLabel = content.dataset.copyLabel ?? null
          button.innerHTML = `<span data-copy-icon>${copyIcon}</span><span data-check-icon class="hidden">${checkIcon}</span>`
          pre.before(wrapper)
          wrapper.append(pre, button)
        })
      })
  }

  initializeCodeBlocks()
  document.addEventListener("astro:page-load", initializeCodeBlocks)

  document.addEventListener("click", async (event) => {
    if (!(event.target instanceof Element)) return
    const button = event.target.closest(
      "[data-doc-copy], [data-doc-content] .docs-code-copy"
    )
    if (!(button instanceof HTMLButtonElement)) return
    const source =
      button.dataset.source ??
      button
        .closest(".docs-code-block")
        ?.querySelector("pre")
        ?.textContent?.replace(/\n$/, "")

    try {
      await navigator.clipboard.writeText(source ?? "")
      button.querySelector("[data-copy-icon]")?.classList.add("hidden")
      button.querySelector("[data-check-icon]")?.classList.remove("hidden")
      setTimeout(() => {
        button.querySelector("[data-copy-icon]")?.classList.remove("hidden")
        button.querySelector("[data-check-icon]")?.classList.add("hidden")
      }, 1200)
    } catch {
      // Keep the copy state unchanged so the action can be retried.
    }
  })
</script>
