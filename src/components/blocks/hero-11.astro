---
import type { ImageMetadata } from "astro"
import { Image } from "astro:assets"
import type { HTMLAttributes } from "astro/types"

import { cn } from "@/lib/utils"
import {
  Avatar,
  AvatarFallback,
  AvatarGroup,
  AvatarImage,
} from "@/components/ui/avatar"
import { Button } from "@/components/ui/button"
import { Rating } from "@/components/ui/rating"
import { Section, SectionContainer } from "@/components/ui/section"

type Props = HTMLAttributes<"section"> & {
  title: string
  description: string
  buttons: {
    label: string
    href: string
  }[]
  socialProof: {
    avatars: {
      image?: ImageMetadata
      initials: string
    }[]
    rating: number
    ratingLabel: string
    text: string
  }
  image: {
    src: ImageMetadata
  }
}

const {
  class: className,
  title,
  description,
  buttons,
  socialProof,
  image,
  ...props
} = Astro.props
---

<Section
  class={cn("dark bg-background min-h-screen justify-center", className)}
  {...props}
>
  <SectionContainer class="flex flex-col relative z-10 items-center gap-8 text-center">
    <h1 class="text-foreground max-w-3xl text-4xl leading-[1.1] font-semibold tracking-tight text-balance sm:text-5xl lg:text-6xl">
      {title}
    </h1>
    <p class="text-foreground/80 max-w-2xl text-lg leading-relaxed text-balance">
      {description}
    </p>
    <div class="flex flex-wrap justify-center gap-3">
      {buttons.map(({ href, label }, index) => (
        <Button
          as="a"
          href={href}
          size="lg"
          variant={index === 0 ? "default" : "secondary"}
        >
          {label}
        </Button>
      ))}
    </div>
    <div class="flex items-center gap-3">
      <AvatarGroup aria-hidden="true">
        {socialProof.avatars.map((avatar) => (
          <Avatar class="ring-background size-11 ring">
            <AvatarImage src={avatar.image} />
            <AvatarFallback>{avatar.initials}</AvatarFallback>
          </Avatar>
        ))}
      </AvatarGroup>
      <div class="flex flex-col gap-0.5">
        <Rating
          value={socialProof.rating}
          aria-label={socialProof.ratingLabel}
        />
        <span class="text-muted-foreground text-xs">{socialProof.text}</span>
      </div>
    </div>
  </SectionContainer>
  <div class="bg-background pointer-events-none absolute inset-0 mask-y-from-0% mask-y-to-100%">
    <Image
      src={image.src}
      alt=""
      class="size-full object-cover opacity-75"
      widths={[640, 960, 1280, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
  </div>
</Section>
