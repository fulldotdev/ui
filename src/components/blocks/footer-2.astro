---
import type { HTMLAttributes } from "astro/types"
import Discord from "simple-icons/icons/discord.svg"
import Github from "simple-icons/icons/github.svg"
import X from "simple-icons/icons/x.svg"

import { cn } from "@/lib/utils"
import { Logo, LogoText } from "@/components/ui/logo"
import { Section, SectionContainer } from "@/components/ui/section"
import { Separator } from "@/components/ui/separator"

type Props = HTMLAttributes<"footer"> & {
  brandName: string
  brandHref: string
  description: string
  links?: {
    label: string
    href: string
  }[]
  socials?: {
    label: string
    href: string
    icon: string
  }[]
  copyright: string
  navigationLabel?: string
}

const {
  class: className,
  brandName,
  brandHref,
  description,
  links,
  socials,
  copyright,
  navigationLabel = "Footer navigation",
  ...props
} = Astro.props

const iconMap: Record<string, any> = {
  github: Github,
  discord: Discord,
  x: X,
}
---

<footer class={cn("", className)} {...props}>
  <Section class="py-12 lg:py-16">
    <SectionContainer class="items-center text-center">
      <Logo href={brandHref}>
        <LogoText>{brandName}</LogoText>
      </Logo>
      <p class="text-muted-foreground max-w-md text-sm leading-relaxed">
        {description}
      </p>
      {
        links && links.length > 0 && (
          <nav
            aria-label={navigationLabel}
            class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2"
          >
            {links.map((link) => (
              <a
                href={link.href}
                class="text-muted-foreground hover:text-foreground text-sm transition-colors"
              >
                {link.label}
              </a>
            ))}
          </nav>
        )
      }
      {
        socials && socials.length > 0 && (
          <div class="flex items-center justify-center gap-3">
            {socials.map((social) => {
              const IconComp = iconMap[social.icon]
              return (
                <a
                  href={social.href}
                  class="text-muted-foreground hover:text-foreground transition-colors"
                  aria-label={social.label}
                  target="_blank"
                  rel="noreferrer"
                >
                  {IconComp && (
                    <IconComp
                      class="size-4"
                      fill="currentColor"
                      aria-hidden="true"
                    />
                  )}
                </a>
              )
            })}
          </div>
        )
      }
      <Separator />
      <p class="text-muted-foreground text-sm">{copyright}</p>
    </SectionContainer>
  </Section>
</footer>
