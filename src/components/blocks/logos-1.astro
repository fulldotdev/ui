---
import type { HTMLAttributes } from "astro/types"

import { cn } from "@/lib/utils"
import { Logo, LogoText } from "@/components/ui/logo"
import {
  Section,
  SectionContainer,
  SectionDescription,
  SectionTitle,
} from "@/components/ui/section"

type Props = HTMLAttributes<"section"> & {
  title: string
  description?: string
  brands: {
    name: string
    href?: string
  }[]
}

const { class: className, title, description, brands, ...props } = Astro.props
---

<Section class={cn("", className)} {...props}>
  <SectionContainer class="items-center gap-10 text-center">
    <div class="flex max-w-2xl flex-col items-center gap-4">
      <SectionTitle>
        {title}
      </SectionTitle>
      {description && <SectionDescription>{description}</SectionDescription>}
    </div>
    <div
      class="text-muted-foreground flex w-full flex-wrap items-center justify-center gap-x-12 gap-y-6"
    >
      {
        brands.map((brand) => (
          <Logo
            class="hover:text-foreground grayscale transition-all hover:grayscale-0"
            href={brand.href}
          >
            <LogoText>{brand.name}</LogoText>
          </Logo>
        ))
      }
    </div>
  </SectionContainer>
</Section>
