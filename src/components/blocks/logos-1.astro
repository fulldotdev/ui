---
import type { HTMLAttributes } from "astro/types"

import { cn } from "@/lib/utils"
import { Logo, LogoText } from "@/components/ui/logo"
import {
  Section,
  SectionContainer,
  SectionDescription,
  SectionTitle,
} from "@/components/ui/section"

type Props = HTMLAttributes<"section"> & {
  title: string
  description: string
  brands: {
    name: string
    href?: string
  }[]
}

const { class: className, title, description, brands, ...props } = Astro.props
---

<Section class={cn("", className)} {...props}>
  <SectionContainer class="flex flex-col items-center gap-10 text-center">
    <div class="flex max-w-2xl flex-col items-center gap-4">
      <SectionTitle>{title}</SectionTitle>
      <SectionDescription>{description}</SectionDescription>
    </div>
    <ul class="text-muted-foreground flex w-full flex-wrap items-center justify-center gap-x-12 gap-y-6">
      {brands.map((brand) => (
        <li>
          <Logo
            class={cn(
              brand.href != null &&
                "hover:text-foreground transition-colors focus-visible:text-foreground"
            )}
            href={brand.href}
          >
            <LogoText>{brand.name}</LogoText>
          </Logo>
        </li>
      ))}
    </ul>
  </SectionContainer>
</Section>
