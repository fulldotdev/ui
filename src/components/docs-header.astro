---
// Docs only: the header of ui.shadcn.com, built from Fulldev UI components.
// It turns to glass when the preset's menus are translucent. Below lg the
// navigation moves into a drawer from the bottom with the slot "menu".
import PlusIcon from "@lucide/astro/icons/plus"

import { markPaths, markViewBox } from "@/lib/brand-mark"
import { Button } from "@/components/ui/button"
import {
  Drawer,
  DrawerContent,
  DrawerDescription,
  DrawerHeader,
  DrawerTitle,
  DrawerTrigger,
} from "@/components/ui/drawer"
import { Icon } from "@/components/ui/icon"
import { Logo, LogoText } from "@/components/ui/logo"
import { Separator } from "@/components/ui/separator"
import { ThemeToggle } from "@/components/ui/theme-toggle"

type Props = {
  logo: { label: string; href: string; alt?: string }
  navigation: {
    label: string
    href: string
    reactHref?: string
    liquidHref?: string
  }[]
  button: { label: string; href: string }
  githubRepo: string
  githubStars?: string
  labels: {
    navigation: string
    menu: string
    menuTitle: string
    github: string
    theme: string
  }
}

const { logo, navigation, button, githubRepo, githubStars, labels } =
  Astro.props
const currentPath = Astro.url.pathname
const isCurrent = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href)
---

<header class="bg-background sticky top-0 z-50 w-full in-[[data-menu-color$=translucent]]:bg-background/70 in-[[data-menu-color$=translucent]]:backdrop-blur-2xl in-[[data-menu-color$=translucent]]:backdrop-saturate-150">
  <div class="flex h-14 items-center gap-2 px-4 lg:h-16 lg:px-6">
    <Logo
      href={logo.href}
      aria-label={`Fulldev ${logo.label}`}
      class="mr-3 gap-2"
    >
      {/* The logo tile of the full.dev websites (fulldotdev/fulldev
          packages/web, .logo-tile): open source orange with a sheen, a light rim
          and a soft shadow, a squircle where the browser has corner-shape. */}
      <span class="grid size-7 flex-none place-items-center rounded-[5.292px] bg-(--fd-brand) bg-[image:linear-gradient(rgb(255_255_255/0.17),rgb(255_255_255/0)_55%)] text-white shadow-[inset_0_0_0_1px_rgb(255_255_255/0.14),inset_0_1px_0_rgb(255_255_255/0.34),0_1px_2px_color-mix(in_srgb,var(--fd-brand)_30%,transparent),0_3px_8px_-3px_color-mix(in_srgb,var(--fd-brand)_45%,transparent)] supports-[corner-shape:squircle]:rounded-[9.408px] supports-[corner-shape:squircle]:[corner-shape:squircle]">
        <svg
          viewBox={markViewBox}
          class="block h-[68%] w-[34%] fill-current"
          overflow="visible"
          aria-hidden="true"
        >
          {markPaths.map((d) => (
            <path d={d} />
          ))}
        </svg>
      </span>
      <LogoText class="docs-wordmark">
        <span>Fulldev</span>
        <span>{logo.label}</span>
      </LogoText>
    </Logo>
    <nav aria-label={labels.navigation} class="hidden items-center lg:flex">
      {navigation.map((item) => (
        <Button
          as="a"
          href={item.href}
          variant="ghost"
          size="sm"
          data-react-href={item.reactHref}
          data-liquid-href={item.liquidHref}
        >
          {item.label}
        </Button>
      ))}
    </nav>
    <div class="ml-auto flex items-center gap-1 sm:gap-2">
      <slot name="search" />
      <Separator orientation="vertical" class="my-auto hidden h-4 sm:block" />
      <Button
        as="a"
        href={`https://github.com/${githubRepo}`}
        size="sm"
        variant="ghost"
        class="hidden sm:inline-flex"
      >
        <Icon name="github" />
        <span class="sr-only">{labels.github}</span>
        <span
          class="text-muted-foreground text-xs tabular-nums empty:hidden"
          data-github-stars={githubStars ? undefined : githubRepo}
        >
          {githubStars}
        </span>
      </Button>
      <Separator orientation="vertical" class="my-auto hidden h-4 sm:block" />
      <ThemeToggle aria-label={labels.theme} size="icon" class="lg:size-8" />
      <Separator orientation="vertical" class="my-auto hidden h-4 lg:block" />
      <Button
        as="a"
        href={button.href}
        size="sm"
        variant="secondary"
        class="hidden lg:inline-flex"
      >
        <PlusIcon data-icon="inline-start" />
        {button.label}
      </Button>
      <Drawer class="lg:hidden" data-docs-menu>
        <DrawerTrigger
          variant="ghost"
          size="icon"
          class="-mr-1.5 [&_svg]:size-5.5"
          aria-label={labels.menu}
        >
          <Icon name="menu" />
        </DrawerTrigger>
        <DrawerContent showSwipeHandle data-docs-menu-content>
          <DrawerHeader class="sr-only">
            <DrawerTitle>{labels.menuTitle}</DrawerTitle>
            <DrawerDescription>{labels.navigation}</DrawerDescription>
          </DrawerHeader>
          <div class="flex flex-col gap-8 px-6 pt-4 pb-[max(2.5rem,env(safe-area-inset-bottom))]">
            <nav aria-label={labels.menuTitle} class="flex flex-col gap-1">
              {navigation.map((item) => (
                <a
                  href={item.href}
                  data-react-href={item.reactHref}
                  data-liquid-href={item.liquidHref}
                  aria-current={isCurrent(item.href) ? "page" : undefined}
                  class="text-foreground aria-[current=page]:text-primary -mx-2 rounded-md px-2 py-2 text-xl font-medium"
                >
                  {item.label}
                </a>
              ))}
            </nav>
            <slot name="menu" />
          </div>
        </DrawerContent>
      </Drawer>
    </div>
  </div>
</header>

<script>
  // The menu opens at the current page in the docs navigation.
  document.addEventListener("drawer:change", (event) => {
    const drawer = event.target
    if (!(drawer instanceof Element) || !drawer.matches("[data-docs-menu]"))
      return
    if (!(event as CustomEvent<{ open: boolean }>).detail.open) return
    requestAnimationFrame(() =>
      document
        .querySelector(
          "[data-docs-menu-content] a[data-slot=button][aria-current=page]"
        )
        ?.scrollIntoView({ block: "center" })
    )
  })

  // When the build could not read the star count, read it in the browser
  // and keep it for a day.
  const KEY = "fulldev-ui-github-stars"
  const element = document.querySelector<HTMLElement>("[data-github-stars]")
  const repo = element?.dataset.githubStars
  if (element && repo) {
    const show = (stars: number) =>
      (element.textContent = new Intl.NumberFormat("en").format(stars))
    const cached = JSON.parse(localStorage.getItem(KEY) ?? "null")
    if (cached && Date.now() - cached.time < 86_400_000) show(cached.stars)
    else
      fetch(`https://api.github.com/repos/${repo}`)
        .then((response) => (response.ok ? response.json() : undefined))
        .then((data) => {
          if (typeof data?.stargazers_count !== "number") return
          localStorage.setItem(
            KEY,
            JSON.stringify({ stars: data.stargazers_count, time: Date.now() })
          )
          show(data.stargazers_count)
        })
        .catch(() => {})
  }
</script>
