---
import { getEntry, render, type CollectionEntry } from "astro:content"
import { layouts } from "@/layouts"

import { validatePageLinks } from "@/lib/page-paths"
import { getPageContext, getPages } from "@/lib/pages"

type Props = CollectionEntry<"pages">
const entry = Astro.props
const { Content, headings } = await render(entry)
const context = await getPageContext(entry)
const global = await getEntry("globals", context.locale)
if (!global) throw new Error(`Add src/content/globals/${context.locale}.yaml.`)
validatePageLinks(global.data, await getPages(), `globals/${context.locale}`)
const Layout = layouts[entry.data.type]
---

<Layout
  global={global.data}
  page={entry.data}
  entry={entry}
  context={context}
  headings={headings}
>
  <Content />
</Layout>
