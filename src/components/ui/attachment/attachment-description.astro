---
import type { HTMLAttributes } from "astro/types"

import { cn } from "@/lib/utils"

type Props = HTMLAttributes<"span">

const { class: className, ...props } = Astro.props
---

<span
  data-slot="attachment-description"
  class={cn(
    "cn-attachment-description text-muted-foreground group-data-[state=error]/attachment:text-destructive/80 block max-w-full min-w-0 truncate",
    className
  )}
  {...props}
>
  <slot />
</span>
