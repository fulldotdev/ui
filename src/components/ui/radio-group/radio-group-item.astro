---
import type { HTMLAttributes } from "astro/types"

import { cn } from "@/lib/utils"

type Props = HTMLAttributes<"span"> & {
  value: string
  disabled?: boolean
  indicatorClass?: string
}

const {
  class: className,
  value,
  disabled,
  indicatorClass,
  ...props
} = Astro.props
---

<span
  data-slot="radio-group-item"
  data-value={value}
  data-disabled={disabled ? "" : undefined}
  class={cn(
    "cn-radio-group-item group/radio-group-item peer relative aspect-square shrink-0 border outline-none after:absolute after:-inset-x-3 after:-inset-y-2 data-disabled:cursor-not-allowed data-disabled:opacity-50",
    className
  )}
  {...props}
>
  <span
    aria-hidden="true"
    data-slot="radio-group-indicator"
    class={cn(
      "cn-radio-group-indicator opacity-0 group-data-checked/radio-group-item:opacity-100",
      indicatorClass
    )}
  >
    <span class="cn-radio-group-indicator-icon"></span>
  </span>
</span>
