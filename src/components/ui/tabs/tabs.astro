---
import type { HTMLAttributes } from "astro/types"

import { cn } from "@/lib/utils"

type Props = HTMLAttributes<"div"> & {
  defaultValue?: string
  orientation?: "horizontal" | "vertical"
  activationMode?: "auto" | "manual"
}

const {
  class: className,
  defaultValue,
  orientation = "horizontal",
  activationMode,
  ...props
} = Astro.props

// Show the initial panel in the HTML, the one Data Slot selects: the default
// value or the first enabled trigger. TabsContent renders hidden, so without
// this the page shifts when the script starts.
const html = await Astro.slots.render("default")
const decode = (value: string) =>
  value.replace(/&(#\d+|amp|lt|gt|quot|apos);/g, (_, entity: string) =>
    entity.startsWith("#")
      ? String.fromCharCode(Number(entity.slice(1)))
      : { amp: "&", lt: "<", gt: ">", quot: '"', apos: "'" }[entity]!
  )
const trigger = [
  ...html.matchAll(/<button\b[^>]*data-slot="tabs-trigger"[^>]*>/g),
]
  .map(([tag]) => tag)
  .find((tag) => !/\sdisabled\b/.test(tag))
  ?.match(/data-value="([^"]*)"/)?.[1]
const initial =
  defaultValue ?? (trigger === undefined ? undefined : decode(trigger))
let shown = false
const content = html.replace(
  /data-slot="tabs-content" hidden data-value="([^"]*)"/g,
  (panel, value: string) => {
    if (shown || decode(value) !== initial) return panel
    shown = true
    return `data-slot="tabs-content" data-value="${value}"`
  }
)
---

<div
  data-slot="tabs"
  data-default-value={defaultValue}
  data-orientation={orientation}
  data-activation-mode={activationMode}
  data-horizontal={orientation === "horizontal" ? "" : undefined}
  data-vertical={orientation === "vertical" ? "" : undefined}
  class={cn("cn-tabs group/tabs flex data-horizontal:flex-col", className)}
  {...props}
>
  <Fragment set:html={content} />
</div>

<script>
  import { create } from "@data-slot/tabs"

  const controllers: ReturnType<typeof create> = []
  const initialize = () => controllers.push(...create())
  initialize()
  document.addEventListener("astro:page-load", initialize)
  document.addEventListener("astro:before-swap", () => {
    for (const controller of controllers) controller.destroy()
    controllers.length = 0
  })
</script>
