---
import type { HTMLAttributes } from "astro/types"
import ChevronDownIcon from "@lucide/astro/icons/chevron-down"
import ChevronUpIcon from "@lucide/astro/icons/chevron-up"

import { cn } from "@/lib/utils"

type Props = HTMLAttributes<"button">

const { class: className, type = "button", ...props } = Astro.props
---

<button
  data-slot="accordion-trigger"
  type={type}
  class={cn(
    "cn-accordion-trigger group/accordion-trigger relative flex w-full flex-1 items-start justify-between border border-transparent bg-transparent transition-all outline-none aria-disabled:pointer-events-none aria-disabled:opacity-50",
    className
  )}
  {...props}
>
  <slot />
  <ChevronDownIcon
    data-slot="accordion-trigger-icon"
    aria-hidden="true"
    class="pointer-events-none shrink-0 group-aria-expanded/accordion-trigger:hidden"
  />
  <ChevronUpIcon
    data-slot="accordion-trigger-icon"
    aria-hidden="true"
    class="pointer-events-none hidden shrink-0 group-aria-expanded/accordion-trigger:inline"
  />
</button>
