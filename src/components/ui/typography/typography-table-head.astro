---
import type { HTMLAttributes } from "astro/types"

import { cn } from "@/lib/utils"

type Size = "sm" | "default" | "lg"
type Props = HTMLAttributes<"th"> & {
  size?: Size
}

const { class: className, size = "default", ...props } = Astro.props

const sizeClass =
  size === "sm" ? "text-sm" : size === "lg" ? "text-lg" : "text-base"
---

<th
  data-slot="typography-table-head"
  data-size={size}
  class={cn(
    "border-border border-b px-4 py-3 text-start font-semibold",
    "[&[align=left]]:text-left [&[align=center]]:text-center [&[align=right]]:text-right",
    sizeClass,
    className
  )}
  {...props}
>
  <slot />
</th>
