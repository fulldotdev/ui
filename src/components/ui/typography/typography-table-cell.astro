---
import type { HTMLAttributes } from "astro/types"

import { cn } from "@/lib/utils"

type Size = "sm" | "default" | "lg"
type Props = HTMLAttributes<"td"> & {
  size?: Size
}

const { class: className, size = "default", ...props } = Astro.props

const sizeClass =
  size === "sm" ? "text-sm" : size === "lg" ? "text-lg" : "text-base"
---

<td
  data-slot="typography-table-cell"
  data-size={size}
  class={cn(
    "border-border border-t px-4 py-3 text-start align-middle",
    "[&[align=left]]:text-left [&[align=center]]:text-center [&[align=right]]:text-right",
    sizeClass,
    className
  )}
  {...props}
>
  <slot />
</td>
