---
import type { HTMLTag, Polymorphic } from "astro/types"

import { cn } from "@/lib/utils"

type Props<Tag extends HTMLTag = "h2"> = Polymorphic<{ as: Tag }>

const { as: Tag = "h2", class: className, ...props } = Astro.props
---

<Tag
  data-slot="section-title"
  class={cn("cn-section-title text-foreground text-balance", className)}
  {...props}
>
  <slot />
</Tag>
