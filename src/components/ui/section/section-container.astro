---
import type { HTMLAttributes } from "astro/types"

import { cn } from "@/lib/utils"

type Props = HTMLAttributes<"div">

const {
  class: className,
  "data-slot": dataSlot = "section-container",
  ...props
} = Astro.props
---

<div
  data-slot={dataSlot}
  class={cn(
    "relative mx-auto flex w-full max-w-[var(--container,1280px)] flex-col gap-8 px-[var(--gutter,1rem)]",
    className
  )}
  {...props}
>
  <slot />
</div>
