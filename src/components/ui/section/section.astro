---
import type { HTMLAttributes } from "astro/types"
import { cva, type VariantProps } from "class-variance-authority"

import { cn } from "@/lib/utils"

type Props = HTMLAttributes<"section"> & VariantProps<typeof variants>

const variants = cva("cn-section relative flex scroll-mt-12 flex-col", {
  variants: {
    variant: {
      default: "bg-background w-full",
      floating:
        "cn-section-variant-floating mx-auto w-[calc(100%-2*var(--gutter,1rem))] max-w-[calc(var(--container,1280px)-2*var(--gutter,1rem))] overflow-hidden",
    },
  },
  defaultVariants: {
    variant: "default",
  },
})

const { class: className, variant, ...props } = Astro.props
---

<section
  class={cn(variants({ variant }), className)}
  data-slot="section"
  data-variant={variant}
  {...props}
>
  <slot />
</section>
