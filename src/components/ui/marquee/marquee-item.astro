---
import type { HTMLAttributes } from "astro/types"

import { cn } from "@/lib/utils"

type Props = HTMLAttributes<"div">

const {
  class: className,
  "data-slot": dataSlot = "marquee-item",
  ...props
} = Astro.props
---

<div
  data-slot={dataSlot}
  class={cn(
    "min-w-0 shrink-0 grow-0 ps-[var(--marquee-gap,--spacing(4))]",
    className
  )}
  {...props}
>
  <slot />
</div>
