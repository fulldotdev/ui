---
import type { HTMLAttributes } from "astro/types"
import CheckIcon from "@lucide/astro/icons/check"

import { cn } from "@/lib/utils"

type Props = HTMLAttributes<"div"> & {
  value?: string
  disabled?: boolean
  showIndicator?: boolean
}

const {
  class: className,
  value,
  disabled,
  showIndicator = true,
  ...props
} = Astro.props
---

<div
  data-slot="combobox-item"
  data-value={value}
  data-disabled={disabled ? "" : undefined}
  class={cn(
    "cn-combobox-item group/combobox-item data-highlighted:**:[svg]:text-accent-foreground relative flex w-full cursor-default items-center outline-hidden select-none data-disabled:pointer-events-none data-disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0",
    className
  )}
  {...props}
>
  <slot />
  {showIndicator && (
    <span
      data-slot="combobox-item-indicator"
      hidden={false}
      class="cn-combobox-item-indicator opacity-0 group-data-selected/combobox-item:opacity-100"
    >
      <CheckIcon class="pointer-events-none" />
    </span>
  )}
</div>
