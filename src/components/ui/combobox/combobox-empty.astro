---
import type { HTMLAttributes } from "astro/types"

import { cn } from "@/lib/utils"

type Props = HTMLAttributes<"div">

// The content's data-empty CSS also supports an empty message beside ComboboxList.
// Data Slot only manages native hidden when the message is inside that list.
const { class: className, hidden = false, ...props } = Astro.props
---

<div
  data-slot="combobox-empty"
  hidden={hidden}
  class={cn(
    "text-muted-foreground hidden w-full items-center justify-center py-2 text-center text-sm group-data-empty/combobox-content:flex",
    className
  )}
  {...props}
>
  <slot>No results found.</slot>
</div>
