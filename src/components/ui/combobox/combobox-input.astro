---
import type { HTMLAttributes } from "astro/types"
import XIcon from "@lucide/astro/icons/x"

import { cn } from "@/lib/utils"
import {
  InputGroup,
  InputGroupAddon,
  InputGroupButton,
  InputGroupInput,
} from "@/components/ui/input-group"

import ComboboxTrigger from "./combobox-trigger.astro"

type Props = HTMLAttributes<"input"> & {
  showTrigger?: boolean
  showClear?: boolean
}

const {
  class: className,
  type = "text",
  disabled = false,
  showTrigger = true,
  showClear = false,
  ...props
} = Astro.props
---

<InputGroup
  class={cn(
    "has-[[data-slot=combobox-input]:focus-visible]:border-ring has-[[data-slot=combobox-input]:focus-visible]:ring-ring/50 w-auto has-[[data-slot=combobox-input]:focus-visible]:ring-3",
    className
  )}
>
  <InputGroupInput
    type={type}
    data-slot="combobox-input"
    disabled={disabled}
    {...props}
  />
  <InputGroupAddon align="inline-end">
    {showTrigger && (
      <ComboboxTrigger
        class="group-has-data-[slot=combobox-clear]/input-group:hidden data-pressed:bg-transparent"
        disabled={disabled}
      />
    )}
    {showClear && (
      <InputGroupButton
        type="button"
        variant="ghost"
        size="icon-xs"
        data-slot="combobox-clear"
        disabled={disabled}
      >
        <XIcon class="pointer-events-none" />
      </InputGroupButton>
    )}
  </InputGroupAddon>
  <slot />
</InputGroup>
