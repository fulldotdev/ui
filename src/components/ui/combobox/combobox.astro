---
import type { HTMLAttributes } from "astro/types"
import type {
  Align as ComboboxAlign,
  Side as ComboboxSide,
} from "@data-slot/combobox"

import { cn } from "@/lib/utils"

type Props = HTMLAttributes<"div"> & {
  defaultValue?: string
  defaultOpen?: boolean
  placeholder?: string
  disabled?: boolean
  required?: boolean
  name?: string
  openOnFocus?: boolean
  autoHighlight?: boolean
  side?: ComboboxSide
  align?: ComboboxAlign
  sideOffset?: number
  alignOffset?: number
  avoidCollisions?: boolean
  collisionPadding?: number
}

const {
  class: className,
  defaultValue,
  defaultOpen,
  placeholder,
  disabled,
  required,
  name,
  openOnFocus,
  autoHighlight,
  side,
  align,
  sideOffset,
  alignOffset,
  avoidCollisions,
  collisionPadding,
  ...props
} = Astro.props
---

<div
  data-slot="combobox"
  data-default-value={defaultValue}
  data-default-open={defaultOpen}
  data-placeholder={placeholder}
  data-disabled={disabled}
  data-required={required}
  data-name={name}
  data-open-on-focus={openOnFocus}
  data-auto-highlight={autoHighlight}
  data-side={side}
  data-align={align}
  data-side-offset={sideOffset}
  data-align-offset={alignOffset}
  data-avoid-collisions={avoidCollisions}
  data-collision-padding={collisionPadding}
  class={cn("group/combobox relative", className)}
  {...props}
>
  <slot />
</div>

<script>
  import { createCombobox } from "@data-slot/combobox"
  import { getPart } from "@data-slot/core"

  import { initializeDataSlot } from "@/lib/data-slot"

  initializeDataSlot("combobox", (root) => {
    if (!getPart(root, "combobox-input") || !getPart(root, "combobox-content"))
      return
    return createCombobox(root)
  })
</script>
