---
import type { HTMLAttributes } from "astro/types"
import ChevronDownIcon from "@lucide/astro/icons/chevron-down"

import { cn } from "@/lib/utils"
import { InputGroupButton } from "@/components/ui/input-group"

type Props = HTMLAttributes<"button"> & {
  showIcon?: boolean
}

const {
  class: className,
  type = "button",
  showIcon = true,
  ...props
} = Astro.props

// Data Slot names the trigger "Toggle" when it starts. Name it the same in the
// HTML, so it has a name before the script runs.
---

<InputGroupButton
  type={type ?? "button"}
  variant="ghost"
  size="icon-xs"
  data-slot="combobox-trigger"
  class={cn("[&_svg]:text-muted-foreground", className)}
  aria-label="Toggle"
  {...props}
>
  <slot />
  {showIcon && (
    <ChevronDownIcon class="cn-combobox-trigger-icon pointer-events-none" />
  )}
</InputGroupButton>
