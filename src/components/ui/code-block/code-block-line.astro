---
import type { HTMLAttributes } from "astro/types"
import { cva, type VariantProps } from "class-variance-authority"

import { cn } from "@/lib/utils"

const variants = cva(
  "cn-code-block-line relative block min-h-lh before:select-none after:absolute after:top-0 after:select-none in-data-numbered:col-span-2 in-data-numbered:grid in-data-numbered:grid-cols-subgrid in-data-numbered:[counter-increment:line] in-data-numbered:before:content-[counter(line)] in-data-numbered:supports-[content:counter(line)_/_'']:before:content-[counter(line)_/_'']",
  {
    variants: {
      variant: {
        default: "",
        added: "cn-code-block-line-variant-added",
        removed: "cn-code-block-line-variant-removed",
        highlighted: "cn-code-block-line-variant-highlighted",
      },
    },
    defaultVariants: { variant: "default" },
  }
)

type Props = HTMLAttributes<"span"> & VariantProps<typeof variants>
const { class: className, variant = "default", ...props } = Astro.props
---

<span
  data-slot="code-block-line"
  data-variant={variant}
  class={cn(variants({ variant }), className)}
  {...props}
>
  <span data-slot="code-block-line-content" class="min-w-0">
    <slot />
    {"\n"}
  </span>
</span>
