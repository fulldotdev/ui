---
import type { HTMLAttributes } from "astro/types"

import { cn } from "@/lib/utils"

type Props = HTMLAttributes<"span">

const { class: className, ...props } = Astro.props
---

<span
  data-slot="breadcrumb-page"
  aria-current="page"
  class={cn("cn-breadcrumb-page", className)}
  {...props}
>
  <slot />
</span>
