---
import type { HTMLAttributes } from "astro/types"

import { cn } from "@/lib/utils"

type Props = HTMLAttributes<"nav">

const {
  class: className,
  "aria-label": ariaLabel = "breadcrumb",
  ...props
} = Astro.props
---

<nav
  aria-label={ariaLabel}
  data-slot="breadcrumb"
  class={cn(className)}
  {...props}
>
  <slot />
</nav>
