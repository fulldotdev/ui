---
import type { HTMLAttributes } from "astro/types"
import type { TooltipAlign, TooltipSide } from "@data-slot/tooltip"
import { cva, type VariantProps } from "class-variance-authority"

import { cn } from "@/lib/utils"
import {
  Tooltip,
  TooltipContent,
  TooltipTrigger,
} from "@/components/ui/tooltip"

// Keep Props above the cva() call. Astro's compiler does not find Props when a
// Tailwind child selector string comes first, and then leaves the props untyped.
type TooltipValue =
  | string
  | (HTMLAttributes<"div"> & {
      content?: string
      children?: string
      side?: TooltipSide
      align?: TooltipAlign
      sideOffset?: number
      alignOffset?: number
      avoidCollisions?: boolean
      collisionPadding?: number
    })

type Props = VariantProps<typeof variants> &
  HTMLAttributes<"button"> &
  HTMLAttributes<"a"> &
  HTMLAttributes<"div"> &
  HTMLAttributes<"span"> & {
    as?: "a" | "button" | "div" | "span"
    href?: string
    isActive?: boolean
    active?: boolean
    tooltip?: TooltipValue
  }

const variants = cva(
  "cn-sidebar-menu-button peer/menu-button group/menu-button flex w-full items-center overflow-hidden outline-hidden disabled:pointer-events-none disabled:opacity-50 aria-disabled:pointer-events-none aria-disabled:opacity-50 [&_svg]:size-4 [&_svg]:shrink-0 [&>span:last-child]:truncate",
  {
    variants: {
      variant: {
        default: "cn-sidebar-menu-button-variant-default",
        outline: "cn-sidebar-menu-button-variant-outline",
      },
      size: {
        default: "cn-sidebar-menu-button-size-default",
        sm: "cn-sidebar-menu-button-size-sm",
        lg: "cn-sidebar-menu-button-size-lg",
      },
    },
    defaultVariants: {
      variant: "default",
      size: "default",
    },
  }
)

const {
  as: explicitTag,
  class: className,
  variant = "default",
  size = "default",
  isActive,
  active = false,
  tooltip,
  type,
  ...props
} = Astro.props

const Tag = explicitTag || ("href" in Astro.props ? "a" : "button")
const resolvedActive = isActive ?? active
const baseClassName = cn(variants({ variant, size }), className)
const resolvedTooltip =
  typeof tooltip === "string" ? { children: tooltip } : tooltip
const tooltipText =
  resolvedTooltip?.content ??
  (typeof resolvedTooltip?.children === "string"
    ? resolvedTooltip.children
    : undefined)
const {
  content: _tooltipContent,
  children: _tooltipChildren,
  ...tooltipProps
} = resolvedTooltip ?? {}
---

{tooltipText ? (
  <Tooltip>
    <TooltipTrigger
      as={Tag}
      data-sidebar="menu-button"
      data-size={size}
      data-active={resolvedActive ? "true" : undefined}
      aria-current={resolvedActive ? "page" : undefined}
      type={Tag === "button" ? type || "button" : undefined}
      class={baseClassName}
      {...props}
    >
      <slot />
    </TooltipTrigger>
    <TooltipContent
      data-sidebar="menu-tooltip"
      side="right"
      align="center"
      hidden
      {...tooltipProps}
    >
      {tooltipText}
    </TooltipContent>
  </Tooltip>
) : (
  <Tag
    data-slot="sidebar-menu-button"
    data-sidebar="menu-button"
    data-size={size}
    data-active={resolvedActive ? "true" : undefined}
    aria-current={resolvedActive ? "page" : undefined}
    type={Tag === "button" ? type || "button" : undefined}
    class={baseClassName}
    {...props}
  >
    <slot />
  </Tag>
)}
