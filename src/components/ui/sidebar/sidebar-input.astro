---
import type { HTMLAttributes } from "astro/types"

import { cn } from "@/lib/utils"

type Props = HTMLAttributes<"input">

const { class: className, ...props } = Astro.props
---

<input
  data-slot="sidebar-input"
  data-sidebar="input"
  class={cn(
    "cn-input cn-sidebar-input file:text-foreground placeholder:text-muted-foreground min-w-0 outline-none file:inline-flex file:border-0 file:bg-transparent disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50",
    className
  )}
  {...props}
/>
