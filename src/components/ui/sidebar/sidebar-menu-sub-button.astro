---
import type { HTMLAttributes } from "astro/types"
import { cva, type VariantProps } from "class-variance-authority"

import { cn } from "@/lib/utils"

// Keep Props above the cva() call. Astro's compiler does not find Props when a
// Tailwind child selector string comes first, and then leaves the props untyped.
type Props = VariantProps<typeof variants> &
  HTMLAttributes<"button"> &
  HTMLAttributes<"a"> &
  HTMLAttributes<"span"> & {
    as?: "a" | "button" | "span"
    href?: string
    isActive?: boolean
    active?: boolean
  }

const variants = cva(
  "cn-sidebar-menu-sub-button flex min-w-0 -translate-x-px items-center overflow-hidden outline-hidden group-data-[collapsible=icon]:hidden disabled:pointer-events-none disabled:opacity-50 aria-disabled:pointer-events-none aria-disabled:opacity-50 [&>span:last-child]:truncate [&>svg]:shrink-0",
  {
    variants: {
      size: {
        sm: "text-xs",
        md: "text-sm",
      },
    },
    defaultVariants: {
      size: "md",
    },
  }
)

const {
  as: explicitTag,
  class: className,
  size = "md",
  isActive,
  active = false,
  type,
  ...props
} = Astro.props

const Tag = explicitTag || "a"
const resolvedActive = isActive ?? active
---

<Tag
  data-slot="sidebar-menu-sub-button"
  data-sidebar="menu-sub-button"
  data-size={size}
  data-active={resolvedActive ? "true" : undefined}
  aria-current={resolvedActive ? "page" : undefined}
  type={Tag === "button" ? type || "button" : undefined}
  class={cn(variants({ size }), className)}
  {...props}
>
  <slot />
</Tag>
