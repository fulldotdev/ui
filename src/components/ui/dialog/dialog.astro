---
import type { HTMLAttributes } from "astro/types"

type Props = HTMLAttributes<"div"> & {
  media?: string
  defaultOpen?: boolean
  closeOnClickOutside?: boolean
  closeOnEscape?: boolean
  lockScroll?: boolean
  alertDialog?: boolean
}

const {
  media,
  class: className,
  defaultOpen,
  closeOnClickOutside,
  closeOnEscape,
  lockScroll,
  alertDialog,
  ...props
} = Astro.props
---

<div
  data-media={media}
  data-slot="dialog"
  data-default-open={defaultOpen}
  data-close-on-click-outside={closeOnClickOutside}
  data-close-on-escape={closeOnEscape}
  data-lock-scroll={lockScroll}
  data-alert-dialog={alertDialog}
  class={className}
  {...props}
>
  <slot />
</div>

<script>
  import { initializeDialogs } from "@/lib/dialog"

  initializeDialogs()
</script>
