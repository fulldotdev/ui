---
import type { HTMLAttributes } from "astro/types"
import XIcon from "@lucide/astro/icons/x"

import { cn } from "@/lib/utils"
import { Button } from "@/components/ui/button"

import DialogOverlay from "./dialog-overlay.astro"
import DialogPortal from "./dialog-portal.astro"

type Props = HTMLAttributes<"div"> & {
  showCloseButton?: boolean
}

const {
  class: className,
  showCloseButton = true,
  style,
  ...props
} = Astro.props
---

<DialogPortal>
  <DialogOverlay />
  <div
    data-slot="dialog-content"
    hidden
    class={cn(
      "cn-dialog-content fixed top-1/2 left-1/2 z-50 w-full -translate-x-1/2 -translate-y-1/2 outline-none",
      className
    )}
    style={`z-index: calc(var(--dialog-content-stack-index, 0) * 2 + 101);${style ? ` ${style}` : ""}`}
    {...props}
  >
    {showCloseButton && (
      <Button
        type="button"
        data-slot="dialog-close"
        variant="ghost"
        size="icon-sm"
        class="cn-dialog-close"
      >
        <XIcon />
        <span class="sr-only">Close</span>
      </Button>
    )}
    <slot />
  </div>
</DialogPortal>
