---
import type { HTMLAttributes } from "astro/types"

import { cn } from "@/lib/utils"

type Props = HTMLAttributes<"fieldset"> & {
  as?: "fieldset" | "div"
}

const { as: Tag = "fieldset", class: className, ...props } = Astro.props
---

<Tag
  data-slot="field-set"
  class={cn("cn-field-set flex flex-col", className)}
  {...props}
>
  <slot />
</Tag>
