---
import type { HTMLAttributes } from "astro/types"

import { cn } from "@/lib/utils"

type Props = HTMLAttributes<"fieldset">

const { class: className, ...props } = Astro.props
---

<fieldset
  data-slot="field-set"
  class={cn("cn-field-set flex flex-col", className)}
  {...props}
>
  <slot />
</fieldset>
