---
import type { HTMLAttributes } from "astro/types"
import type { TooltipAlign, TooltipSide } from "@data-slot/tooltip"

import { cn } from "@/lib/utils"

type Props = HTMLAttributes<"div"> & {
  mountStrategy?: "lazy" | "eager"
  delay?: number
  skipDelayDuration?: number
  side?: TooltipSide
  align?: TooltipAlign
  sideOffset?: number
  alignOffset?: number
  avoidCollisions?: boolean
  collisionPadding?: number
  portal?: boolean
}

const {
  mountStrategy = "eager",
  class: className,
  delay = 300,
  skipDelayDuration = 300,
  side = "top",
  align = "center",
  sideOffset = 4,
  alignOffset = 0,
  avoidCollisions = true,
  collisionPadding = 8,
  portal = true,
  ...props
} = Astro.props
---

<div
  data-slot="tooltip"
  data-mount-strategy={mountStrategy}
  data-delay={delay}
  data-skip-delay-duration={skipDelayDuration}
  data-side={side}
  data-align={align}
  data-side-offset={sideOffset}
  data-align-offset={alignOffset}
  data-avoid-collisions={avoidCollisions}
  data-collision-padding={collisionPadding}
  data-portal={portal}
  class={cn(className)}
  {...props}
>
  <slot />
</div>

<script>
  import { createTooltip } from "@data-slot/tooltip"

  import { initializeDataSlot } from "@/lib/data-slot"

  initializeDataSlot("tooltip", createTooltip)
</script>
