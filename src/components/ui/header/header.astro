---
import type { HTMLAttributes } from "astro/types"
import { cva, type VariantProps } from "class-variance-authority"

import { cn } from "@/lib/utils"

type Props = HTMLAttributes<"header"> & VariantProps<typeof variants>

const variants = cva("cn-header relative z-50 flex w-full items-center gap-4", {
  variants: {
    variant: {
      default: "",
      floating:
        "cn-header-variant-floating mx-auto w-[calc(100%-2*var(--gutter,1rem))] max-w-[calc(var(--container,1280px)-2*var(--gutter,1rem))] overflow-hidden",
    },
  },
  defaultVariants: {
    variant: "default",
  },
})

const { class: className, variant, ...props } = Astro.props
---

<header
  class={cn(variants({ variant }), className)}
  data-slot="header"
  data-variant={variant}
  {...props}
>
  <slot />
</header>
