---
import type { HTMLAttributes } from "astro/types"
import CheckIcon from "@lucide/astro/icons/check"

import { cn } from "@/lib/utils"

type Props = HTMLAttributes<"a"> & {
  disabled?: boolean
  href?: string
  value?: string
  label?: string
  keywords?: string | string[]
  forceMount?: boolean
}

const {
  class: className,
  disabled,
  href,
  value,
  label,
  keywords,
  forceMount,
  ...props
} = Astro.props

const Tag = href ? "a" : "div"
const keywordsValue = Array.isArray(keywords) ? keywords.join(", ") : keywords
---

<Tag
  data-slot="command-item"
  data-disabled={disabled ? "true" : undefined}
  data-value={value}
  data-label={label}
  data-keywords={keywordsValue}
  data-force-mount={forceMount ? "true" : undefined}
  href={href}
  class={cn(
    "cn-command-item group/command-item data-[disabled=true]:pointer-events-none data-[disabled=true]:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&[href]]:cursor-pointer [&[href]]:no-underline",
    className
  )}
  {...props}
>
  <slot />
  <CheckIcon class="ml-auto opacity-0 group-has-data-[slot=command-shortcut]/command-item:hidden group-data-selected/command-item:opacity-100" />
</Tag>
