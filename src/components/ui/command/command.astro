---
import type { HTMLAttributes } from "astro/types"

import { cn } from "@/lib/utils"

type Props = HTMLAttributes<"div"> & {
  label?: string
  defaultValue?: string
  defaultSearch?: string
  shouldFilter?: boolean
  loop?: boolean
  disablePointerSelection?: boolean
  vimBindings?: boolean
}

const {
  class: className,
  label,
  defaultValue,
  defaultSearch,
  shouldFilter,
  loop,
  disablePointerSelection,
  vimBindings,
  ...props
} = Astro.props
---

<div
  data-slot="command"
  data-label={label}
  data-default-value={defaultValue}
  data-default-search={defaultSearch}
  data-should-filter={shouldFilter}
  data-loop={loop}
  data-disable-pointer-selection={disablePointerSelection}
  data-vim-bindings={vimBindings}
  class={cn(
    "bg-popover text-popover-foreground flex size-full flex-col overflow-hidden rounded-xl! p-1",
    className
  )}
  {...props}
>
  <slot />
</div>

<script>
  import { createCommand } from "@data-slot/command"
  import { getPart, getParts } from "@data-slot/core"

  import { initializeDataSlot } from "@/lib/data-slot"

  initializeDataSlot("command", (root) => {
    const controller = createCommand(root)
    // 1.x dialog autofocus includes the command's tabindex=-1 container.
    // Keep opening a command palette ready for typing, as in 0.2.x.
    const focusInput = () =>
      getPart<HTMLInputElement>(root, "command-input")?.focus({
        preventScroll: true,
      })
    root.addEventListener("focus", focusInput)
    const navigate = (event: Event) => {
      if (event.target !== root) return
      const { value } = (event as CustomEvent<{ value?: unknown }>).detail
      if (typeof value !== "string") return
      const item = getParts<HTMLAnchorElement>(root, "command-item").find(
        (item) =>
          item.getAttribute("data-value") === value && item.hasAttribute("href")
      )
      const href = item?.getAttribute("href")
      if (href) window.location.href = href
    }
    root.addEventListener("command:select", navigate)
    return {
      destroy() {
        root.removeEventListener("focus", focusInput)
        root.removeEventListener("command:select", navigate)
        controller.destroy()
      },
    }
  })
</script>
