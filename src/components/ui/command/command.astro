---
import type { HTMLAttributes } from "astro/types"

import { cn } from "@/lib/utils"

type Props = HTMLAttributes<"div"> & {
  label?: string
  defaultValue?: string
  defaultSearch?: string
  shouldFilter?: boolean
  loop?: boolean
  disablePointerSelection?: boolean
  vimBindings?: boolean
}

const {
  class: className,
  label,
  defaultValue,
  defaultSearch,
  shouldFilter,
  loop,
  disablePointerSelection,
  vimBindings,
  ...props
} = Astro.props
---

<div
  data-slot="command"
  data-label={label}
  data-default-value={defaultValue}
  data-default-search={defaultSearch}
  data-should-filter={shouldFilter}
  data-loop={loop}
  data-disable-pointer-selection={disablePointerSelection}
  data-vim-bindings={vimBindings}
  class={cn(
    "bg-popover text-popover-foreground flex size-full flex-col overflow-hidden rounded-xl! p-1",
    className
  )}
  {...props}
>
  <slot />
</div>

<script>
  import { createCommand } from "@data-slot/command"
  import { getPart, getParts } from "@data-slot/core"

  import { initializeDataSlot } from "@/lib/data-slot"

  initializeDataSlot("command", (root) => {
    const controller = createCommand(root)
    const input = getPart<HTMLInputElement>(root, "command-input")!
    // Data Slot emits selection; native activation also preserves link semantics
    // and lets Astro's ClientRouter handle same-origin navigation.
    const navigate = (event: KeyboardEvent) => {
      if (
        event.key !== "Enter" ||
        event.defaultPrevented ||
        event.isComposing ||
        event.keyCode === 229
      )
        return
      const item = getParts<HTMLAnchorElement>(root, "command-item").find(
        (item) =>
          item.hasAttribute("data-selected") &&
          item.hasAttribute("href") &&
          item.getAttribute("aria-disabled") !== "true"
      )
      if (!item) return
      event.preventDefault()
      item.click()
    }
    input.addEventListener("keydown", navigate)
    return {
      destroy() {
        input.removeEventListener("keydown", navigate)
        controller.destroy()
      },
    }
  })
</script>
