---
import type { HTMLAttributes } from "astro/types"
import SearchIcon from "@lucide/astro/icons/search"

import { cn } from "@/lib/utils"

type Props = HTMLAttributes<"input"> & {
  wrapperClass?: string
}

const { class: className, wrapperClass, ...props } = Astro.props
---

<div
  data-slot="command-input-wrapper"
  class={cn("cn-command-input-wrapper", wrapperClass)}
>
  <div class="cn-command-input-group flex items-center border">
    <div class="flex items-center pl-2">
      <SearchIcon class="cn-command-input-icon" />
    </div>
    <input
      type="text"
      data-slot="command-input"
      class={cn(
        "cn-fd-command-input placeholder:text-muted-foreground h-full min-w-0 flex-1 bg-transparent px-2.5 outline-hidden disabled:cursor-not-allowed disabled:opacity-50",
        className
      )}
      {...props}
    />
  </div>
</div>
