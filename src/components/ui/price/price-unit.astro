---
import type { HTMLAttributes } from "astro/types"

import { cn } from "@/lib/utils"

type Props = HTMLAttributes<"span">

const {
  class: className,
  "data-slot": dataSlot = "price-unit",
  ...props
} = Astro.props
---

<span
  class={cn("text-muted-foreground text-sm leading-tight", className)}
  data-slot={dataSlot}
  {...props}
>
  / <slot />
</span>
