---
import type { HTMLAttributes } from "astro/types"

import { cn } from "@/lib/utils"

type Props = HTMLAttributes<"div">

const { class: className, ...props } = Astro.props
---

<div
  class={cn("flex flex-wrap items-center gap-x-2", className)}
  data-slot="price"
  {...props}
>
  <slot />
</div>
