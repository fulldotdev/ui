---
import type { HTMLAttributes } from "astro/types"

import { cn } from "@/lib/utils"

type Props = HTMLAttributes<"tr">

const { class: className, ...props } = Astro.props
---

<tr
  data-slot="table-row"
  class={cn("cn-table-row has-aria-expanded:bg-muted/50", className)}
  {...props}
>
  <slot />
</tr>
