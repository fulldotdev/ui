---
import type { HTMLAttributes } from "astro/types"

import { cn } from "@/lib/utils"

import { toggleVariants, type ToggleVariantProps } from "./toggle-variants"

type Props = HTMLAttributes<"button"> &
  ToggleVariantProps & {
    defaultPressed?: boolean
    disabled?: boolean
  }

const {
  class: className,
  variant = "default",
  size = "default",
  defaultPressed,
  disabled,
  type = "button",
  ...props
} = Astro.props
---

<button
  data-slot="toggle"
  data-default-pressed={defaultPressed}
  data-disabled={disabled}
  type={type}
  disabled={disabled}
  aria-pressed={defaultPressed === true ? "true" : "false"}
  class={cn(toggleVariants({ variant, size }), className)}
  {...props}
>
  <slot />
</button>

<script>
  import { create } from "@data-slot/toggle"

  const controllers: ReturnType<typeof create> = []
  const initialize = () => controllers.push(...create())
  initialize()
  document.addEventListener("astro:page-load", initialize)
  document.addEventListener("astro:before-swap", () => {
    for (const controller of controllers) controller.destroy()
    controllers.length = 0
  })
</script>
