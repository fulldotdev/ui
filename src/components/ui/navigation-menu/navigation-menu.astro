---
import type { HTMLAttributes } from "astro/types"

import { cn } from "@/lib/utils"

import NavigationMenuPositioner from "./navigation-menu-positioner.astro"

type Props = HTMLAttributes<"nav"> & {
  media?: string
  mountStrategy?: "lazy" | "eager"
  delayOpen?: number
  delayClose?: number
  openOnFocus?: boolean
  side?: "top" | "right" | "bottom" | "left"
  align?: "start" | "center" | "end"
  sideOffset?: number
  alignOffset?: number
  positionMethod?: "absolute" | "fixed"
  safeTriangle?: boolean
  debugSafeTriangle?: boolean
}

const {
  media,
  mountStrategy,
  class: className = "",
  delayOpen = 0,
  delayClose = 0,
  openOnFocus,
  side = "bottom",
  align = "start",
  sideOffset = 8,
  alignOffset = 0,
  positionMethod = "absolute",
  safeTriangle,
  debugSafeTriangle,
  "aria-label": ariaLabel = "Main",
  ...props
} = Astro.props
---

<nav
  {...props}
  aria-label={ariaLabel}
  data-slot="navigation-menu"
  data-media={media}
  data-mount-strategy={mountStrategy}
  data-delay-open={delayOpen}
  data-delay-close={delayClose}
  data-open-on-focus={openOnFocus}
  data-side={side}
  data-align={align}
  data-side-offset={sideOffset}
  data-align-offset={alignOffset}
  data-position-method={positionMethod}
  data-safe-triangle={safeTriangle}
  data-debug-safe-triangle={debugSafeTriangle}
  class={cn(
    "cn-navigation-menu group/navigation-menu relative flex flex-1 items-center justify-center",
    className
  )}
>
  <slot />
  <NavigationMenuPositioner {side} {sideOffset} {align} {alignOffset} />
</nav>

<script>
  import { onMedia } from "@/lib/on-media"

  const roots = new Map<Element, () => void>()
  const initialize = () => {
    for (const root of document.querySelectorAll<HTMLElement>(
      '[data-slot="navigation-menu"]'
    )) {
      if (roots.has(root)) continue
      roots.set(
        root,
        onMedia(
          root.dataset.media ?? "all",
          () => import("@data-slot/navigation-menu"),
          ({ createNavigationMenu }) => {
            const controller = createNavigationMenu(root)
            return () => controller.destroy()
          },
          { root, selector: '[data-slot="navigation-menu-trigger"]' }
        )
      )
    }
  }
  initialize()
  document.addEventListener("astro:page-load", initialize)
  document.addEventListener("astro:before-swap", () => {
    for (const dispose of roots.values()) dispose()
    roots.clear()
  })
</script>
