---
import type { HTMLAttributes } from "astro/types"
import { cva, type VariantProps } from "class-variance-authority"

import { cn } from "@/lib/utils"

type Props = VariantProps<typeof variants> & HTMLAttributes<"div">

const variants = cva("cn-alert group/alert relative w-full", {
  variants: {
    variant: {
      default: "cn-alert-variant-default",
      // shadcn/ui shows the description at text-destructive/90. Like its
      // FieldError, this uses the full destructive color, for 4.5:1 contrast.
      destructive: "cn-fd-alert-variant-destructive",
    },
  },
  defaultVariants: {
    variant: "default",
  },
})

const { class: className, variant, ...props } = Astro.props
---

<div
  data-slot="alert"
  role="alert"
  class={cn(variants({ variant }), className)}
  {...props}
>
  <slot />
</div>
