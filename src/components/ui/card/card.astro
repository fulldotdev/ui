---
import type { HTMLAttributes } from "astro/types"

import { cn } from "@/lib/utils"

type Props = HTMLAttributes<"div"> & {
  size?: "default" | "sm"
}

const { class: className, size = "default", ...props } = Astro.props
---

<div
  data-slot="card"
  data-size={size}
  class={cn("cn-card group/card flex flex-col", className)}
  {...props}
>
  <slot />
</div>
