---
import type { HTMLTag, Polymorphic } from "astro/types"

import { cn } from "@/lib/utils"

type Props<Tag extends HTMLTag = "div"> = Polymorphic<{
  as: Tag
  size?: "default" | "sm"
}>

const {
  as: Tag = "div",
  class: className,
  size = "default",
  ...props
} = Astro.props
---

<Tag
  data-slot="card"
  data-size={size}
  class={cn("cn-card group/card flex flex-col", className)}
  {...props}
>
  <slot />
</Tag>
