<script is:inline>
  const getThemePreference = () => {
    if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
      return localStorage.getItem("theme")
    }

    return window.matchMedia("(prefers-color-scheme: dark)").matches
      ? "dark"
      : "light"
  }

  const disableTransitionsTemporarily = () => {
    const style = document.createElement("style")

    style.appendChild(
      document.createTextNode(
        "*, *::before, *::after { transition: none !important; }"
      )
    )

    document.head.appendChild(style)

    return () => {
      void document.documentElement.offsetHeight

      requestAnimationFrame(() => {
        style.remove()
      })
    }
  }

  const applyTheme = (theme, disableTransitions = false) => {
    const restoreTransitions = disableTransitions
      ? disableTransitionsTemporarily()
      : null

    document.documentElement.classList[theme === "dark" ? "add" : "remove"](
      "dark"
    )

    restoreTransitions?.()
  }

  let currentTheme = getThemePreference()
  let isSwapping = false

  window.__setTheme = (theme) => {
    currentTheme = theme
    applyTheme(theme, true)

    if (typeof localStorage !== "undefined") {
      localStorage.setItem("theme", theme)
    }
  }

  applyTheme(currentTheme)

  // Astro's `<ClientRouter />` swaps the `<html>` element's attributes with the
  // incoming document's on every client-side navigation. The server cannot know
  // the visitor's theme, so the `dark` class is dropped and the site falls back
  // to light mode. Carry the active theme onto the incoming document before the
  // swap, then re-apply it afterwards for custom swaps that bypass this.
  document.addEventListener("astro:before-swap", (event) => {
    isSwapping = true

    event.newDocument?.documentElement.classList.toggle(
      "dark",
      currentTheme === "dark"
    )
  })

  document.addEventListener("astro:after-swap", () => {
    isSwapping = false

    applyTheme(currentTheme)
  })

  document.addEventListener("astro:page-load", () => {
    applyTheme(currentTheme)
  })

  if (typeof localStorage !== "undefined") {
    const observer = new MutationObserver(() => {
      // Skip the class changes caused by the swap itself, otherwise the
      // server-rendered value overwrites the stored preference.
      if (isSwapping) return

      currentTheme = document.documentElement.classList.contains("dark")
        ? "dark"
        : "light"
      localStorage.setItem("theme", currentTheme)
    })

    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["class"],
    })
  }
</script>
