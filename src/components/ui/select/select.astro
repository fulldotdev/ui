---
import type { HTMLAttributes } from "astro/types"
import type { Align, Position, Side } from "@data-slot/select"

import { cn } from "@/lib/utils"

type Props = HTMLAttributes<"div"> & {
  mountStrategy?: "lazy" | "eager"
  defaultValue?: string
  defaultOpen?: boolean
  placeholder?: string
  disabled?: boolean
  required?: boolean
  name?: string
  position?: Position
  side?: Side
  align?: Align
  sideOffset?: number
  alignOffset?: number
  avoidCollisions?: boolean
  collisionPadding?: number
  highlightItemOnHover?: boolean
  lockScroll?: boolean
}

const {
  mountStrategy,
  class: className,
  defaultValue,
  defaultOpen,
  placeholder,
  disabled,
  required,
  name,
  position,
  side,
  align,
  sideOffset,
  alignOffset,
  avoidCollisions,
  collisionPadding,
  highlightItemOnHover,
  lockScroll,
  ...props
} = Astro.props
---

<div
  data-slot="select"
  data-mount-strategy={mountStrategy}
  data-default-value={defaultValue}
  data-default-open={defaultOpen}
  data-placeholder={placeholder}
  data-disabled={disabled}
  data-required={required}
  data-name={name}
  data-position={position}
  data-side={side}
  data-align={align}
  data-side-offset={sideOffset}
  data-align-offset={alignOffset}
  data-avoid-collisions={avoidCollisions}
  data-collision-padding={collisionPadding}
  data-highlight-item-on-hover={highlightItemOnHover}
  data-lock-scroll={lockScroll}
  class={cn(
    "group/select relative inline-flex w-fit flex-col gap-1.5",
    className
  )}
  {...props}
>
  <slot />
</div>

<script>
  import { create } from "@data-slot/select"

  const controllers: ReturnType<typeof create> = []
  const initialize = () => controllers.push(...create())
  initialize()
  document.addEventListener("astro:page-load", initialize)
  document.addEventListener("astro:before-swap", () => {
    for (const controller of controllers) controller.destroy()
    controllers.length = 0
  })
</script>
