---
import type { HTMLAttributes } from "astro/types"
import type { Align, Position, Side } from "@data-slot/select"

import { cn } from "@/lib/utils"

type Props = HTMLAttributes<"div"> & {
  mountStrategy?: "lazy" | "eager"
  defaultValue?: string
  defaultOpen?: boolean
  placeholder?: string
  disabled?: boolean
  required?: boolean
  name?: string
  position?: Position
  side?: Side
  align?: Align
  sideOffset?: number
  alignOffset?: number
  avoidCollisions?: boolean
  collisionPadding?: number
  highlightItemOnHover?: boolean
  lockScroll?: boolean
}

const {
  mountStrategy,
  class: className,
  defaultValue,
  defaultOpen,
  placeholder,
  disabled,
  required,
  name,
  position,
  side,
  align,
  sideOffset,
  alignOffset,
  avoidCollisions,
  collisionPadding,
  highlightItemOnHover,
  lockScroll,
  ...props
} = Astro.props

// Show the text Data Slot puts in the SelectValue when it starts: the label
// of the default item, or the placeholder. Without it the trigger is empty, and
// has no accessible name, until the script runs.
const html = await Astro.slots.render("default")
const decode = (value: string) =>
  value.replace(/&(#\d+|amp|lt|gt|quot|apos);/g, (_, entity: string) =>
    entity.startsWith("#")
      ? String.fromCharCode(Number(entity.slice(1)))
      : { amp: "&", lt: "<", gt: ">", quot: '"', apos: "'" }[entity]!
  )
const escape = (value: string) =>
  value.replace(/[&<>"]/g, (char) => `&#${char.charCodeAt(0)};`)
// Attributes of a tag. Their values can hold ">", as Tailwind classes do.
const attributes = String.raw`(?:[^>"']|"[^"]*"|'[^']*')*`
const part = (tag: string, slot: string, rest = "", flags?: string) =>
  new RegExp(
    `<${tag}\\b(${attributes}data-slot="${slot}"${attributes})>${rest}`,
    flags
  )
const item =
  defaultValue === undefined
    ? undefined
    : [
        ...html.matchAll(part("div", "select-item", "([\\s\\S]*?)</div>", "g")),
      ].find(
        ([, attrs]) =>
          decode(attrs.match(/data-value="([^"]*)"/)?.[1] ?? "") ===
          defaultValue
      )
const text =
  defaultValue === undefined
    ? escape(placeholder ?? "")
    : item?.[1].match(/data-label="([^"]*)"/)?.[1].trim() ||
      item?.[2].replace(new RegExp(`<${attributes}>`, "g"), "").trim() ||
      escape(defaultValue)
const empty = part("span", "select-value", "</span>")
const content =
  text && empty.test(html)
    ? html
        .replace(empty, (_, attrs: string) => `<span${attrs}>${text}</span>`)
        .replace(part("button", "select-trigger"), (trigger, attrs: string) =>
          defaultValue === undefined
            ? `<button${attrs} data-placeholder>`
            : trigger
        )
    : html
---

<div
  data-slot="select"
  data-mount-strategy={mountStrategy}
  data-default-value={defaultValue}
  data-default-open={defaultOpen}
  data-placeholder={placeholder}
  data-disabled={disabled}
  data-required={required}
  data-name={name}
  data-position={position}
  data-side={side}
  data-align={align}
  data-side-offset={sideOffset}
  data-align-offset={alignOffset}
  data-avoid-collisions={avoidCollisions}
  data-collision-padding={collisionPadding}
  data-highlight-item-on-hover={highlightItemOnHover}
  data-lock-scroll={lockScroll}
  class={cn(
    "group/select relative inline-flex w-fit flex-col gap-1.5",
    className
  )}
  {...props}
>
  <Fragment set:html={content} />
</div>

<script>
  import { create } from "@data-slot/select"

  const controllers: ReturnType<typeof create> = []
  const initialize = () => controllers.push(...create())
  initialize()
  document.addEventListener("astro:page-load", initialize)
  document.addEventListener("astro:before-swap", () => {
    for (const controller of controllers) controller.destroy()
    controllers.length = 0
  })
</script>
