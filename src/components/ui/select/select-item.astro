---
import type { HTMLAttributes } from "astro/types"
import CheckIcon from "@lucide/astro/icons/check"

import { cn } from "@/lib/utils"

type Props = HTMLAttributes<"div"> & {
  value?: string
  disabled?: boolean
  label?: string
}

const { class: className, value, disabled, label, ...props } = Astro.props
---

<div
  data-slot="select-item"
  data-value={value}
  data-disabled={disabled ? "true" : undefined}
  data-label={label}
  class={cn(
    "cn-fd-select-item group/select-item data-highlighted:**:[svg]:text-accent-foreground relative flex w-full cursor-default items-center outline-hidden select-none data-[disabled=true]:pointer-events-none data-[disabled=true]:opacity-50 *:data-[slot=select-item-text]:shrink-0 *:data-[slot=select-item-text]:whitespace-nowrap [&_svg]:pointer-events-none [&_svg]:shrink-0",
    className
  )}
  {...props}
>
  <span
    data-slot="select-item-text"
    class="cn-select-item-text shrink-0 items-center whitespace-nowrap"
  >
    <slot />
  </span>
  <span
    aria-hidden="true"
    class="cn-select-item-indicator opacity-0 group-data-selected/select-item:opacity-100"
  >
    <CheckIcon />
  </span>
</div>
