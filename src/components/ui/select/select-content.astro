---
import type { HTMLAttributes } from "astro/types"
import type { Align, Position, Side } from "@data-slot/select"

import { cn } from "@/lib/utils"

type Props = HTMLAttributes<"div"> & {
  position?: Position
  side?: Side
  align?: Align
  sideOffset?: number
  alignOffset?: number
  avoidCollisions?: boolean
  collisionPadding?: number
}

const {
  class: className,
  hidden = true,
  position,
  side,
  align,
  sideOffset,
  alignOffset,
  avoidCollisions,
  collisionPadding,
  ...props
} = Astro.props
---

<div data-slot="select-portal">
  <div
    data-slot="select-positioner"
    data-position={position}
    data-side={side}
    data-align={align}
    data-side-offset={sideOffset}
    data-align-offset={alignOffset}
    data-avoid-collisions={avoidCollisions}
    data-collision-padding={collisionPadding}
    class="isolate z-[1000]"
  >
    <div
      data-slot="select-content"
      data-position={position}
      data-align-trigger={position === "item-aligned" ? "true" : undefined}
      data-side={side}
      data-align={align}
      data-side-offset={sideOffset}
      data-align-offset={alignOffset}
      data-avoid-collisions={avoidCollisions}
      data-collision-padding={collisionPadding}
      hidden={hidden}
      class={cn(
        "cn-select-content cn-select-content-logical relative isolate z-[1000] max-h-(--available-height) w-(--anchor-width) origin-(--transform-origin) overflow-x-hidden overflow-y-auto outline-none data-[align-trigger=true]:animate-none",
        className
      )}
      {...props}
    >
      <div
        data-slot="select-viewport"
        data-position={position}
        class="data-[position=item-aligned]:w-full data-[position=popper]:min-w-36"
      >
        <slot />
      </div>
    </div>
  </div>
</div>
