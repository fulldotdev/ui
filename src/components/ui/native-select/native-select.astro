---
import type { HTMLAttributes } from "astro/types"
import ChevronDownIcon from "@lucide/astro/icons/chevron-down"

import { cn } from "@/lib/utils"

type Props = Omit<HTMLAttributes<"select">, "size"> & {
  size?: "sm" | "default"
}

const { class: className, size = "default", multiple, ...props } = Astro.props

// Astro renders `multiple` as `multiple="true"` or `multiple="false"`, and both
// enable it. Render the bare attribute only when it is set.
---

<div
  class={cn(
    "group/native-select relative w-fit has-[select:disabled]:opacity-50",
    className
  )}
  data-slot="native-select-wrapper"
  data-size={size}
>
  <select
    data-slot="native-select"
    data-size={size}
    multiple={multiple ? "" : undefined}
    class="cn-native-select outline-none disabled:pointer-events-none disabled:cursor-not-allowed"
    {...props}
  >
    <slot />
  </select>
  <ChevronDownIcon
    class="cn-native-select-icon pointer-events-none absolute select-none"
    aria-hidden="true"
    data-slot="native-select-icon"
  />
</div>
