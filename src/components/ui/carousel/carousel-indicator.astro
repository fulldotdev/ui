---
import type { HTMLAttributes } from "astro/types"

import { cn } from "@/lib/utils"

type Props = Omit<HTMLAttributes<"button">, "type"> &
  Omit<HTMLAttributes<"a">, "type"> & {
    index: number
  }

const {
  class: className,
  index,
  "aria-label": ariaLabel = `Go to slide ${index + 1}`,
  "data-slot": dataSlot = "carousel-indicator",
  ...props
} = Astro.props

// A link to the slide's id also works without JavaScript.
const Tag = Astro.props.href ? "a" : "button"
---

<Tag
  type={Tag === "button" ? "button" : undefined}
  data-slot={dataSlot}
  data-carousel-indicator
  data-index={index}
  aria-label={ariaLabel}
  class={cn(
    "cn-carousel-indicator relative block shrink-0 cursor-pointer overflow-hidden [&>img]:size-full [&>img]:object-cover",
    className
  )}
  {...props}
>
  <slot />
</Tag>
