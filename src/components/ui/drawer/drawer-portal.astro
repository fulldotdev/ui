---
import type { HTMLAttributes } from "astro/types"

type Props = HTMLAttributes<"div"> & {
  container?: string
  keepMounted?: boolean
}

const {
  class: className,
  container,
  keepMounted,
  hidden = true,
  ...props
} = Astro.props
---

<div
  data-slot="drawer-portal"
  data-container={container}
  data-keep-mounted={keepMounted}
  class={className}
  hidden={hidden}
  {...props}
>
  <slot />
</div>
