---
import type { HTMLAttributes } from "astro/types"
import type { PopoverAlign, PopoverSide } from "@data-slot/popover"

import { cn } from "@/lib/utils"

type Props = HTMLAttributes<"div"> & {
  side?: PopoverSide
  align?: PopoverAlign
  sideOffset?: number
  alignOffset?: number
  avoidCollisions?: boolean
  collisionPadding?: number
  /** Compatibility alias. Prefer `side`. */
  position?: PopoverSide
}

const {
  class: className,
  hidden = true,
  side,
  align,
  sideOffset,
  alignOffset,
  avoidCollisions,
  collisionPadding,
  position,
  ...props
} = Astro.props
---

<div data-slot="popover-portal">
  <div
    data-slot="popover-positioner"
    data-side={side}
    data-align={align}
    data-side-offset={sideOffset}
    data-align-offset={alignOffset}
    data-avoid-collisions={avoidCollisions}
    data-collision-padding={collisionPadding}
    data-position={position}
    class="isolate z-[1000]"
  >
    <div
      data-slot="popover-content"
      data-side={side}
      data-align={align}
      data-side-offset={sideOffset}
      data-align-offset={alignOffset}
      data-avoid-collisions={avoidCollisions}
      data-collision-padding={collisionPadding}
      data-position={position}
      hidden={hidden}
      class={cn(
        "cn-popover-content cn-popover-content-logical z-50 w-72 origin-(--transform-origin) outline-hidden",
        className
      )}
      {...props}
    >
      <slot />
    </div>
  </div>
</div>
