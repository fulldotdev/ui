---
import { Image as AstroImage, Picture as AstroPicture } from "astro:assets"
import type { ComponentProps } from "astro/types"

import { cn } from "@/lib/utils"

type Props = Partial<ComponentProps<typeof AstroPicture>> & {
  inferSize?: boolean
}

const {
  class: className,
  alt,
  src,
  inferSize = true,
  formats,
  fallbackFormat,
  pictureAttributes,
  ...props
} = Astro.props

const imageProps = {
  ...props,
  src,
  alt: alt ?? "",
  class: cn("h-auto w-full", className),
  inferSize,
} as ComponentProps<typeof AstroImage>
const pictureProps = {
  ...imageProps,
  formats,
  fallbackFormat,
  pictureAttributes: {
    ...pictureAttributes,
    class: cn("contents [&>source]:hidden", pictureAttributes?.class),
  },
} as ComponentProps<typeof AstroPicture>
const usePicture = !!formats?.length
---

{src && usePicture && <AstroPicture {...pictureProps} />}
{src && !usePicture && <AstroImage {...imageProps} />}
