---
interface Props {
  storageKey: string
  privacyHref: string
  cookiePrefixes?: string[]
  description?: string
  acceptLabel?: string
  rejectLabel?: string
  settingsLabel?: string
  moreLabel?: string
}

const {
  storageKey,
  privacyHref,
  cookiePrefixes = [],
  description = "Mogen we cookies gebruiken om onze website en advertenties te verbeteren?",
  acceptLabel = "Accepteren",
  rejectLabel = "Weigeren",
  settingsLabel = "Cookies aanpassen",
  moreLabel = "Meer over cookies",
} = Astro.props
---

<div data-cookie-banner>
  <section data-cookie-choice aria-label="Cookies" hidden>
    <p>{description} <a href={privacyHref}>{moreLabel}</a></p>
    <div class="cookie-actions">
      <button type="button" data-cookie-accept>{acceptLabel}</button>
      <button type="button" data-cookie-reject>{rejectLabel}</button>
    </div>
  </section>
  <div data-cookie-footer hidden>
    <button type="button" data-cookie-reopen>{settingsLabel}</button>
  </div>
</div>

<script is:inline define:vars={{ storageKey, cookiePrefixes }}>
  ;(() => {
    const root = document.currentScript.previousElementSibling
    const panel = root.querySelector("[data-cookie-choice]")
    const footer = root.querySelector("[data-cookie-footer]")
    const reopen = root.querySelector("[data-cookie-reopen]")
    const accept = root.querySelector("[data-cookie-accept]")
    const reject = root.querySelector("[data-cookie-reject]")
    let choice
    let returnFocus = document.activeElement
    panel.addEventListener("focusin", (event) => {
      if (
        event.relatedTarget instanceof HTMLElement &&
        !panel.contains(event.relatedTarget)
      ) {
        returnFocus = event.relatedTarget
      }
    })
    try {
      choice = localStorage.getItem(storageKey)
    } catch {}

    const notify = () =>
      document.dispatchEvent(
        new CustomEvent("cookie-consent-change", {
          detail: { storageKey, choice },
        })
      )
    const show = (visible) => {
      panel.hidden = !visible
      footer.hidden = visible
    }
    const clearCookies = () => {
      const domains = location.hostname.split(".")
      for (const cookie of document.cookie.split(";")) {
        const name = cookie.split("=")[0].trim()
        if (!cookiePrefixes.some((prefix) => name.startsWith(prefix))) continue
        document.cookie = name + "=; max-age=0; path=/"
        for (let i = 0; i < domains.length - 1; i++) {
          document.cookie =
            name + "=; max-age=0; path=/; domain=" + domains.slice(i).join(".")
        }
      }
    }
    const choose = (value) => {
      choice = value
      try {
        localStorage.setItem(storageKey, choice)
      } catch {}
      if (choice === "rejected") clearCookies()
      show(false)
      const target =
        returnFocus instanceof HTMLElement && returnFocus.isConnected
          ? returnFocus
          : document.body
      const previousTabIndex = target.getAttribute("tabindex")
      if (target === document.body) target.setAttribute("tabindex", "-1")
      target.focus({ preventScroll: true })
      if (target === document.body) {
        if (previousTabIndex === null) target.removeAttribute("tabindex")
        else target.setAttribute("tabindex", previousTabIndex)
      }
      notify()
    }
    accept.addEventListener("click", () => choose("accepted"))
    reject.addEventListener("click", () => choose("rejected"))
    reopen.addEventListener("click", () => {
      returnFocus = reopen
      show(true)
      accept.focus({ preventScroll: true })
    })
    show(choice !== "accepted" && choice !== "rejected")
    if (choice === "rejected") clearCookies()
    // Site integrations must register their listener before this component.
    notify()
  })()
</script>

<style>
  [hidden] {
    display: none !important;
  }
  [data-cookie-banner] {
    color: var(--foreground, #202020);
    font-size: 0.875rem;
    line-height: 1.5;
  }
  [data-cookie-choice] {
    position: fixed;
    inset: auto 1rem 1rem;
    z-index: 40;
    max-width: 34rem;
    padding: 1rem;
    border: 1px solid var(--border, currentColor);
    border-radius: var(--radius, 0.5rem);
    background: var(--background, #fff);
    box-shadow: 0 4px 20px #0002;
  }
  p {
    margin: 0 0 1rem;
  }
  a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .cookie-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  button {
    padding: 0.5rem 0.875rem;
    border: 1px solid currentColor;
    border-radius: var(--radius, 0.25rem);
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }
  button:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  button:focus-visible,
  a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }
  [data-cookie-footer] {
    padding: 0.75rem max(1rem, calc((100% - 80rem) / 2));
    background: var(--background, #fff);
  }
  [data-cookie-reopen] {
    border: 0;
    padding: 0.25rem 0;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
