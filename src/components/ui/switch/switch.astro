---
import type { HTMLAttributes } from "astro/types"

import { cn } from "@/lib/utils"

type Props = HTMLAttributes<"button"> & {
  defaultChecked?: boolean
  disabled?: boolean
  readOnly?: boolean
  required?: boolean
  name?: string
  size?: "default" | "sm"
  value?: string
  uncheckedValue?: string
}

const {
  class: className,
  defaultChecked,
  disabled,
  readOnly,
  required,
  name,
  size = "default",
  value,
  uncheckedValue,
  ...props
} = Astro.props

const initialChecked = defaultChecked === true
const switchStyle =
  "cn-switch peer group/switch relative inline-flex items-center transition-all outline-none after:absolute after:-inset-x-3 after:-inset-y-2 data-disabled:cursor-not-allowed data-disabled:opacity-50 data-readonly:cursor-default"
---

<button
  type="button"
  role="switch"
  disabled={disabled}
  aria-checked={initialChecked ? "true" : "false"}
  aria-disabled={disabled ? "true" : undefined}
  aria-readonly={readOnly ? "true" : undefined}
  aria-required={required ? "true" : undefined}
  data-slot="switch"
  data-size={size}
  data-checked={initialChecked ? "" : undefined}
  data-unchecked={initialChecked ? undefined : ""}
  data-default-checked={defaultChecked}
  data-disabled={disabled ? "true" : undefined}
  data-read-only={readOnly}
  data-readonly={readOnly ? "" : undefined}
  data-required={required}
  data-name={name}
  data-value={value}
  data-unchecked-value={uncheckedValue}
  class={cn(switchStyle, className)}
  {...props}
>
  <span
    aria-hidden="true"
    data-slot="switch-thumb"
    data-checked={initialChecked ? "" : undefined}
    data-unchecked={initialChecked ? undefined : ""}
    class="cn-switch-thumb pointer-events-none block ring-0 transition-transform"
  ></span>
</button>

<script>
  import { create } from "@data-slot/switch"

  const controllers: ReturnType<typeof create> = []
  const initialize = () => controllers.push(...create())
  initialize()
  document.addEventListener("astro:page-load", initialize)
  document.addEventListener("astro:before-swap", () => {
    for (const controller of controllers) controller.destroy()
    controllers.length = 0
  })
</script>
