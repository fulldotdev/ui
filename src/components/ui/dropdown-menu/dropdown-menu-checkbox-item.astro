---
import type { HTMLAttributes } from "astro/types"
import CheckIcon from "@lucide/astro/icons/check"

import { cn } from "@/lib/utils"

type Props = HTMLAttributes<"button"> & {
  value: string
  defaultChecked?: boolean
  disabled?: boolean
  variant?: "default" | "destructive"
  inset?: boolean
}

const {
  class: className,
  type = "button",
  value,
  defaultChecked,
  disabled,
  variant,
  inset,
  ...props
} = Astro.props
---

<button
  data-slot="dropdown-menu-checkbox-item"
  data-value={value}
  data-default-checked={defaultChecked}
  data-disabled={disabled}
  data-variant={variant}
  data-inset={inset}
  disabled={disabled ? true : undefined}
  type={type}
  class={cn(
    "cn-fd-dropdown-menu-checkbox-item group/dropdown-menu-checkbox-item relative flex w-full cursor-default items-center outline-hidden select-none data-disabled:pointer-events-none data-disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0",
    className
  )}
  {...props}
>
  <span
    data-slot="dropdown-menu-checkbox-item-indicator"
    class="cn-dropdown-menu-item-indicator pointer-events-none"
  >
    <CheckIcon class="opacity-0 group-data-checked/dropdown-menu-checkbox-item:opacity-100" />
  </span>
  <slot />
</button>
