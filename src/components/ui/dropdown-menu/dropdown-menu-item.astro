---
import type { HTMLAttributes } from "astro/types"

import { cn } from "@/lib/utils"

type Props = HTMLAttributes<"button"> &
  HTMLAttributes<"a"> & {
    as?: "button" | "a"
    disabled?: boolean
    variant?: "default" | "destructive"
    inset?: boolean
  }

const {
  as: Tag = "href" in Astro.props ? "a" : "button",
  class: className,
  type = "button",
  disabled,
  variant,
  inset,
  ...props
} = Astro.props
---

<Tag
  data-slot="dropdown-menu-item"
  data-disabled={disabled}
  data-variant={variant}
  data-inset={inset}
  disabled={Tag === "button" && disabled ? true : undefined}
  type={Tag === "button" ? type : undefined}
  class={cn(
    "cn-fd-dropdown-menu-item group/dropdown-menu-item relative flex w-full cursor-default items-center outline-hidden select-none data-disabled:pointer-events-none data-disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0",
    className
  )}
  {...props}
>
  <slot />
</Tag>

<script>
  // Data Slot owns selection; links also need native keyboard activation.
  document.addEventListener(
    "keydown",
    (event) => {
      if (
        event.defaultPrevented ||
        event.isComposing ||
        !["Enter", " "].includes(event.key)
      )
        return
      const item =
        event.target instanceof Element
          ? event.target.closest('[data-slot="dropdown-menu-item"][href]')
          : null
      if (
        !(item instanceof HTMLAnchorElement) ||
        item.getAttribute("aria-disabled") === "true"
      )
        return
      event.preventDefault()
      event.stopPropagation()
      item.click()
    },
    true
  )
</script>
