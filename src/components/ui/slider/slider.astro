---
import type { HTMLAttributes } from "astro/types"

import { cn } from "@/lib/utils"

type SliderValue = number | [number, number]
type ThumbAlignment = "center" | "edge" | "edge-client-only"

type Props = HTMLAttributes<"div"> & {
  defaultValue?: SliderValue
  min?: number
  max?: number
  step?: number
  largeStep?: number
  orientation?: "horizontal" | "vertical"
  thumbAlignment?: ThumbAlignment
  disabled?: boolean
}

const {
  class: className,
  defaultValue,
  min,
  max,
  step,
  largeStep,
  orientation = "horizontal",
  thumbAlignment = "edge",
  disabled,
  ...props
} = Astro.props

const serializedDefaultValue = Array.isArray(defaultValue)
  ? defaultValue.join(",")
  : defaultValue
const thumbCount = String(serializedDefaultValue ?? "").includes(",") ? 2 : 1
const orientationAttributes = {
  "data-horizontal": orientation === "horizontal" ? "" : undefined,
  "data-vertical": orientation === "vertical" ? "" : undefined,
}
---

<div
  data-slot="slider"
  data-default-value={serializedDefaultValue}
  data-min={min}
  data-max={max}
  data-step={step}
  data-large-step={largeStep}
  data-orientation={orientation}
  {...orientationAttributes}
  data-thumb-alignment={thumbAlignment}
  data-disabled={disabled ? "true" : undefined}
  class={cn("data-horizontal:w-full data-vertical:h-full", className)}
  {...props}
>
  <div
    data-slot="slider-control"
    data-orientation={orientation}
    {...orientationAttributes}
    data-disabled={disabled ? "true" : undefined}
    class="cn-slider relative flex w-full touch-none items-center select-none data-disabled:opacity-50 data-vertical:h-full data-vertical:w-auto data-vertical:flex-col"
  >
    <div
      data-slot="slider-track"
      {...orientationAttributes}
      class="cn-slider-track relative grow overflow-hidden select-none"
    >
      <div
        data-slot="slider-range"
        {...orientationAttributes}
        class="cn-slider-range select-none data-horizontal:h-full data-vertical:w-full"
      >
      </div>
    </div>
    {
      Array.from({ length: thumbCount }).map(() => (
        <div
          data-slot="slider-thumb"
          class="cn-slider-thumb block shrink-0 select-none data-disabled:pointer-events-none data-disabled:opacity-50"
        />
      ))
    }
  </div>
</div>

<script>
  import { create } from "@data-slot/slider"

  const controllers: ReturnType<typeof create> = []
  const initialize = () => controllers.push(...create())
  initialize()
  document.addEventListener("astro:page-load", initialize)
  document.addEventListener("astro:before-swap", () => {
    for (const controller of controllers) controller.destroy()
    controllers.length = 0
  })
</script>
