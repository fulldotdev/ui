---
import type { HTMLAttributes } from "astro/types"

import { cn } from "@/lib/utils"

type Props = HTMLAttributes<"div">

const { class: className, style, ...props } = Astro.props
---

<div
  data-slot="alert-dialog-overlay"
  hidden
  class={cn(
    "cn-alert-dialog-overlay fixed inset-0 isolate z-(--alert-dialog-overlay-stack-index)",
    className
  )}
  style={`z-index: calc(var(--alert-dialog-overlay-stack-index, 0) * 2 + 100);${style ? ` ${style}` : ""}`}
  {...props}
></div>
