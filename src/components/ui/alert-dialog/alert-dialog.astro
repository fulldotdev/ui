---
import type { HTMLAttributes } from "astro/types"

type Props = HTMLAttributes<"div"> & {
  defaultOpen?: boolean
  closeOnClickOutside?: boolean
  closeOnEscape?: boolean
  lockScroll?: boolean
}

const {
  class: className,
  defaultOpen,
  closeOnClickOutside,
  closeOnEscape,
  lockScroll,
  ...props
} = Astro.props
---

<div
  data-slot="alert-dialog"
  data-default-open={defaultOpen}
  data-close-on-click-outside={closeOnClickOutside}
  data-close-on-escape={closeOnEscape}
  data-lock-scroll={lockScroll}
  class={className}
  {...props}
>
  <slot />
</div>

<script>
  import { create } from "@data-slot/alert-dialog"

  const controllers: ReturnType<typeof create> = []
  const initialize = () => controllers.push(...create())
  initialize()
  document.addEventListener("astro:page-load", initialize)
  document.addEventListener("astro:before-swap", () => {
    for (const controller of controllers) controller.destroy()
    controllers.length = 0
  })
</script>
