---
import type { HTMLAttributes } from "astro/types"

import { cn } from "@/lib/utils"

import AlertDialogOverlay from "./alert-dialog-overlay.astro"
import AlertDialogPortal from "./alert-dialog-portal.astro"

type Props = HTMLAttributes<"div"> & {
  size?: "default" | "sm"
}

const { class: className, size = "default", style, ...props } = Astro.props
---

<AlertDialogPortal>
  <AlertDialogOverlay />
  <div
    data-slot="alert-dialog-content"
    data-size={size}
    hidden
    class={cn(
      "cn-alert-dialog-content group/alert-dialog-content fixed top-1/2 left-1/2 z-50 grid w-full -translate-x-1/2 -translate-y-1/2 outline-none",
      className
    )}
    style={`z-index: calc(var(--alert-dialog-content-stack-index, 0) * 2 + 101);${style ? ` ${style}` : ""}`}
    {...props}
  >
    <slot />
  </div>
</AlertDialogPortal>
