---
// Docs only: search the docs pages from the header. The trigger shows its
// label from md up and only the icon below.
import SearchIcon from "@lucide/astro/icons/search"

import {
  Command,
  CommandDialog,
  CommandEmpty,
  CommandGroup,
  CommandInput,
  CommandItem,
  CommandList,
  CommandShortcut,
} from "@/components/ui/command"
import { DialogTrigger } from "@/components/ui/dialog"
import { Kbd } from "@/components/ui/kbd"

type Props = {
  label: string
  empty: string
  items: {
    label: string
    href: string
    title: string
    path: string
    description: string
    group: string
  }[]
}

const { label, empty, items } = Astro.props
const groups = items.reduce<{ label: string; items: typeof items }[]>(
  (all, item) => {
    const group = all.find((entry) => entry.label === item.group)
    if (group) group.items.push(item)
    else all.push({ label: item.group, items: [item] })
    return all
  },
  []
)
/* eslint-disable astro/jsx-a11y/no-autofocus -- Focus moves into the search dialog when it opens. */
---

<CommandDialog
  data-search-dialog
  title={label}
  description={label}
  contentClass="top-3 sm:top-1/3"
>
  <DialogTrigger
    slot="trigger"
    variant="secondary"
    size="sm"
    class="text-foreground/60 size-9 justify-center font-normal shadow-none max-md:bg-transparent max-md:text-foreground md:h-8 md:w-64 md:justify-start [&_svg]:max-md:size-5"
    aria-label={label}
    aria-keyshortcuts="Meta+K Control+K"
  >
    <SearchIcon data-icon="inline-start" />
    <span class="hidden truncate md:inline">{label}</span>
    <Kbd
      class="text-foreground/60 ml-auto hidden md:inline-flex"
      data-search-shortcut
    >
      ⌘K
    </Kbd>
  </DialogTrigger>
  <Command class="[&_[data-slot=command-item][data-selected]]:bg-accent [&_[data-slot=command-item][data-selected]]:text-accent-foreground">
    <CommandInput autofocus placeholder={label} class="max-md:text-base" />
    <CommandList class="max-h-[min(24rem,50svh)]">
      <CommandEmpty>{empty}</CommandEmpty>
      {groups.map((group) => (
        <CommandGroup heading={group.label}>
          {group.items.map((item) => (
            <CommandItem
              href={item.href}
              value={`${item.label} ${item.group}`}
              label={item.label}
              keywords={[item.title]}
            >
              {item.label}
              <CommandShortcut class="hidden sm:inline">
                {item.href}
              </CommandShortcut>
            </CommandItem>
          ))}
        </CommandGroup>
      ))}
    </CommandList>
  </Command>
</CommandDialog>

<script>
  // iOS opens the keyboard only for focus within the tap, and the search
  // input appears after it: hold the keyboard with a temporary input until
  // the dialog moves focus to the search input.
  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return
    if (!matchMedia("(pointer: coarse)").matches) return
    if (
      !event.target.closest("[data-search-dialog] [data-slot=dialog-trigger]")
    )
      return
    const holder = document.createElement("input")
    holder.setAttribute("aria-hidden", "true")
    holder.tabIndex = -1
    holder.style.cssText =
      "position:fixed;top:0;left:0;width:1px;height:1px;opacity:0;font-size:16px"
    document.body.append(holder)
    holder.focus()
    const release = () => holder.remove()
    holder.addEventListener("blur", release, { once: true })
    setTimeout(release, 1000)
  })

  const isMac = /Mac|iPhone|iPad|iPod/i.test(
    navigator.platform || navigator.userAgent
  )
  document
    .querySelectorAll<HTMLElement>("[data-search-shortcut]")
    .forEach((shortcut) => (shortcut.textContent = isMac ? "⌘K" : "Ctrl K"))
  document.addEventListener("keydown", (event) => {
    if (event.key.toLowerCase() !== "k" || event.shiftKey || event.altKey)
      return
    const dialog = document.querySelector("[data-search-dialog]")
    const isShortcut = isMac
      ? event.metaKey && !event.ctrlKey
      : event.ctrlKey && !event.metaKey
    if (!dialog || dialog.hasAttribute("data-open") || !isShortcut) return
    event.preventDefault()
    dialog.dispatchEvent(
      new CustomEvent("dialog:set", { detail: { open: true } })
    )
  })
</script>
