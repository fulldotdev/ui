---
// Docs only: the Astro and React logos in their own colors. The Astro rocket
// takes the text color, so it reads in light and dark mode.
import type { HTMLAttributes } from "astro/types"

import { cn } from "@/lib/utils"

type Props = HTMLAttributes<"svg"> & {
  name: "astro" | "react"
}

const { name, class: className, ...props } = Astro.props
const gradient = `astro-flame-${crypto.randomUUID()}`
---

{name === "astro" ? (
  <svg
    viewBox="0 0 85 107"
    fill="none"
    aria-hidden="true"
    class={cn("shrink-0", className)}
    {...props}
  >
    <path
      fill="currentColor"
      d="M0 69.6s14.3-7 28.7-7l10.8-33.5c.4-1.6 1.6-2.7 3-2.7 1.2 0 2.4 1.1 2.8 2.7l10.9 33.5c17 0 28.6 7 28.6 7L60.5 3.2c-.7-2-2-3.2-3.5-3.2H27.8c-1.6 0-2.7 1.3-3.4 3.2L0 69.6Z"
    />
    <path
      fill={`url(#${gradient})`}
      d="M27.6 91.1c-4.8-4.4-6.3-13.7-4.2-20.4 3.5 4.2 8.3 5.6 13.3 6.3 7.7 1.2 15.3.8 22.5-2.8l2.5-1.4c.7 2 .9 3.9.6 5.9-.6 4.9-3 8.7-6.9 11.5-1.5 1.2-3.2 2.2-4.8 3.3-4.9 3.3-6.2 7.2-4.4 12.9l.2.6a13 13 0 0 1-5.7-5 13.8 13.8 0 0 1-2.2-7.4c0-1.3 0-2.7-.2-4-.5-3.1-2-4.6-4.8-4.7a5.5 5.5 0 0 0-5.7 4.6l-.2.6Z"
    />
    <defs>
      <linearGradient
        id={gradient}
        x1="22.5"
        x2="69.1"
        y1="107"
        y2="84.9"
        gradientUnits="userSpaceOnUse"
      >
        <stop stop-color="#D83333" />
        <stop offset="1" stop-color="#F041FF" />
      </linearGradient>
    </defs>
  </svg>
) : (
  <svg
    viewBox="-11.5 -10.23 23 20.46"
    aria-hidden="true"
    class={cn("shrink-0 text-[#087EA4] dark:text-[#58C4DC]", className)}
    {...props}
  >
    <circle r="2.05" fill="currentColor" />
    <g fill="none" stroke="currentColor" stroke-width="1">
      <ellipse rx="11" ry="4.2" />
      <ellipse rx="11" ry="4.2" transform="rotate(60)" />
      <ellipse rx="11" ry="4.2" transform="rotate(120)" />
    </g>
  </svg>
)}
