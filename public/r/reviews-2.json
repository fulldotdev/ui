{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "reviews-2",
  "title": "Reviews 2",
  "description": "Testimonial and review sections for social proof, trust, and product validation.",
  "dependencies": [
    "@lucide/astro"
  ],
  "registryDependencies": [
    "@fulldev/avatar",
    "@fulldev/rating",
    "@fulldev/section",
    "@fulldev/separator"
  ],
  "files": [
    {
      "path": "src/components/blocks/reviews-2.astro",
      "content": "---\nimport type { ImageMetadata } from \"astro\"\nimport type { HTMLAttributes } from \"astro/types\"\nimport QuoteIcon from \"@lucide/astro/icons/quote\"\n\nimport { cn } from \"@/lib/utils\"\nimport { Avatar, AvatarFallback, AvatarImage } from \"@/components/ui/avatar\"\nimport { Rating } from \"@/components/ui/rating\"\nimport { Section, SectionContainer } from \"@/components/ui/section\"\nimport { Separator } from \"@/components/ui/separator\"\n\ntype Props = HTMLAttributes<\"section\"> & {\n  featured: {\n    quote: string\n    image?: ImageMetadata\n    initials: string\n    name: string\n    role: string\n  }\n  reviews: {\n    rating: number\n    ratingLabel: string\n    quote: string\n    image?: ImageMetadata\n    initials: string\n    name: string\n    role: string\n  }[]\n}\n\nconst { class: className, featured, reviews, ...props } = Astro.props\n---\n\n<Section class={cn(\"\", className)} {...props}>\n  <SectionContainer class=\"grid gap-10 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)] lg:items-start\">\n    <figure class=\"flex flex-col gap-6 rounded-xl border p-8\">\n      <QuoteIcon class=\"text-primary size-8\" />\n      <blockquote class=\"text-foreground text-2xl leading-snug font-semibold text-balance sm:text-3xl\">\n        <p>{featured.quote}</p>\n      </blockquote>\n      <figcaption class=\"flex items-center gap-3 pt-2\">\n        <Avatar size=\"lg\" aria-hidden=\"true\">\n          <AvatarImage src={featured.image} />\n          <AvatarFallback>{featured.initials}</AvatarFallback>\n        </Avatar>\n        <div>\n          <p class=\"text-foreground text-sm font-medium\">{featured.name}</p>\n          <p class=\"text-muted-foreground text-xs\">{featured.role}</p>\n        </div>\n      </figcaption>\n    </figure>\n    <div class=\"grid gap-6\">\n      {reviews.map((item) => (\n        <div class=\"flex flex-col\">\n          <Separator />\n          <figure class=\"flex flex-col gap-3 pt-6\">\n            <Rating value={item.rating} aria-label={item.ratingLabel} />\n            <blockquote class=\"text-muted-foreground text-sm leading-relaxed\">\n              <p>{item.quote}</p>\n            </blockquote>\n            <figcaption class=\"flex items-center gap-3 pt-1\">\n              <Avatar aria-hidden=\"true\">\n                <AvatarImage src={item.image} />\n                <AvatarFallback>{item.initials}</AvatarFallback>\n              </Avatar>\n              <div>\n                <p class=\"text-foreground text-sm font-medium\">{item.name}</p>\n                <p class=\"text-muted-foreground text-xs\">{item.role}</p>\n              </div>\n            </figcaption>\n          </figure>\n        </div>\n      ))}\n    </div>\n  </SectionContainer>\n</Section>\n",
      "type": "registry:block"
    }
  ],
  "docs": "https://ui.full.dev/astro/blocks/reviews/",
  "categories": [
    "reviews"
  ],
  "type": "registry:block"
}