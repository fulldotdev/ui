{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "reviews-4",
  "title": "Reviews 4",
  "description": "Testimonial and review sections for social proof, trust, and product validation.",
  "registryDependencies": [
    "@fulldev/avatar",
    "@fulldev/card",
    "@fulldev/marquee",
    "@fulldev/rating",
    "@fulldev/section"
  ],
  "files": [
    {
      "path": "src/components/blocks/reviews-4.tsx",
      "content": "import * as React from \"react\"\n\nimport { Avatar, AvatarFallback, AvatarImage } from \"@/components/ui/avatar\"\nimport { Card, CardContent } from \"@/components/ui/card\"\nimport {\n  Marquee,\n  MarqueeContent,\n  MarqueeItem,\n  MarqueeToggle,\n} from \"@/components/ui/marquee\"\nimport { Rating } from \"@/components/ui/rating\"\nimport {\n  Section,\n  SectionContainer,\n  SectionDescription,\n  SectionTitle,\n} from \"@/components/ui/section\"\n\nfunction Reviews4({\n  title,\n  description,\n  labels,\n  reviews,\n  ...props\n}: React.ComponentProps<\"section\"> & {\n  title: string\n  description: string\n  labels: {\n    play: string\n    pause: string\n  }\n  reviews: {\n    rating: number\n    ratingLabel: string\n    quote: string\n    image?: string\n    initials: string\n    name: string\n    role: string\n  }[]\n}) {\n  const half = Math.ceil(reviews.length / 2)\n  const rows = [reviews.slice(0, half), reviews.slice(half)]\n\n  return (\n    <Section {...props}>\n      <SectionContainer className=\"flex flex-col items-center gap-4 text-center\">\n        <SectionTitle>{title}</SectionTitle>\n        <SectionDescription className=\"max-w-2xl\">\n          {description}\n        </SectionDescription>\n      </SectionContainer>\n      <Marquee className=\"flex flex-col gap-6\">\n        <SectionContainer className=\"flex justify-end\">\n          <MarqueeToggle playLabel={labels.play} pauseLabel={labels.pause} />\n        </SectionContainer>\n        {rows\n          .filter((row) => row.length > 0)\n          .map((row, index) => (\n            <MarqueeContent\n              key={index}\n              reverse={index % 2 === 1}\n              className=\"py-1\"\n            >\n              {row.map((item) => (\n                <MarqueeItem key={item.name + item.quote} className=\"flex\">\n                  <Card className=\"w-[22rem]\">\n                    <CardContent className=\"flex flex-1 flex-col\">\n                      <figure className=\"flex flex-1 flex-col gap-3\">\n                        <Rating\n                          value={item.rating}\n                          aria-label={item.ratingLabel}\n                        />\n                        <blockquote className=\"text-sm leading-relaxed text-muted-foreground\">\n                          <p>{item.quote}</p>\n                        </blockquote>\n                        <figcaption className=\"mt-auto flex items-center gap-3 pt-1\">\n                          <Avatar aria-hidden=\"true\">\n                            <AvatarImage src={item.image} alt=\"\" />\n                            <AvatarFallback>{item.initials}</AvatarFallback>\n                          </Avatar>\n                          <div>\n                            <p className=\"text-sm font-medium text-foreground\">\n                              {item.name}\n                            </p>\n                            <p className=\"text-xs text-muted-foreground\">\n                              {item.role}\n                            </p>\n                          </div>\n                        </figcaption>\n                      </figure>\n                    </CardContent>\n                  </Card>\n                </MarqueeItem>\n              ))}\n            </MarqueeContent>\n          ))}\n      </Marquee>\n    </Section>\n  )\n}\n\nexport { Reviews4 }\n",
      "type": "registry:block"
    }
  ],
  "docs": "https://ui.full.dev/react/#/blocks/reviews-4",
  "categories": [
    "reviews"
  ],
  "type": "registry:block"
}