{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "reviews-2",
  "title": "Reviews 2",
  "description": "Testimonial and review sections for social proof, trust, and product validation.",
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [
    "@fulldev/avatar",
    "@fulldev/rating",
    "@fulldev/section",
    "@fulldev/separator"
  ],
  "files": [
    {
      "path": "src/components/blocks/reviews-2.tsx",
      "content": "import * as React from \"react\"\nimport { QuoteIcon } from \"lucide-react\"\n\nimport { Avatar, AvatarFallback, AvatarImage } from \"@/components/ui/avatar\"\nimport { Rating } from \"@/components/ui/rating\"\nimport { Section, SectionContainer } from \"@/components/ui/section\"\nimport { Separator } from \"@/components/ui/separator\"\n\nfunction Reviews2({\n  featured,\n  reviews,\n  ...props\n}: React.ComponentProps<\"section\"> & {\n  featured: {\n    quote: string\n    image?: string\n    initials: string\n    name: string\n    role: string\n  }\n  reviews: {\n    rating: number\n    ratingLabel: string\n    quote: string\n    image?: string\n    initials: string\n    name: string\n    role: string\n  }[]\n}) {\n  return (\n    <Section {...props}>\n      <SectionContainer className=\"grid gap-10 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)] lg:items-start\">\n        <figure className=\"flex flex-col gap-6 rounded-xl border p-8\">\n          <QuoteIcon className=\"size-8 text-primary\" />\n          <blockquote className=\"text-2xl leading-snug font-semibold text-balance text-foreground sm:text-3xl\">\n            <p>{featured.quote}</p>\n          </blockquote>\n          <figcaption className=\"flex items-center gap-3 pt-2\">\n            <Avatar size=\"lg\" aria-hidden=\"true\">\n              <AvatarImage src={featured.image} alt=\"\" />\n              <AvatarFallback>{featured.initials}</AvatarFallback>\n            </Avatar>\n            <div>\n              <p className=\"text-sm font-medium text-foreground\">\n                {featured.name}\n              </p>\n              <p className=\"text-xs text-muted-foreground\">{featured.role}</p>\n            </div>\n          </figcaption>\n        </figure>\n        <div className=\"grid gap-6\">\n          {reviews.map((item) => (\n            <div key={item.name + item.quote} className=\"flex flex-col\">\n              <Separator />\n              <figure className=\"flex flex-col gap-3 pt-6\">\n                <Rating value={item.rating} aria-label={item.ratingLabel} />\n                <blockquote className=\"text-sm leading-relaxed text-muted-foreground\">\n                  <p>{item.quote}</p>\n                </blockquote>\n                <figcaption className=\"flex items-center gap-3 pt-1\">\n                  <Avatar aria-hidden=\"true\">\n                    <AvatarImage src={item.image} alt=\"\" />\n                    <AvatarFallback>{item.initials}</AvatarFallback>\n                  </Avatar>\n                  <div>\n                    <p className=\"text-sm font-medium text-foreground\">\n                      {item.name}\n                    </p>\n                    <p className=\"text-xs text-muted-foreground\">{item.role}</p>\n                  </div>\n                </figcaption>\n              </figure>\n            </div>\n          ))}\n        </div>\n      </SectionContainer>\n    </Section>\n  )\n}\n\nexport { Reviews2 }\n",
      "type": "registry:block"
    }
  ],
  "docs": "https://ui.full.dev/react/#/blocks/reviews-2",
  "categories": [
    "reviews"
  ],
  "type": "registry:block"
}