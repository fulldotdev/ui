{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "reviews-5",
  "title": "Reviews 5",
  "description": "Testimonial and review sections for social proof, trust, and product validation.",
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [
    "@fulldev/avatar",
    "@fulldev/marquee",
    "@fulldev/rating",
    "@fulldev/section"
  ],
  "files": [
    {
      "path": "src/components/blocks/reviews-5.tsx",
      "content": "import * as React from \"react\"\nimport { QuoteIcon } from \"lucide-react\"\n\nimport { Avatar, AvatarFallback, AvatarImage } from \"@/components/ui/avatar\"\nimport {\n  Marquee,\n  MarqueeContent,\n  MarqueeItem,\n  MarqueeToggle,\n} from \"@/components/ui/marquee\"\nimport { Rating } from \"@/components/ui/rating\"\nimport {\n  Section,\n  SectionContainer,\n  SectionDescription,\n  SectionTitle,\n} from \"@/components/ui/section\"\n\nfunction Reviews5({\n  title,\n  description,\n  labels,\n  reviews,\n  ...props\n}: React.ComponentProps<\"section\"> & {\n  title: string\n  description: string\n  labels: {\n    play: string\n    pause: string\n  }\n  reviews: {\n    quote: string\n    image?: string\n    initials: string\n    name: string\n    role: string\n    rating: number\n    ratingLabel: string\n  }[]\n}) {\n  const third = Math.ceil(reviews.length / 3)\n  const rows = [\n    reviews.slice(0, third),\n    reviews.slice(third, third * 2),\n    reviews.slice(third * 2),\n  ]\n\n  return (\n    <Section {...props}>\n      <SectionContainer className=\"flex flex-col items-center gap-4 text-center\">\n        <SectionTitle>{title}</SectionTitle>\n        <SectionDescription className=\"max-w-2xl\">\n          {description}\n        </SectionDescription>\n      </SectionContainer>\n      <Marquee className=\"flex flex-col gap-5\">\n        <SectionContainer className=\"flex justify-end\">\n          <MarqueeToggle playLabel={labels.play} pauseLabel={labels.pause} />\n        </SectionContainer>\n        {rows\n          .filter((row) => row.length > 0)\n          .map((row, index) => (\n            <MarqueeContent\n              key={index}\n              reverse={index % 2 === 1}\n              className=\"py-1\"\n            >\n              {row.map((item) => (\n                <MarqueeItem key={item.name + item.quote} className=\"flex\">\n                  <figure className=\"flex w-[26rem] flex-col gap-4 rounded-2xl bg-muted/50 p-6\">\n                    <figcaption className=\"flex items-center justify-between gap-3\">\n                      <div className=\"flex items-center gap-3\">\n                        <Avatar size=\"lg\" aria-hidden=\"true\">\n                          <AvatarImage src={item.image} alt=\"\" />\n                          <AvatarFallback>{item.initials}</AvatarFallback>\n                        </Avatar>\n                        <div>\n                          <p className=\"text-sm font-semibold text-foreground\">\n                            {item.name}\n                          </p>\n                          <p className=\"text-xs text-muted-foreground\">\n                            {item.role}\n                          </p>\n                        </div>\n                      </div>\n                      <Rating\n                        value={item.rating}\n                        aria-label={item.ratingLabel}\n                      />\n                    </figcaption>\n                    <div className=\"flex gap-2.5\">\n                      <QuoteIcon className=\"mt-0.5 size-5 shrink-0 text-primary/30\" />\n                      <blockquote className=\"text-sm leading-relaxed text-foreground/80\">\n                        <p>{item.quote}</p>\n                      </blockquote>\n                    </div>\n                  </figure>\n                </MarqueeItem>\n              ))}\n            </MarqueeContent>\n          ))}\n      </Marquee>\n    </Section>\n  )\n}\n\nexport { Reviews5 }\n",
      "type": "registry:block"
    }
  ],
  "docs": "https://ui.full.dev/react/#/blocks/reviews-5",
  "categories": [
    "reviews"
  ],
  "type": "registry:block"
}