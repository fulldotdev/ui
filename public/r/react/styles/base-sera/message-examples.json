{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "message-examples",
  "title": "Message examples",
  "description": "The examples from the shadcn/ui Message docs.",
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [
    "@fulldev/attachment",
