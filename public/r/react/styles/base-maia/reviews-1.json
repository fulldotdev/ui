{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "reviews-1",
  "title": "Reviews 1",
  "description": "Testimonial and review sections for social proof, trust, and product validation.",
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [
    "@fulldev/avatar",
    "@fulldev/card",
    "@fulldev/rating",
    "@fulldev/section"
  ],
  "files": [
    {
      "path": "src/components/blocks/reviews-1.tsx",
      "content": "import * as React from \"react\"\nimport { QuoteIcon } from \"lucide-react\"\n\nimport { Avatar, AvatarFallback, AvatarImage } from \"@/components/ui/avatar\"\nimport { Card, CardContent } from \"@/components/ui/card\"\nimport { Rating } from \"@/components/ui/rating\"\nimport {\n  Section,\n  SectionContainer,\n  SectionDescription,\n  SectionTitle,\n} from \"@/components/ui/section\"\n\nfunction Reviews1({\n  title,\n  description,\n  reviews,\n  ...props\n}: React.ComponentProps<\"section\"> & {\n  title: string\n  description: string\n  reviews: {\n    rating: number\n    ratingLabel: string\n    quote: string\n    image?: string\n    initials: string\n    name: string\n    role: string\n  }[]\n}) {\n  return (\n    <Section {...props}>\n      <SectionContainer className=\"flex flex-col items-center gap-4 text-center\">\n        <SectionTitle>{title}</SectionTitle>\n        <SectionDescription className=\"max-w-2xl\">\n          {description}\n        </SectionDescription>\n      </SectionContainer>\n      <SectionContainer>\n        <div className=\"grid gap-6 md:grid-cols-3\">\n          {reviews.map((item) => (\n            <Card key={item.name + item.quote}>\n              <CardContent className=\"flex flex-1 flex-col\">\n                <figure className=\"flex flex-1 flex-col gap-4\">\n                  <div className=\"flex items-center justify-between\">\n                    <Rating value={item.rating} aria-label={item.ratingLabel} />\n                    <QuoteIcon className=\"size-6 text-muted-foreground/20\" />\n                  </div>\n                  <blockquote className=\"text-sm leading-relaxed text-muted-foreground\">\n                    <p>{item.quote}</p>\n                  </blockquote>\n                  <figcaption className=\"mt-auto flex items-center gap-3 pt-2\">\n                    <Avatar size=\"lg\" aria-hidden=\"true\">\n                      <AvatarImage src={item.image} alt=\"\" />\n                      <AvatarFallback>{item.initials}</AvatarFallback>\n                    </Avatar>\n                    <div>\n                      <p className=\"text-sm font-medium text-foreground\">\n                        {item.name}\n                      </p>\n                      <p className=\"text-xs text-muted-foreground\">\n                        {item.role}\n                      </p>\n                    </div>\n                  </figcaption>\n                </figure>\n              </CardContent>\n            </Card>\n          ))}\n        </div>\n      </SectionContainer>\n    </Section>\n  )\n}\n\nexport { Reviews1 }\n",
      "type": "registry:block"
    }
  ],
  "docs": "https://ui.full.dev/react/#/blocks/reviews-1",
  "categories": [
    "reviews"
  ],
  "type": "registry:block"
}