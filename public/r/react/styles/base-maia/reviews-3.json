{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "reviews-3",
  "title": "Reviews 3",
  "description": "Testimonial and review sections for social proof, trust, and product validation.",
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [
    "@fulldev/avatar",
    "@fulldev/carousel",
    "@fulldev/rating",
    "@fulldev/section"
  ],
  "files": [
    {
      "path": "src/components/blocks/reviews-3.tsx",
      "content": "import * as React from \"react\"\nimport { QuoteIcon } from \"lucide-react\"\n\nimport { Avatar, AvatarFallback, AvatarImage } from \"@/components/ui/avatar\"\nimport {\n  Carousel,\n  CarouselContent,\n  CarouselItem,\n  CarouselNext,\n  CarouselPrevious,\n} from \"@/components/ui/carousel\"\nimport { Rating } from \"@/components/ui/rating\"\nimport {\n  Section,\n  SectionContainer,\n  SectionDescription,\n  SectionTitle,\n} from \"@/components/ui/section\"\n\nfunction Reviews3({\n  title,\n  description,\n  labels,\n  reviews,\n  ...props\n}: React.ComponentProps<\"section\"> & {\n  title: string\n  description: string\n  labels: {\n    previous: string\n    next: string\n    carousel: string\n    slide: string\n  }\n  reviews: {\n    rating: number\n    ratingLabel: string\n    quote: string\n    image?: string\n    initials: string\n    name: string\n    role: string\n  }[]\n}) {\n  return (\n    <Section {...props}>\n      <SectionContainer className=\"flex flex-col items-center gap-4 text-center\">\n        <SectionTitle>{title}</SectionTitle>\n        <SectionDescription className=\"max-w-2xl\">\n          {description}\n        </SectionDescription>\n      </SectionContainer>\n      <SectionContainer>\n        <Carousel\n          aria-label={title}\n          aria-roledescription={labels.carousel}\n          opts={{ loop: true }}\n          className=\"mx-auto w-[calc(100%-6rem)] max-w-3xl\"\n        >\n          <CarouselContent>\n            {reviews.map((item) => (\n              <CarouselItem\n                key={item.name + item.quote}\n                aria-roledescription={labels.slide}\n              >\n                <figure className=\"flex flex-col items-center gap-6 px-4 py-8 text-center\">\n                  <QuoteIcon className=\"size-10 text-primary\" />\n                  <Rating value={item.rating} aria-label={item.ratingLabel} />\n                  <blockquote className=\"text-xl leading-relaxed font-medium text-balance text-foreground sm:text-2xl\">\n                    <p>{item.quote}</p>\n                  </blockquote>\n                  <figcaption className=\"flex items-center gap-3 pt-2\">\n                    <Avatar size=\"lg\" aria-hidden=\"true\">\n                      <AvatarImage src={item.image} alt=\"\" />\n                      <AvatarFallback>{item.initials}</AvatarFallback>\n                    </Avatar>\n                    <div className=\"text-left\">\n                      <p className=\"text-sm font-medium text-foreground\">\n                        {item.name}\n                      </p>\n                      <p className=\"text-xs text-muted-foreground\">\n                        {item.role}\n                      </p>\n                    </div>\n                  </figcaption>\n                </figure>\n              </CarouselItem>\n            ))}\n          </CarouselContent>\n          <CarouselPrevious aria-label={labels.previous} />\n          <CarouselNext aria-label={labels.next} />\n        </Carousel>\n      </SectionContainer>\n    </Section>\n  )\n}\n\nexport { Reviews3 }\n",
      "type": "registry:block"
    }
  ],
  "docs": "https://ui.full.dev/react/#/blocks/reviews-3",
  "categories": [
    "reviews"
  ],
  "type": "registry:block"
}