{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "header-1",
  "title": "Header 1",
  "description": "Header layouts for brand, navigation, and high-level page actions.",
  "dependencies": [
    "@lucide/astro"
  ],
  "registryDependencies": [
    "@fulldev/button",
    "@fulldev/header",
    "@fulldev/icon",
    "@fulldev/logo",
    "@fulldev/navigation-menu",
    "@fulldev/sheet"
  ],
  "files": [
    {
      "path": "src/components/blocks/header-1.astro",
      "content": "---\nimport type { HTMLAttributes } from \"astro/types\"\nimport XIcon from \"@lucide/astro/icons/x\"\n\nimport { cn } from \"@/lib/utils\"\nimport { Button } from \"@/components/ui/button\"\nimport { Header, HeaderContainer, HeaderGroup } from \"@/components/ui/header\"\nimport { Icon } from \"@/components/ui/icon\"\nimport { Logo, LogoImage, LogoText } from \"@/components/ui/logo\"\nimport {\n  NavigationMenu,\n  NavigationMenuItem,\n  NavigationMenuLink,\n  NavigationMenuList,\n} from \"@/components/ui/navigation-menu\"\nimport {\n  Sheet,\n  SheetClose,\n  SheetContent,\n  SheetDescription,\n  SheetHeader,\n  SheetTitle,\n  SheetTrigger,\n} from \"@/components/ui/sheet\"\n\ntype Props = HTMLAttributes<\"header\"> & {\n  logo: {\n    label: string\n    href: string\n    src?: any\n    srcLight?: any\n    srcDark?: any\n    alt?: string\n  }\n  navigation: {\n    label: string\n    href: string\n    active?: boolean\n  }[]\n  buttons: {\n    label: string\n    href: string\n    icon?: string\n  }[]\n  navigationLabel: string\n  menu: {\n    label: string\n    title: string\n    description: string\n    closeLabel: string\n  }\n}\n\nconst {\n  class: className,\n  logo,\n  navigation,\n  buttons,\n  navigationLabel,\n  menu,\n  ...props\n} = Astro.props\n---\n\n<Header class={cn(\"\", className)} {...props}>\n  <HeaderContainer class=\"items-center justify-between gap-4\">\n    <HeaderGroup>\n      <Logo href={logo.href}>\n        <LogoImage\n          src={logo.src}\n          srcLight={logo.srcLight}\n          srcDark={logo.srcDark}\n          alt={logo.alt}\n        />\n        {logo.label && <LogoText>{logo.label}</LogoText>}\n      </Logo>\n    </HeaderGroup>\n    <NavigationMenu\n      aria-label={navigationLabel}\n      class=\"hidden flex-none justify-start lg:flex\"\n    >\n      <NavigationMenuList class=\"justify-start\">\n        {navigation.map((item, index) => (\n          <NavigationMenuItem value={`nav-${index}`}>\n            <NavigationMenuLink href={item.href} active={item.active}>\n              {item.label}\n            </NavigationMenuLink>\n          </NavigationMenuItem>\n        ))}\n      </NavigationMenuList>\n    </NavigationMenu>\n    <HeaderGroup class=\"ml-auto hidden flex-1 justify-end lg:flex\">\n      <slot />\n      {buttons.map(({ label, href, icon }, index) => (\n        <Button\n          as=\"a\"\n          href={href}\n          size={icon && !label ? \"icon-sm\" : \"sm\"}\n          variant={index === buttons.length - 1 ? \"default\" : \"ghost\"}\n          aria-label={label}\n          target={href.startsWith(\"http\") ? \"_blank\" : undefined}\n          rel={href.startsWith(\"http\") ? \"noreferrer\" : undefined}\n        >\n          {icon && <Icon name={icon} />}\n          {label}\n        </Button>\n      ))}\n    </HeaderGroup>\n    <Sheet class=\"lg:hidden\">\n      <SheetTrigger\n        variant=\"ghost\"\n        size=\"icon-sm\"\n        class=\"ml-auto\"\n        aria-label={menu.label}\n      >\n        <Icon name=\"menu\" />\n      </SheetTrigger>\n      <SheetContent side=\"right\" showCloseButton={false} class=\"p-0\">\n        <SheetHeader class=\"sr-only\">\n          <SheetTitle>{menu.title}</SheetTitle>\n          <SheetDescription>{menu.description}</SheetDescription>\n        </SheetHeader>\n        <div class=\"flex h-full flex-col gap-6 px-4 py-12\">\n          <nav aria-label={menu.title} class=\"flex flex-col gap-1\">\n            {navigation.map((item) => (\n              <SheetClose\n                as=\"a\"\n                href={item.href}\n                aria-current={item.active ? \"page\" : undefined}\n                variant=\"ghost\"\n                class=\"justify-start\"\n              >\n                {item.label}\n              </SheetClose>\n            ))}\n          </nav>\n          <div class=\"mt-auto flex flex-col gap-2\">\n            <slot name=\"mobile\" />\n          </div>\n        </div>\n        <SheetClose\n          type=\"button\"\n          variant=\"ghost\"\n          size=\"icon-sm\"\n          class=\"absolute top-4 right-4\"\n        >\n          <XIcon />\n          <span class=\"sr-only\">{menu.closeLabel}</span>\n        </SheetClose>\n      </SheetContent>\n    </Sheet>\n  </HeaderContainer>\n</Header>\n",
      "type": "registry:block"
    }
  ],
  "docs": "https://ui.full.dev/blocks/header/",
  "categories": [
    "header"
  ],
  "type": "registry:block"
}