{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "kbd-examples",
  "title": "Kbd examples",
  "description": "The examples from the shadcn/ui Kbd docs.",
  "dependencies": [
    "@lucide/astro"
  ],
  "registryDependencies": [
    "@fulldev/button",
    "@fulldev/button-group",
    "@fulldev/input-group",
    "@fulldev/kbd",
    "@fulldev/tooltip"
  ],
  "files": [
    {
      "path": "src/components/examples/kbd/kbd-button.astro",
      "content": "---\nimport { Button } from \"@/components/ui/button\"\nimport { Kbd } from \"@/components/ui/kbd\"\n---\n\n<Button variant=\"outline\">\n  Accept\n  <Kbd data-icon=\"inline-end\" class=\"translate-x-0.5\">\n    ⏎\n  </Kbd>\n</Button>\n",
      "type": "registry:component"
    },
    {
      "path": "src/components/examples/kbd/kbd-demo.astro",
      "content": "---\nimport { Kbd, KbdGroup } from \"@/components/ui/kbd\"\n---\n\n<div class=\"flex flex-col items-center gap-4\">\n  <KbdGroup>\n    <Kbd>⌘</Kbd>\n    <Kbd>⇧</Kbd>\n    <Kbd>⌥</Kbd>\n    <Kbd>⌃</Kbd>\n  </KbdGroup>\n  <KbdGroup>\n    <Kbd>Ctrl</Kbd>\n    <span>+</span>\n    <Kbd>B</Kbd>\n  </KbdGroup>\n</div>\n",
      "type": "registry:component"
    },
    {
      "path": "src/components/examples/kbd/kbd-group.astro",
      "content": "---\nimport { Kbd, KbdGroup } from \"@/components/ui/kbd\"\n---\n\n<div class=\"flex flex-col items-center gap-4\">\n  <div class=\"text-sm text-muted-foreground\">\n    Use\n    <KbdGroup>\n      <Kbd>Ctrl + B</Kbd>\n      <Kbd>Ctrl + K</Kbd>\n    </KbdGroup>\n    to open the command palette\n  </div>\n</div>\n",
      "type": "registry:component"
    },
    {
      "path": "src/components/examples/kbd/kbd-input-group.astro",
      "content": "---\nimport SearchIcon from \"@lucide/astro/icons/search\"\n\nimport {\n  InputGroup,\n  InputGroupAddon,\n  InputGroupInput,\n} from \"@/components/ui/input-group\"\nimport { Kbd } from \"@/components/ui/kbd\"\n---\n\n<div class=\"flex w-full max-w-xs flex-col gap-6\">\n  <InputGroup>\n    <InputGroupInput placeholder=\"Search...\" />\n    <InputGroupAddon>\n      <SearchIcon />\n    </InputGroupAddon>\n    <InputGroupAddon align=\"inline-end\">\n      <Kbd>⌘</Kbd>\n      <Kbd>K</Kbd>\n    </InputGroupAddon>\n  </InputGroup>\n</div>\n",
      "type": "registry:component"
    },
    {
      "path": "src/components/examples/kbd/kbd-rtl.astro",
      "content": "---\nimport { Kbd, KbdGroup } from \"@/components/ui/kbd\"\n\nconst translations = {\n  en: {\n    dir: \"ltr\",\n    values: {},\n  },\n  ar: {\n    dir: \"rtl\",\n    values: {},\n  },\n  he: {\n    dir: \"rtl\",\n    values: {},\n  },\n} as const\n\nconst { dir } = translations.ar\n---\n\n<div class=\"flex flex-col items-center gap-4\" dir={dir}>\n  <KbdGroup>\n    <Kbd>⌘</Kbd>\n    <Kbd>⇧</Kbd>\n    <Kbd>⌥</Kbd>\n    <Kbd>⌃</Kbd>\n  </KbdGroup>\n  <KbdGroup>\n    <Kbd>Ctrl</Kbd>\n    <span>+</span>\n    <Kbd>B</Kbd>\n  </KbdGroup>\n</div>\n",
      "type": "registry:component"
    },
    {
      "path": "src/components/examples/kbd/kbd-tooltip.astro",
      "content": "---\nimport { buttonVariants } from \"@/components/ui/button\"\nimport { ButtonGroup } from \"@/components/ui/button-group\"\nimport { Kbd, KbdGroup } from \"@/components/ui/kbd\"\nimport {\n  Tooltip,\n  TooltipContent,\n  TooltipTrigger,\n} from \"@/components/ui/tooltip\"\n---\n\n<div class=\"flex flex-wrap gap-4\">\n  <ButtonGroup>\n    <Tooltip>\n      <TooltipTrigger\n        class={buttonVariants({ variant: \"outline\", class: \"rounded-r-none\" })}\n      >\n        Save\n      </TooltipTrigger>\n      <TooltipContent>\n        Save Changes <Kbd>S</Kbd>\n      </TooltipContent>\n    </Tooltip>\n    <Tooltip>\n      <TooltipTrigger\n        class={buttonVariants({\n          variant: \"outline\",\n          class: \"rounded-l-none border-l-0\",\n        })}\n      >\n        Print\n      </TooltipTrigger>\n      <TooltipContent>\n        Print Document\n        <KbdGroup>\n          <Kbd>Ctrl</Kbd>\n          <Kbd>P</Kbd>\n        </KbdGroup>\n      </TooltipContent>\n    </Tooltip>\n  </ButtonGroup>\n</div>\n",
      "type": "registry:component"
    }
  ],
  "docs": "https://ui.full.dev/astro/components/kbd/",
  "type": "registry:example"
}