{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "resizable-examples",
  "title": "Resizable examples",
  "description": "The examples from the shadcn/ui Resizable docs.",
  "registryDependencies": [
    "@fulldev/resizable"
  ],
  "files": [
    {
      "path": "src/components/examples/resizable/resizable-demo.astro",
      "content": "---\nimport {\n  ResizableHandle,\n  ResizablePanel,\n  ResizablePanelGroup,\n} from \"@/components/ui/resizable\"\n---\n\n<ResizablePanelGroup direction=\"horizontal\" class=\"max-w-sm rounded-lg border\">\n  <ResizablePanel defaultSize={50}>\n    <div class=\"flex h-[200px] items-center justify-center p-6\">\n      <span class=\"font-semibold\">One</span>\n    </div>\n  </ResizablePanel>\n  <ResizableHandle withHandle />\n  <ResizablePanel defaultSize={50}>\n    <ResizablePanelGroup direction=\"vertical\">\n      <ResizablePanel defaultSize={25}>\n        <div class=\"flex h-full items-center justify-center p-6\">\n          <span class=\"font-semibold\">Two</span>\n        </div>\n      </ResizablePanel>\n      <ResizableHandle withHandle />\n      <ResizablePanel defaultSize={75}>\n        <div class=\"flex h-full items-center justify-center p-6\">\n          <span class=\"font-semibold\">Three</span>\n        </div>\n      </ResizablePanel>\n    </ResizablePanelGroup>\n  </ResizablePanel>\n</ResizablePanelGroup>\n",
      "type": "registry:component"
    },
    {
      "path": "src/components/examples/resizable/resizable-handle.astro",
      "content": "---\nimport {\n  ResizableHandle,\n  ResizablePanel,\n  ResizablePanelGroup,\n} from \"@/components/ui/resizable\"\n---\n\n<ResizablePanelGroup\n  direction=\"horizontal\"\n  class=\"min-h-[200px] max-w-sm rounded-lg border\"\n>\n  <ResizablePanel defaultSize={25}>\n    <div class=\"flex h-full items-center justify-center p-6\">\n      <span class=\"font-semibold\">Sidebar</span>\n    </div>\n  </ResizablePanel>\n  <ResizableHandle withHandle />\n  <ResizablePanel defaultSize={75}>\n    <div class=\"flex h-full items-center justify-center p-6\">\n      <span class=\"font-semibold\">Content</span>\n    </div>\n  </ResizablePanel>\n</ResizablePanelGroup>\n",
      "type": "registry:component"
    },
    {
      "path": "src/components/examples/resizable/resizable-rtl.astro",
      "content": "---\nimport {\n  ResizableHandle,\n  ResizablePanel,\n  ResizablePanelGroup,\n} from \"@/components/ui/resizable\"\n\nconst translations = {\n  en: {\n    dir: \"ltr\",\n    values: {\n      one: \"One\",\n      two: \"Two\",\n      three: \"Three\",\n    },\n  },\n  ar: {\n    dir: \"rtl\",\n    values: {\n      one: \"واحد\",\n      two: \"اثنان\",\n      three: \"ثلاثة\",\n    },\n  },\n  he: {\n    dir: \"rtl\",\n    values: {\n      one: \"אחד\",\n      two: \"שניים\",\n      three: \"שלושה\",\n    },\n  },\n}\n\nconst { dir, values: t } = translations.ar\n---\n\n<ResizablePanelGroup\n  direction=\"horizontal\"\n  class=\"max-w-sm rounded-lg border\"\n  dir={dir}\n>\n  <ResizablePanel defaultSize={50}>\n    <div class=\"flex h-[200px] items-center justify-center p-6\">\n      <span class=\"font-semibold\">{t.one}</span>\n    </div>\n  </ResizablePanel>\n  <ResizableHandle withHandle />\n  <ResizablePanel defaultSize={50}>\n    <ResizablePanelGroup direction=\"vertical\" dir={dir}>\n      <ResizablePanel defaultSize={25}>\n        <div class=\"flex h-full items-center justify-center p-6\">\n          <span class=\"font-semibold\">{t.two}</span>\n        </div>\n      </ResizablePanel>\n      <ResizableHandle withHandle />\n      <ResizablePanel defaultSize={75}>\n        <div class=\"flex h-full items-center justify-center p-6\">\n          <span class=\"font-semibold\">{t.three}</span>\n        </div>\n      </ResizablePanel>\n    </ResizablePanelGroup>\n  </ResizablePanel>\n</ResizablePanelGroup>\n",
      "type": "registry:component"
    },
    {
      "path": "src/components/examples/resizable/resizable-vertical.astro",
      "content": "---\nimport {\n  ResizableHandle,\n  ResizablePanel,\n  ResizablePanelGroup,\n} from \"@/components/ui/resizable\"\n---\n\n<ResizablePanelGroup\n  direction=\"vertical\"\n  class=\"min-h-[200px] max-w-sm rounded-lg border\"\n>\n  <ResizablePanel defaultSize={25}>\n    <div class=\"flex h-full items-center justify-center p-6\">\n      <span class=\"font-semibold\">Header</span>\n    </div>\n  </ResizablePanel>\n  <ResizableHandle />\n  <ResizablePanel defaultSize={75}>\n    <div class=\"flex h-full items-center justify-center p-6\">\n      <span class=\"font-semibold\">Content</span>\n    </div>\n  </ResizablePanel>\n</ResizablePanelGroup>\n",
      "type": "registry:component"
    }
  ],
  "docs": "https://ui.full.dev/astro/components/resizable/",
  "type": "registry:example"
}