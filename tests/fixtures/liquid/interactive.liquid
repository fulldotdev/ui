<section data-slot="section" aria-label="Interactive primitives">
  <div data-slot="section-container">
    {% render 'ui-button', label: '<Escaped label>', variant: 'outline' %}
    <article data-slot="card">
      <header data-slot="card-header">
        <h2 data-slot="card-title">Native Liquid card</h2>
        <p data-slot="card-description">Parts stay native HTML.</p>
        <span data-slot="card-action" data-testid="card-action">Action</span>
      </header>
      <div data-slot="card-content">Content</div>
      <footer data-slot="card-footer">Footer</footer>
    </article>
    <div data-slot="dialog">
      <button type="button" data-slot="dialog-trigger" data-button>
        Open dialog
      </button>
      <div data-slot="dialog-overlay" hidden></div>
      <div data-slot="dialog-content" hidden>
        <header data-slot="dialog-header">
          <h2 data-slot="dialog-title">Example dialog</h2>
          <p data-slot="dialog-description">Keyboard and focus test.</p>
        </header>
        <button type="button" data-slot="dialog-close" data-button>
          Close
        </button>
      </div>
    </div>
    <div data-slot="combobox">
      <label data-slot="field-label" for="sample-combobox">Country</label>
      <input id="sample-combobox" data-slot="combobox-input" autocomplete="off">
      <div data-slot="combobox-positioner">
        <div data-slot="combobox-content" hidden>
          <div data-slot="combobox-list">
            <div data-slot="combobox-item" data-value="nl">Netherlands</div>
            <div data-slot="combobox-item" data-value="be">Belgium</div>
            <div data-slot="combobox-empty" hidden>No countries</div>
          </div>
        </div>
      </div>
    </div>
    <div data-slot="command">
      <input data-slot="command-input" aria-label="Find a page">
      <div data-slot="command-list">
        <div data-slot="command-group">
          <a href="/one" data-slot="command-item">First page</a>
          <a href="/two" data-slot="command-item">Second page</a>
        </div>
        <div data-slot="command-empty">No pages</div>
      </div>
    </div>
    <div data-slot="carousel" aria-label="Gallery">
      <div data-slot="carousel-content">
        <div data-slot="carousel-item">First slide</div>
        <div data-slot="carousel-item">Second slide</div>
        <div data-slot="carousel-item">Third slide</div>
      </div>
      <button type="button" data-slot="carousel-previous" data-button hidden>
        Previous
      </button>
      <button type="button" data-slot="carousel-next" data-button hidden>
        Next
      </button>
    </div>
    <nav data-slot="navigation-menu" aria-label="Example navigation">
      <ul data-slot="navigation-menu-list">
        <li data-slot="navigation-menu-item" data-value="products">
          <button type="button" data-slot="navigation-menu-trigger">
            Products
          </button>
          <div data-slot="navigation-menu-content">
            <a href="/products" data-slot="navigation-menu-link"
              >All products</a
            >
          </div>
        </li>
      </ul>
      <div data-slot="navigation-menu-viewport"></div>
    </nav>
  </div>
</section>

<section data-motion aria-label="Motion example">
  <div data-slot="marquee">
    <div class="marquee-track" data-slot="marquee-content">
      <span data-slot="marquee-item">Example logo</span>
    </div>
  </div>
  <button
    type="button"
    data-slot="marquee-toggle"
    data-motion-pause
    aria-pressed="false"
    hidden
  >
    Pause
  </button>
</section>
