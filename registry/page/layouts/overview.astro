---
import {
  getOverviewEntries,
  getPageHref,
  getPages,
  type Page,
} from "@/lib/pages"

import Base from "./base.astro"

type Props = { page: Page }
const { page } = Astro.props
const entries = getOverviewEntries(await getPages(), page)
---

<Base page={page}>
  <h1 class="text-4xl font-bold">{page.data.title}</h1>
  <p class="text-muted-foreground text-lg">{page.data.description}</p>
  <article class="space-y-4"><slot /></article>
  <ul class="grid gap-4 sm:grid-cols-2">
    {
      entries.map((entry) => (
        <li class="rounded-lg border p-6">
          <a class="font-medium underline" href={getPageHref(entry)}>
            {entry.data.title}
          </a>
          <p class="text-muted-foreground mt-2">{entry.data.description}</p>
        </li>
      ))
    }
  </ul>
</Base>
